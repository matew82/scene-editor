  function choose(index){var preserveKeys=keyMode&&parameterEditor&&selected===index,previousTime=keyEditor?keyEditor.selectedTime:null,currentSession=session,result=operation(function(){return currentSession.select(index,mode);},'Load selected object properties');if(session!==currentSession)throw Error('Stale property result');if(editor!==result.editor){resetViews();}parameterEditor=result.editor;keyEditor=null;keyMode=false;editor=parameterEditor;if(preserveKeys){keyEditor=SceneEditorKeyEditor.create(parameterEditor);if(previousTime!==null&&keyEditor.times.indexOf(previousTime)>=0)keyEditor.selectTime(previousTime);editor=keyEditor;keyMode=true;}selected=index;syncMaterials();filter.text='';filterText='';selectVisual(index);var viewStats=null;try{viewStats=measureView(activeView,'object-selection');}catch(renderError){note.text='Property data loaded; view construction cancelled or failed. Choose TreeView/Controls to retry. '+String(renderError.message||renderError);error(renderError);}report('object-properties',{file:session.path,timings:result.timings,ui:viewStats,diagnostics:result.diagnostics});if(result.diagnostics.length)env.MessageBox.warning(result.diagnostics.length+' property-source diagnostics. '+result.diagnostics.slice(0,3).join('\n')+'\nSee Diagnostics/object-properties report.','Property source','OK');}
  function doSave(){if(!editor)return true;if(tree.isRenaming())throw Error('Commit Value with Enter or cancel editing before save');syncChecks();var reviewedEditor=editor,plan=operation(function(){return editor.build();},'Build exact patch');if(!plan.diff.length)return true;if(editor!==reviewedEditor)throw Error('Property selection changed during review');var receipt=operation(function(){return editor.save();},'Save verified patch'),refreshStart=new Date().getTime(),savedEditor=editor;if(typeof SceneEditorSavedSettings!=='undefined'&&typeof SceneEditorSavedSettings.invalidate==='function')SceneEditorSavedSettings.invalidate(session.path);usageRevision++;usageOwner=null;usageModel=null;if(editor.discardPending)editor.discardPending();editor.pending={};editor.pendingClamped={};editor._builtPlan=null;report('editor-dsa-save',receipt);if(typeof options.onSaved==='function')try{options.onSaved(receipt,receipt.file);}catch(historyError){env.MessageBox.warning('Scene saved and verified; post-save metadata update failed: '+String(historyError.message||historyError),'Scene Editor','OK');}try{var index=session.saved(savedEditor);editor=null;populateObjects();choose(index);report('save-refresh',{file:session.path,refreshMs:new Date().getTime()-refreshStart,status:'refreshed'});env.MessageBox.information('Saved and reread verified.','Scene Editor','OK');}catch(refreshError){editor=null;selected=-1;resetViews();controls();note.text='DUF saved and reread verified; property refresh failed or was cancelled. Reload file. '+String(refreshError.message||refreshError);env.MessageBox.warning(note.text,'Saved; refresh incomplete','OK');}return true;}
  function allowLeave(){if(editor)syncChecks();if(!pending())return true;var answer=typeof options.confirmPending==='function'?options.confirmPending():env.MessageBox.question('Current object has pending edits. Save, discard explicitly, or cancel switching?','Pending edits','Save','Discard','Cancel');if(answer===0)return doSave();if(answer===1){usageRevision++;usageOwner=null;usageModel=null;if(editor.discardPending)editor.discardPending();editor.pending={};editor.pendingClamped={};editor._builtPlan=null;refreshValues();return true;}return false;}
  function load(path,forceInspection){var next=operation(function(){return options.sessionFactory?options.sessionFactory(path,io,guard):new SceneEditorObjects.Session(path,io,guard,options.inspectionCacheFolder||folder+'/Diagnostics',forceInspection);},'Inspect DUF objects only');session=next;editor=null;parameterEditor=null;keyEditor=null;keyMode=false;selected=-1;lastPath=path;filter.text='';filterText='';populateObjects();updateHeader();controls();report('open-inspection',{file:path,timings:session.timings,cacheDiagnostic:session.cacheDiagnostic||null});}
  function selectHandoff(){if(typeof options.objectId!=='string'||!options.objectId)throw Error('Edit requires the exact selected DUF object id');var handoffIndex=-1,handoffCount=0;for(var handoffAt=0;handoffAt<session.rows.length;handoffAt++)if(session.rows[handoffAt].id===options.objectId){handoffIndex=handoffAt;handoffCount++;}if(handoffCount>1)throw Error('Selected object id is ambiguous in this DUF: '+options.objectId);if(handoffIndex<0)throw Error('Selected object is no longer present in this DUF: '+options.objectId);choose(handoffIndex);}
  function selectKeyTime(source,time){if(busy||mutating||closingApproved||!keyMode||editor!==source||source!==keyEditor)return;try{if(tree.isRenaming())throw Error('Commit Value with Enter or cancel editing before switching frames');syncChecks();operation(function(){source.selectTime(time);renderView(activeView);},'Show existing saved keys');}catch(e){controls();error(e);}}
  function switchEditing(keys){if(busy||mutating||closingApproved||!parameterEditor||keyMode===keys)return;var previous=editor,oldMode=keyMode;try{if(tree.isRenaming())throw Error('Commit Value with Enter or cancel editing before switching modes');if(!allowLeave()){controls();return;}previous=editor;oldMode=keyMode;if(keys&&!keyEditor)keyEditor=operation(function(){return SceneEditorKeyEditor.create(parameterEditor);},'Index existing animation keys');editor=keys?keyEditor:parameterEditor;keyMode=keys;measureView(activeView,'editing-mode');}catch(e){editor=previous;keyMode=oldMode;showView(activeView);controls();error(e);}}
  if(keyButton){connect(parameterButton,'clicked()',function(){switchEditing(false);});connect(keyButton,'clicked()',function(){switchEditing(true);});}
  function switchMode(next){if(busy||mutating){controls();return;}try{if(mode===next){controls();return;}if(!allowLeave()){controls();return;}var old=mode;mode=next;controls();if(session&&selected>=0)try{choose(selected);}catch(e){mode=old;controls();throw e;}}catch(ex){controls();error(ex);}}
  connect(open,'clicked()',function(){if(busy)return;try{if(!allowLeave())return;var path=env.FileDialog.doFileDialog(true,'Open saved DUF without loading scene',lastPath||folder+'/Diagnostics/','DAZ Scene Files (*.duf)');if(path)load(String(path));}catch(e){error(e);}});
  function switchView(view){if(busy||mutating){controls();return;}var prior=activeView,transitionStart=new Date().getTime(),flushStart=transitionStart,flushMs=0,stats=null;try{if(editor&&activeView==='TreeView'&&tree.isRenaming())throw Error('Commit Value with Enter or cancel editing before switching views');syncChecks();flushMs=new Date().getTime()-flushStart;stats=measureView(view,'view-toggle');report('view-transition',{file:session?session.path:null,objectId:editor?editor.camera.id:null,from:prior,to:view,flushMs:flushMs,operationAndReportMs:new Date().getTime()-transitionStart-flushMs,totalMs:new Date().getTime()-transitionStart,ui:stats,status:'completed'});}catch(e){activeView=prior;showView(prior);controls();report('view-transition',{from:prior,to:view,flushMs:flushMs,totalMs:new Date().getTime()-transitionStart,status:'cancelled-or-failed',error:String(e.message||e)});error(e);}}
  function optionToggle(which){if(busy||mutating)return;var began=new Date().getTime(),oldClamp=clampedOn,oldHidden=showHidden,oldUsed=usedOn,flushMs=0,applyMs=0,layoutMs=0,stats=null;try{operation(function(){var at=new Date().getTime();syncChecks();flushMs=new Date().getTime()-at;if(which==='clamped')clampedOn=!clampedOn;else if(which==='used')usedOn=!usedOn;else showHidden=!showHidden;at=new Date().getTime();stats=applyVisibility(which,activeView);applyMs=new Date().getTime()-at;at=new Date().getTime();env.processEvents();layoutMs=new Date().getTime()-at;},'Update '+which+' option');report('property-options',{option:which,view:activeView,clampedOn:clampedOn,showHidden:showHidden,currentlyUsed:usedOn,flushMs:flushMs,applyMs:applyMs,layoutEventMs:layoutMs,totalMs:new Date().getTime()-began,stats:stats,constructedWidgets:0,pendingRetained:editor?Object.keys(editor.pending).length:0,status:'completed'});}catch(e){clampedOn=oldClamp;showHidden=oldHidden;usedOn=oldUsed;treeVisibilityStamp=null;var rollbackStart=new Date().getTime(),rollbackError=null;try{applyVisibility('all',activeView);}catch(recovery){rollbackError=String(recovery.message||recovery);}controls();report('property-options',{option:which,view:activeView,clampedOn:clampedOn,showHidden:showHidden,currentlyUsed:usedOn,totalMs:new Date().getTime()-began,rollbackMs:new Date().getTime()-rollbackStart,rollbackError:rollbackError,status:'cancelled-or-failed',error:String(e.message||e),stats:e.optionStats||stats});error(e);}}connect(usedButton,'clicked()',function(){optionToggle('used');});connect(clampButton,'clicked()',function(){optionToggle('clamped');});connect(hiddenButton,'clicked()',function(){optionToggle('hidden');});connect(treeButton,'clicked()',function(){switchView('TreeView');});connect(controlsButton,'clicked()',function(){switchView('Controls');});
  connect(daz,'clicked()',function(){switchMode('DAZ');});connect(ownCache,'clicked()',function(){switchMode('Own');});
  function objectChosen(item){if(busy||mutating||!session)return;var index=item?Number(item.id):-1;if(index===selected||index<0||index>=objectRows.length)return;var prior=selected;try{if(!allowLeave()){selectVisual(prior);return;}choose(index);}catch(e){selectVisual(prior);error(e);}}if(objects){connect(objects,'currentChanged(DzListViewItem*)',objectChosen);connect(objects,'clicked(DzListViewItem*)',objectChosen);}
  if(options.animationEditing)connect(tree,'clicked(DzListViewItem*,const QPoint&,int)',function(item,pos,column){if(busy||mutating||closingApproved||activeView!=='TreeView'||treeOwner!==editor||!keyMode||column<2||column>4)return;var r=rowFor(item);if(!r||!r.p.hasKeyAtFrame||!editor.canInterpolate(r.p.id))return;try{syncChecks();editor.setInterpolation(r.p.id,['TCB','Linear','CONST'][column-2]);refreshValues();}catch(e){error(e);}});
  connect(tree,'itemRenamed(DzListViewItem*,int,const QString&)',function(item,column,text){if(closingApproved||busy||mutating||activeView!=='TreeView'||treeOwner!==editor||column!==1)return;var r=rowFor(item);if(!r||editor.isKeyEditor&&!r.p.hasKeyAtFrame)return;try{apply(r,JSON.parse(String(text)));}catch(e){error(e);}refreshValues();});
  connect(tree,'doubleClicked(DzListViewItem*,const QPoint&,int)',function(item,pos,col){if(closingApproved||busy||mutating||activeView!=='TreeView'||treeOwner!==editor||col!==1)return;var r=rowFor(item);if(!r)return;if(r.p.issue||r.p.meta.locked||editor.isKeyEditor&&!r.p.hasKeyAtFrame||SceneEditorCore.nodeReferenceDisplay(editor,r.p)!==null)return;if(r.p.type==='file'||r.p.type==='enum'||r.p.type==='color'||r.p.type==='float_color'){var owner=editor,p=r.p,answer;try{syncChecks();answer=SceneEditorControls.chooseValue(env,p,own(owner.pending,p.id)?owner.pending[p.id]:p.value,owner);if(answer){if(editor!==owner||busy)throw Error('Property selection changed');apply(r,answer.value);refreshValues(p.id);}}catch(e){if(e.code==='COLOR_API'&&editor===owner&&treeOwner===owner&&treeBy[p.id]===r&&!busy&&!closingApproved){item.setRenameEnabled(1,true);item.startRename(1);}else error(e);}}else item.startRename(1);});connect(tree,'clicked(DzListViewItem*)',function(){if(!closingApproved&&!busy&&!mutating&&activeView==='TreeView'&&treeOwner===editor)try{syncChecks();}catch(e){error(e);refreshValues();}});
  connect(applyFilter,'clicked()',function(){if(busy||!editor)return;try{syncChecks();filterText=String(filter.text).toLowerCase();measureView(activeView,'filter');}catch(e){error(e);}});
  if(materialCombo)connect(materialCombo,'activated(int)',function(index){if(busy||mutating||!editor)return;index=Number(index);if(Math.floor(index)!==index||index<0||index>=materialChoices.length)return;var previous=materialKey,oldIndex=-1;for(var mi=0;mi<materialChoices.length;mi++)if(materialChoices[mi].key===previous)oldIndex=mi;try{syncChecks();materialKey=materialChoices[index].key;measureView('Controls','material-selection');}catch(selectionError){materialKey=previous;var priorMutation=mutating;mutating=true;try{materialCombo.currentItem=oldIndex;}finally{mutating=priorMutation;}showView('Controls');controls();error(selectionError);}});
  connect(save,'clicked()',function(){if(!busy)try{doSave();}catch(e){error(e);}});connect(close,'clicked()',function(){if(busy)return;try{if(allowLeave()){closingApproved=true;dlg.close();}}catch(e){error(e);}});
  hiddenButton.toolTip='Show hidden properties';if(options.settingsManaged){daz.hide();ownCache.hide();treeButton.hide();controlsButton.hide();open.hide();}controls();try{if(options.path){load(options.path);selectHandoff();}while(true){dlg.exec();if(closingApproved||!pending())break;try{if(allowLeave())break;}catch(exitError){error(exitError);}}}finally{closingApproved=true;if(keyStrip)keyStrip.close();if(controlsManager)controlsManager.clear();for(var li=links.length-1;li>=0;li--)try{env.disconnect(links[li].o,links[li].s,links[li].f);}catch(ignoreDisconnect){}}
 }

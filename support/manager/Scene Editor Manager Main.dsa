     pixmap.fromImage(sourceImage.smoothScale(w,h));image.pixmap=pixmap;image.setGeometry(Math.floor((width-w)/2),Math.floor((height-h)/2),w,h);lastSize=size;
    }finally{fitting=false;}
   }

  function clearBackupView(){clearPreview();disconnect(backupLinks);backupRows=null;backupSource='';backupArea.setWidget(new env.DzWidget(backupArea));}function renderBackups(result,workGuard){var local=[],content=plainPanel(backupArea,false),published=false,source=selected;try{for(var i=0;i<result.records.length;i++){workGuard('Display backups '+i+' / '+result.records.length);var record=result.records[i],box=plainPanel(content.widget,false),heading=plainPanel(box.widget,true),thumbPath=record.thumbnailPath||'';
var divider=label(box.widget,'<hr/>');

  function backupDate(epoch){var d=new Date(Number(epoch));if(!isFinite(d.getTime()))return '';function two(n){return n<10?'0'+n:String(n);}return two(d.getDate())+'.'+two(d.getMonth()+1)+'.'+d.getFullYear()+' '+two(d.getHours())+'.'+two(d.getMinutes())+'.'+two(d.getSeconds());}

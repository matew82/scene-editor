   function fitImage(){
    if(!viewerLive||closing||fitting)return;var width=Math.floor(Number(canvas.width)),height=Math.floor(Number(canvas.height));
    if(!(width>0&&height>0&&isFinite(width)&&isFinite(height)))return;var size=width+'x'+height;if(lastSize===size)return;
    fitting=true;try{

var SaveGuardWearableTarget=(function(){
    function fail(s){throw Error("Wearable target: "+s);}
    function uriText(value){if(typeof value==='string')return value;if(value&&typeof value.toString==='function')return String(value.toString());return String(value);}
    function same(env,a,b){return a===null&&b===null||!!a&&!!b&&env.pointersAreEqual(a,b)===true;}
    function create(env,contract){
        if(!contract||!contract.assetUri||!contract.assetId)fail("Saved target rig contract required");
        var scene=env.Scene,target=null,baseline=null,attached=null,collision=[],existing={};var initial=SaveGuardSceneInventory.nodes(scene);for(var ii=0;ii<initial.length;ii++)existing["$"+Number(initial[ii].elementID)]=true;
        function figure(n){return !!n&&typeof n.inherits==="function"&&n.inherits("DzFigure");}
        function resolve(n){var seen={},steps=0;while(n){var key="$"+Number(n.elementID);if(seen[key])fail("Cyclic target ownership");seen[key]=true;if(figure(n)){var follow=n.getFollowTarget();if(follow){n=follow;continue;}return n;}if(typeof n.getSkeleton==="function"){var sk=n.getSkeleton();if(sk&&!same(env,sk,n)){n=sk;continue;}}if(typeof n.getNodeParent!=="function")break;n=n.getNodeParent();}fail("Select the same figure generation as the saved Fit To target, one of its bones, or a fitted wearable.");}
        function identity(n){if(!figure(n)||typeof n.isInScene!=="function"||n.isInScene()!==true)fail("Selected target is no longer in the scene");var uri;try{uri=decodeURIComponent(uriText(n.assetUri));}catch(e){fail("Target definition URI is unavailable");}if(String(n.assetId)!==contract.assetId||(env.platform==='macOS'?uri!==String(contract.assetUri):uri.toLowerCase()!==String(contract.assetUri).toLowerCase()))fail("Selected figure does not match the saved Fit To rig ("+contract.assetId+"). Cross-generation conversion is not supported.");return uri;}
        function list(n,countMethod,itemMethod){if(typeof n[countMethod]!=="function"||typeof n[itemMethod]!=="function")fail("Required relationship API unavailable: "+countMethod);var count=Number(n[countMethod]()),out=[],i;if(!isFinite(count)||count<0||Math.floor(count)!==count)fail("Invalid target relationship count");for(i=0;i<count;i++){var item=n[itemMethod](i);if(!item)fail("Missing target relationship");out.push(item);}if(Number(n[countMethod]())!==count)fail("Target relationships changed during read");return out;}
        function state(){return {uri:identity(target),parent:target.getNodeParent(),follow:target.getFollowTarget(),children:list(target,"getNumNodeChildren","getNodeChild"),followers:list(target,"getNumFollowSkeletons","getFollowSkeleton")};}
        function equalList(actual,expected,extra){if(actual.length!==expected.length+(extra?1:0))return false;var i,j,used={};for(i=0;i<expected.length+(extra?1:0);i++){var wanted=i<expected.length?expected[i]:extra,found=-1;for(j=0;j<actual.length;j++)if(!used["$"+j]&&same(env,actual[j],wanted)){found=j;break;}if(found<0)return false;used["$"+found]=true;}return true;}
        function unchanged(extra){var now=state();return now.uri===baseline.uri&&same(env,now.parent,baseline.parent)&&same(env,now.follow,baseline.follow)&&equalList(now.children,baseline.children,extra)&&equalList(now.followers,baseline.followers,extra);}
        function collisionCorrect(){for(var ci=0;ci<collision.length;ci++)if(!same(env,collision[ci].getValue(),target))return false;return collision.length===contract.collisionCount;}
        target=resolve(scene.getPrimarySelection());identity(target);if(typeof target.addNodeChild!=="function")fail("Parenting API unavailable");baseline=state();
        return {target:target,findImported:function(definitionId){var rows=SaveGuardSceneInventory.nodes(scene),found=null;for(var i=0;i<rows.length;i++)if(!existing["$"+Number(rows[i].elementID)]&&String(rows[i].assetId)===definitionId&&figure(rows[i])){if(found)fail("Ambiguous imported wearable binding");found=rows[i];}if(!found)fail("Imported wearable missing");return found;},describe:function(){return {elementId:Number(target.elementID),label:String(target.getLabel()),assetId:String(target.assetId),assetUri:baseline.uri};},preflight:function(){if(!same(env,resolve(scene.getPrimarySelection()),target)||!unchanged(null))fail("Target or its relationships changed; select it and retry");return true;},attach:function(root){if(attached)fail("Repeated fitting attempt");if(!unchanged(null))fail("Existing target changed during import");if(!figure(root)||root.getNodeParent()||root.getFollowTarget()||typeof root.setFollowTarget!=="function")fail("Imported wearable is not an unattached figure");var object=root.getObject();if(!object||typeof object.getNumModifiers!=="function"||typeof object.getModifier!=="function")fail("Imported collision modifier API unavailable");var count=Number(object.getNumModifiers());if(!isFinite(count)||count<0||Math.floor(count)!==count)fail("Invalid imported modifier count");for(var mi=0;mi<count;mi++){var modifier=object.getModifier(mi);if(!modifier)fail("Missing imported modifier");var property=modifier&&typeof modifier.findProperty==="function"?modifier.findProperty("Collision Item"):null;if(property){collision.push(property);}}if(Number(object.getNumModifiers())!==count)fail("Imported modifiers changed during read");if(collision.length!==contract.collisionCount)fail("Imported collision link count differs from saved contract");for(var ci=0;ci<collision.length;ci++)if(typeof collision[ci].inherits!=="function"||!collision[ci].inherits("DzNodeProperty")||typeof collision[ci].getNumKeys!=="function"||collision[ci].getNumKeys()!==0||typeof collision[ci].setValue!=="function"||typeof collision[ci].getValue!=="function")fail("Saved smoothing collision link cannot be remapped safely");var code=target.addNodeChild(root,false);if(Number(code)!==0||!same(env,root.getNodeParent(),target))fail("Could not parent imported wearable");root.setFollowTarget(target);for(var ci=0;ci<collision.length;ci++)collision[ci].setValue(target);attached=root;if(!same(env,root.getFollowTarget(),target)||!collisionCorrect()||!unchanged(root))fail("Fitting did not establish the expected target relationships");return true;},verify:function(){return !!attached&&collisionCorrect()&&same(env,attached.getNodeParent(),target)&&same(env,attached.getFollowTarget(),target)&&unchanged(attached);},verifyRollback:function(){return unchanged(null);}};
    }
    return {create:create,nativeVerified:false};
}());
// Preserve the selected native light dependency closure; specs are diagnostics, not native setters.
var SaveGuardLightPlan=(function(){
 function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}
 function array(v){return Object.prototype.toString.call(v)==='[object Array]';}
 function need(v,m){if(!v)throw Error('Light source: '+m);}
 function check(options){if(options&&options.isCancelled&&options.isCancelled()){var error=Error('Light preparation cancelled');error.code='CANCELLED';throw error;}}
 function value(c){return own(c,'current_value')?c.current_value:c.value;}
 function absolute(file,base){if(file.charAt(0)==='/')return file;need(base&&base.charAt(0)==='/','Relative definition has no verified base');var parts=(base.substring(0,base.lastIndexOf('/')+1)+file).split('/'),out=[];for(var i=0;i<parts.length;i++){if(parts[i]==='..'){need(out.length,'Definition escapes content root');out.pop();}else if(parts[i]&&parts[i]!=='.')out.push(parts[i]);}return '/'+out.join('/');}
 function validate(record,options){var stack=[];
  function enter(v){if(!v||typeof v!=='object')return;for(var i=0;i<stack.length;i++)need(stack[i].v!==v,'Cyclic authored record');var keys=[],k;for(k in v)if(own(v,k))keys.push(k);stack.push({v:v,keys:keys,next:0});}
  enter(record);while(stack.length){check(options);var f=stack[stack.length-1];if(f.next===f.keys.length){stack.pop();continue;}var k=f.keys[f.next++],v=f.v[k];need(k!=='__proto__','Unsafe authored member');if(typeof v==='number')need(isFinite(v),'Nonfinite authored number');if(k==='keys'||k==='formulas')need(array(v),'Invalid '+k+' array');if(v&&typeof v==='object')enter(v);}
 }
 function channel(c){need(c&&typeof c.id==='string'&&c.id,'Missing channel identity');var t=c.type;
  function typed(v){if(t==='float'||t==='int'||t==='enum'||t==='numeric_node'){need(typeof v==='number'&&isFinite(v),'Nonfinite numeric property: '+c.id);if(t==='enum'||t==='int')need(Math.floor(v)===v&&(t!=='enum'||v>=0),'Invalid enum/integer: '+c.id);}else if(t==='bool')need(typeof v==='boolean','Invalid boolean: '+c.id);else if(t==='color'){need(array(v)&&v.length===3,'Invalid color: '+c.id);for(var i=0;i<v.length;i++)need(typeof v[i]==='number'&&isFinite(v[i]),'Invalid color component: '+c.id);}else if(t==='file'||t==='string')need(typeof v==='string','Invalid text property: '+c.id);}
  if(own(c,'value'))typed(c.value);if(own(c,'current_value'))typed(c.current_value);if(own(c,'keys')){need(array(c.keys),'Invalid embedded keys array');for(var ki=0;ki<c.keys.length;ki++){var row=c.keys[ki];need(array(row)&&row.length>=2&&typeof row[0]==='number'&&isFinite(row[0]),'Malformed typed key');typed(row[1]);}}
 }

 function transforms(rec){var fields=['translation','rotation','scale','center_point','end_point','orientation'];for(var i=0;i<fields.length;i++){var key=fields[i];if(!own(rec,key))continue;need(array(rec[key]),'Invalid transform axis array');var seen={};for(var j=0;j<rec[key].length;j++){var c=rec[key][j];need(c&&/^(x|y|z)$/.test(c.id)&&!seen['$'+c.id],'Invalid or duplicate transform axis');seen['$'+c.id]=true;var typed={id:c.id,type:'float'};if(own(c,'value'))typed.value=c.value;if(own(c,'current_value'))typed.current_value=c.current_value;if(own(c,'keys'))typed.keys=c.keys;channel(typed);}}
  if(own(rec,'general_scale')){var g=rec.general_scale;if(g&&typeof g==='object'){var v={id:'general_scale',type:'float'};if(own(g,'value'))v.value=g.value;if(own(g,'current_value'))v.current_value=g.current_value;if(own(g,'keys'))v.keys=g.keys;channel(v);}else need(typeof g==='number'&&isFinite(g),'Invalid general scale');}if(own(rec,'inherits_scale'))need(typeof rec.inherits_scale==='boolean','Invalid inherits_scale flag');
 }
 function records(doc,node,options){options=options||{};var out=[],scope=doc,base=options.definitionBase||'',scopeId=options.definitionIdentity||'scene',seen={},uri=node.url||node.source;
  while(uri){check(options);var ref=SaveGuardSelective.parseURI(uri);need((ref.kind==='local'||ref.kind==='external')&&!ref.query&&!ref.nodePath,'Invalid definition reference');if(ref.kind==='external'){var file=absolute(ref.file,base),loaded=options.resolveAssetDocument&&options.resolveAssetDocument(file);check(options);need(loaded&&loaded.verified===true&&loaded.document,'Missing or unverified external light definition: '+file);scope=loaded.document;base=loaded.uri||file;scopeId=loaded.path||file;}
   var identity=JSON.stringify([scopeId,ref.fragment]);need(!seen['$'+identity],'Cyclic light definition inheritance');seen['$'+identity]=true;var definitions=scope.node_library||[],found=null;for(var i=0;i<definitions.length;i++)if(definitions[i].id===ref.fragment){need(!found,'Duplicate light definition');found=definitions[i];}need(found,'Missing light definition: '+ref.fragment);out.unshift(found);uri=found.source||found.url||'';
  }out.push(node);return out;
 }
 function describe(doc,id,options){var nodes=doc.scene&&doc.scene.nodes||[],node=null,i,j,k;for(i=0;i<nodes.length;i++)if(nodes[i].id===id){need(!node,'Duplicate selected light');node=nodes[i];}need(node,'Selected light missing');var chain=records(doc,node,options),channels={},order=[],type='',kinds={},group=false;
  for(i=0;i<chain.length;i++){var rec=chain[i];validate(rec,options);transforms(rec);if(rec.type)type=rec.type;for(j=0;j<3;j++){var kind=['point','spot','directional'][j];if(own(rec,kind)){need(rec[kind]&&typeof rec[kind]==='object'&&!array(rec[kind]),'Invalid light type block');kinds[kind]=true;}}
   var extras=rec.extra||[];need(array(extras),'Invalid node extension array');var seen={};for(j=0;j<extras.length;j++){var ex=extras[j];need(ex&&typeof ex==='object','Invalid node extension');if(ex.type==='studio/node/group_node')group=true;if(ex.type!=='studio_node_channels')continue;need(!own(ex,'channels')||array(ex.channels),'Invalid channel array');for(k=0;k<(ex.channels||[]).length;k++){var c=ex.channels[k].channel;need(c&&typeof c.id==='string'&&c.id&&!seen['$'+c.id],'Missing or duplicate channel identity');seen['$'+c.id]=true;var old=channels['$'+c.id],merged={},field;if(old)for(field in old)if(own(old,field))merged[field]=old[field];if(own(c,'value')&&!own(c,'current_value'))delete merged.current_value;for(field in c)if(own(c,field))merged[field]=c[field];if(!old)order.push(c.id);channel(merged);channels['$'+c.id]=merged;}}
  }
  var kind='',count=0;for(k in kinds)if(own(kinds,k)){kind=k;count++;}if(type==='light')need(count===1,'Exactly one Point, Spot or Distant light type required');var list=[];for(i=0;i<order.length;i++)list.push(channels['$'+order[i]]);return {node:node,records:chain,type:type||'node',kind:kind,channels:list,channelById:channels,group:group,photometric:channels['$Photometric Mode']?value(channels['$Photometric Mode']):null};
 }
 function verifyAssetClosure(document,options){
  var queue=[],visited={},assets={},at=0;
  function check(){if(options.isCancelled&&options.isCancelled()){var error=Error('Light dependency preparation cancelled');error.code='CANCELLED';throw error;}}
  function asset(file){if(own(assets,'$'+file))return assets['$'+file];var loaded=options.resolveAssetDocument&&options.resolveAssetDocument(file);check();need(loaded&&loaded.verified===true&&loaded.document,'Missing or unverified light dependency: '+file);assets['$'+file]=loaded;return loaded;}
  function reference(raw,from,field,scope){check();need(field!=='unknown-reference-field','Unclassified dependency ownership: '+from);var ref=SaveGuardSelective.parseURI(raw);need(ref.kind!=='unsafe','Unsafe dependency reference');if(ref.kind==='empty')return;if(!scope&&ref.kind==='local')return;
   var file=ref.file?(scope?absolute(ref.file,scope.uri):ref.file):scope.uri,loaded=null;if(ref.file){if(scope){need(typeof options.resolveExternal==='function','External light dependency must be verified');var absoluteURI=file+(ref.fragment?'#'+encodeURIComponent(ref.fragment)+ref.query:'');var verified=options.resolveExternal(file,{file:file,uris:[absoluteURI],referencedBy:[from]});check();need(verified&&verified.exists===true,'Missing external light dependency: '+file);}if(!ref.fragment)return;loaded=asset(file);}else loaded=scope;
   need(loaded&&ref.fragment,'Missing exact light dependency fragment');need(!scope||!ref.nodePath,'External asset reference requires scene ownership');var key=JSON.stringify([loaded.path||file,ref.fragment]);if(visited['$'+key])return;visited['$'+key]=true;var doc=loaded.document,found=null,group='',k,i;for(k in doc)if(own(doc,k)&&/_library$/.test(k)&&array(doc[k]))for(i=0;i<doc[k].length;i++)if(doc[k][i].id===ref.fragment){need(!found,'Ambiguous external dependency fragment: '+ref.fragment);found=doc[k][i];group=k;}need(found,'Missing external dependency fragment: '+ref.fragment);validate(found,options);if(group==='node_library')records(doc,{url:'#'+ref.fragment},{isCancelled:options.isCancelled,resolveAssetDocument:options.resolveAssetDocument,definitionBase:loaded.uri||file,definitionIdentity:loaded.path||file});queue.push({record:found,scope:{document:doc,uri:loaded.uri||file,path:loaded.path||file}});
  }
  SaveGuardSelective.walkReferences(document,function(raw,from,field){reference(raw,from,field,null);},'light',0,options.isCancelled);
  while(at<queue.length){check();var item=queue[at++];SaveGuardSelective.walkReferences(item.record,function(raw,from,field){reference(raw,from,field,item.scope);},'dependency',0,options.isCancelled);}
 }
 function extract(doc,id,namespace,force,options){options=options||{};var selectedInfo=describe(doc,id,options);need(selectedInfo.type==='light','Selected source is not a light');var plan=SaveGuardSelective.plan(doc,[id],{fullData:true,includeDescendants:false,preserveAnimation:true,isCancelled:options.isCancelled,resolveAssetDocument:options.resolveAssetDocument});need(plan.ready,(plan.errors||[]).join('; '));var built=SaveGuardSelective.extract(doc,plan,{namespace:namespace,isCancelled:options.isCancelled,resolveExternal:options.resolveExternal}),out=built.document,nodes=out.scene.nodes,specs=[],names={},i,j;
  // The native loader receives every record selected by the dependency planner, including referenced nodes.
  // No wrapper reconstructs or clamps a native light property.
  verifyAssetClosure(out,options);var sourceNodes=doc.scene.nodes||[],byMapped={};for(i=0;i<sourceNodes.length;i++){var mapped=built.mapId(sourceNodes[i].id);if(mapped)byMapped['$'+mapped]=sourceNodes[i].id;}
  for(i=0;i<nodes.length;i++){var n=nodes[i],sourceId=byMapped['$'+n.id];need(sourceId,'Unowned staged light dependency');var d=describe(doc,sourceId,options),c=d.channelById;names['$'+n.id]=namespace+'_'+i;n.name=names['$'+n.id];if(force)n.label=String(n.label||sourceId)+' [rollback '+namespace+']';var type=d.type==='light'?(d.kind==='point'?'DzPointLight':d.kind==='spot'?'DzSpotLight':'DzDistantLight'):d.group?'DzGroupNode':'DzNode';specs.push({id:sourceId,type:type,kind:d.kind,channels:d.channels,color:c['$Color']?value(c['$Color']):null,intensity:c['$Intensity']?value(c['$Intensity']):null,illumination:c['$Illumination']?value(c['$Illumination']):null});}
  for(i=0;i<nodes.length;i++){var parent=nodes[i].parent?SaveGuardSelective.parseURI(nodes[i].parent):null;specs[i].parentName=parent&&parent.kind==='local'?names['$'+parent.fragment]||null:null;}
  return {namespace:namespace,document:out,specs:specs,sourceId:id,selectedIndex:(function(){for(var si=0;si<specs.length;si++)if(specs[si].id===id)return si;return -1;}()),sourceLabel:selectedInfo.node.label||id,photometric:selectedInfo.photometric,dependencies:built.dependencies,placement:null};
 }
 return {extract:extract,describe:describe,validate:validate};
}());

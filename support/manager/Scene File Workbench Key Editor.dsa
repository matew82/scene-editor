  widget.flat=true;nav.flat=true;slots.flat=true;box.margin=3;box.spacing=4;navLayout.margin=0;navLayout.spacing=4;row.margin=0;row.spacing=4;caption.wordWrap=true;box.addWidget(caption);box.addWidget(nav);box.addWidget(slots);box.addWidget(scroll);scroll.min=0;scroll.max=1;scroll.value=0;scroll.sensitivity=.01;scroll.labelVisible=false;scroll.textVisible=false;scroll.textEditable=false;scroll.minHeight=20;scroll.toolTip='Scroll the saved frame range. Use Go to frame for an exact frame.';timer.singleShot=true;
  function bind(w,signal,fn){var wrapped=function(){if(!closed&&!painting)return fn.apply(null,arguments);};env.connect(w,signal,wrapped);links.push([w,signal,wrapped]);}
  function button(text,tip,fn){var w=new env.DzPushButton(nav);w.text=text;w.toolTip=tip;w.minHeight=28;w.autoDefault=false;navLayout.addWidget(w);bind(w,'clicked()',fn);return w;}
  function usable(){return !closed&&enabled&&editor&&(!hooks.isBusy||!hooks.isBusy());}
  function move(next){if(!usable())return;start=Math.max(0,Math.min(Math.max(0,editor.cellCount-capacity),Math.floor(next)));refresh(true);}
  var first=button('|<','First saved scene frame',function(){move(0);}),previous=button('‹','Previous frames',function(){move(start-capacity);}),jump=new env.DzLineEdit(nav);jump.placeholderText='Go to frame';jump.toolTip='Scroll to a frame; only frames with an existing key can be selected.';navLayout.addWidget(jump,1);var next=button('›','Next frames',function(){move(start+capacity);}),last=button('>|','Last saved scene frame',function(){move(editor?editor.cellCount-capacity:0);});
  function error(e){if(hooks.error)hooks.error(e);}
  bind(jump,'editingFinished()',function(){if(!usable())return;var text=String(jump.text).replace(/^\s+|\s+$/g,'');if(!text)return;try{if(!/^[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?$/.test(text))fail('Enter a finite frame number.');var frame=Number(text);if(!isFinite(frame))fail('Enter a finite frame number.');var index=editor.indexForFrame(frame);move(index);var target=editor.cell(index);if(target&&target.keyed&&target.frame===frame)hooks.select(editor,target.time);}catch(e){error(e);}});
  bind(scroll,'valueChanged(float)',function(value){if(!usable())return;move(Math.max(0,Math.min(1,Number(value)))*Math.max(0,editor.cellCount-capacity));});
  function width(){var n=Number(slots.width);if(!(n>0)&&typeof slots.getWidget==='function')n=Number(slots.getWidget().width);if(!(n>0))n=Number(parent.width);if(!(n>0))n=500;return n;}
  function refresh(force){if(closed||!visible||!editor)return;var count=Math.max(1,Math.min(editor.cellCount,Math.floor((width()-8)/40))),busy=!usable();capacity=count;start=Math.max(0,Math.min(start,Math.max(0,editor.cellCount-capacity)));var fresh=[generation,capacity,start,editor.frameRevision,busy].join('|');if(!force&&stamp===fresh)return;painting=true;try{stamp=fresh;while(buttons.length<capacity)(function(index){var b=new env.DzPushButton(slots);b.autoDefault=false;b.setFixedSize(36,36);row.addWidget(b);buttons.push(b);bind(b,'clicked()',function(){if(!usable())return;var point=cells[index],source=editor;if(point&&point.keyed)try{hooks.select(source,point.time);}catch(e){error(e);}});})(buttons.length);
   cells=[];for(var i=0;i<buttons.length;i++){var point=i<capacity?editor.cell(start+i):null,b=buttons[i];b.visible=!!point;if(!point)continue;cells[i]=point;b.text=String(point.frame);b.toolTip='Frame '+point.frame+(point.keyed?' / '+point.time+' s':' — no saved key');b.enabled=!busy&&point.keyed;var selected=point.keyed&&point.time===editor.selectedTime;b.getWidget().styleSheet=selected?'QPushButton { background-color:#33483D; color:#F1F1F1; border:1px solid #69B58A; }':point.keyed?'QPushButton { background-color:#B7BCC3; color:#202124; border:1px solid #D0D3D8; } QPushButton:disabled { color:#777B80; }':'QPushButton { background-color:#292A2D; color:#737780; border:1px solid #44474D; }';}
   first.enabled=previous.enabled=!busy&&start>0;next.enabled=last.enabled=!busy&&start+capacity<editor.cellCount;jump.enabled=!busy;scroll.enabled=!busy&&editor.cellCount>capacity;scroll.value=editor.cellCount>capacity?start/(editor.cellCount-capacity):0;caption.text=editor.selectedTime===null?'No saved keys for this object.':'Frame '+(editor.selectedTime*editor.fps)+' / '+editor.selectedTime+' s — '+editor.fps+' FPS';if(editor.notes.length)caption.text+='\nSome saved key records are read-only or unresolved.';
  }finally{painting=false;}}
  bind(timer,'timeout()',function(){if(!visible||closed)return;try{if(!hooks.isBusy||!hooks.isBusy())refresh(false);}catch(e){error(e);}if(visible&&!closed)timer.start(100);});
  widget.hide();return{widget:widget,setEditor:function(value){if(editor!==value){editor=value;generation++;start=value?Math.max(0,value.selectedCell-Math.floor(capacity/2)):0;stamp='';}refresh(true);},setVisible:function(value){visible=value===true;widget.visible=visible;if(visible){refresh(true);timer.start(100);}else timer.stop();},setEnabled:function(value){enabled=value===true;refresh(true);},refresh:function(){refresh(true);},close:function(){if(closed)return;closed=true;timer.stop();for(var i=links.length-1;i>=0;i--)try{env.disconnect(links[i][0],links[i][1],links[i][2]);}catch(ignore){}links=[];buttons=[];cells=[];editor=null;}};
 }
 return{create:create,interpolation:interpolation,frameStrip:frameStrip};
}());

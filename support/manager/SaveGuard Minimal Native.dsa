   var out={file_version:doc.file_version,asset_info:{id:'/SaveGuardExperiment/minimal-manager-subset.duf',type:'scene_subset',revision:'1.0'},scene:{}},ids={};
   for(i=0;i<p.locators.length;i++){m=/^(scene\.)?([A-Za-z_]+)\[(\d+)\]$/.exec(p.locators[i]);if(!m)fail('Unsupported local locator');src=m[1]?working.scene:working;dst=m[1]?out.scene:out;if(!dst[m[2]])dst[m[2]]=[];dst[m[2]].push(src[m[2]][Number(m[3])]);}
   if(out.scene.animations&&out.scene.animations.length){out.scene.extra=[];for(i=0;i<(doc.scene.extra||[]).length;i++)if(doc.scene.extra[i].animation_settings)out.scene.extra.push(doc.scene.extra[i]);}

   if(omitted.length){p.warnings=p.warnings||[];p.warnings.push('Smoothing collision targets outside the selected subset were cleared; smoothing appearance can change.');}builtValue={document:out,idMap:ids,dependencies:p.dependencies,summary:p,omittedCollisionTargets:omitted};return {plan:p,built:builtValue,channels:channels};
  }
 function create(env,info,newStager){
  if(!eligible(info.request))fail('Incompatible minimal-native action');
  if(!SaveGuardNativeRuntime.hostSupported(env))fail('Native loading host build or required APIs unavailable');
  if(info.context.lowMemoryMode===true)fail('Minimal-native candidate requires Low RAM OFF');
  var provider=info.context.provider,source=info.context.planningDocument,closed=false,issued=[],stager=null,builtValue=null,channels=null;
  function current(){if(closed||info.context.provider!==provider||info.context.planningDocument!==source||provider.verifySource()!==true)fail('Minimal source context changed');}
  function cancel(fn){if(fn&&fn()===true){var e=Error('Cancelled');e.code='CANCELLED';throw e;}}
  function nodeId(node){var id=node&&node.elementID;if(typeof id!=='number'||!isFinite(id)||id<0||Math.floor(id)!==id||id>9007199254740991)fail('Invalid native elementID property');return String(id);}
  function own(o,k){return Object.prototype.hasOwnProperty.call(o,k);}
  function identity(nodes){var map={},keys=[],i,k;for(i=0;i<nodes.length;i++){k='$'+nodeId(nodes[i]);if(own(map,k))fail('Duplicate native identity');map[k]=true;keys.push(k);}return {map:map,keys:keys};}
  function missing(a,b){var out=[],i;for(i=0;i<a.keys.length;i++)if(!own(b.map,a.keys[i]))out.push(a.keys[i]);return out;}
  function sameNodes(a,nodes){var b=identity(nodes);return a.keys.length===b.keys.length&&missing(a,b).length===0;}

var SaveGuardMinimalNative=(function(){
 function fail(s){throw Error(s);}
 function eligible(r){return !!r&&(r.actionKey==='loadCharacter'||r.actionKey==='loadObject'&&(r.tabKey==='objects'||r.tabKey==='lights'));}
 function resolver(){return {resolveExternal:function(){fail('Minimal import delegates external assets to DAZ');},resolveAssetDocument:function(){fail('External asset expansion prohibited');},verifyAll:function(){return true;},close:function(){}};}
 // Clone only recognized smoothing records. Non-collision references keep their normal closure.
 function collisionProjection(doc){
  function own(o,k){return Object.prototype.hasOwnProperty.call(o,k);}
  var out={},scene={},mods=doc.scene&&doc.scene.modifiers||[],next=mods.slice(0),links=[],i,j,k,x,record,extras,channels,channel,uri,copyRecord;
  var animated={},animations=doc.scene&&doc.scene.animations||[];for(i=0;i<animations.length;i++){uri=SaveGuardMinimalSelector.parseURI(animations[i].url);if(uri.fragment)animated['$'+uri.fragment]=true;var paths=(uri.nodePath||'').split('/');for(j=0;j<paths.length;j++)if(paths[j])animated['$'+decodeURIComponent(paths[j])]=true;}
  for(k in doc)if(own(doc,k))out[k]=doc[k];for(k in doc.scene)if(own(doc.scene,k))scene[k]=doc.scene[k];out.scene=scene;scene.modifiers=next;
  for(i=0;i<mods.length;i++){
   record=mods[i];extras=record.extra||[];var smoothing=false;for(j=0;j<extras.length;j++)if(extras[j].type==='studio/modifier/smoothing')smoothing=true;if(!smoothing||animated['$'+record.id]||animated['$'+SaveGuardMinimalSelector.parseURI(record.parent).fragment]||animated['$'+SaveGuardMinimalSelector.parseURI(record.url).fragment])continue;copyRecord=null;
   for(j=0;j<extras.length;j++){if(extras[j].type!=='studio_modifier_channels')continue;channels=extras[j].channels||[];for(x=0;x<channels.length;x++){
    channel=channels[x].channel;if(!channel||channel.id!=='Collision Item'||channel.type!=='node'||typeof channel.node!=='string'||!channel.node||channel.keys&&channel.keys.length||channel.animations&&channel.animations.length)continue;uri=SaveGuardMinimalSelector.parseURI(channel.node);if(uri.kind!=='local'||uri.nodePath||uri.query||!uri.fragment)continue;
    if(!copyRecord){copyRecord=JSON.parse(JSON.stringify(record));next[i]=copyRecord;}var projected=copyRecord.extra[j].channels[x].channel;links.push({index:i,modifierId:record.id,targetId:uri.fragment,uri:channel.node,channel:projected});projected.node=null;
   }}
  }return {document:out,links:links};
 }

 // Preserve a fully saved ordinary point light that is owned by the selected character subtree.
 // Reference/conform closure alone is not ownership. Cameras/render nodes remain specialized.
 function ownedCharacterPointLight(doc,rows,row,selectedId,action){
  if(action!=="loadCharacter"||row.type!=="light"||row.renderSettingsNode||row.id===selectedId)return false;
  var map={},nodes={},defs={},i,cursor=row,seen={};
  for(i=0;i<rows.length;i++)map["$"+rows[i].id]=rows[i];
  if(!map["$"+selectedId]||map["$"+selectedId].type!=="figure")return false;
  while(cursor&&cursor.id!==selectedId){if(seen["$"+cursor.id]||cursor.parentMode!=="parent"||!cursor.parentId)return false;seen["$"+cursor.id]=true;cursor=map["$"+cursor.parentId];if(cursor&&(cursor.type==="camera"||cursor.renderSettingsNode))return false;}
  if(!cursor||cursor.id!==selectedId)return false;
  for(i=0;i<(doc.scene.nodes||[]).length;i++)nodes["$"+doc.scene.nodes[i].id]=doc.scene.nodes[i];
  for(i=0;i<(doc.node_library||[]).length;i++)defs["$"+doc.node_library[i].id]=doc.node_library[i];
  var n=nodes["$"+row.id],u=SaveGuardMinimalSelector.parseURI(n&&n.url),d=u.kind==="local"&&!u.nodePath&&!u.query?defs["$"+u.fragment]:null;
  return !!(d&&d.type==="light"&&d.point&&typeof d.point==="object"&&Object.prototype.toString.call(d.point)!=="[object Array]"&&!d.spot&&!d.directional&&!d.source&&!d.url);
 }
 function ownedScope(doc,id,p){
  var rows=SaveGuardMinimalSelector.catalog(doc,{fullData:true}).rows,map={},i;for(i=0;i<rows.length;i++)map['$'+rows[i].id]=rows[i];
  // The selected tree and exact explicit dependency references define ownership.
  // A uniquely referenced saved node is retained even outside the selected tree;
  // unrelated records never enter the planner's locator set.
  for(i=0;i<p.nodeIds.length;i++){var row=map['$'+p.nodeIds[i]];if(!row)fail('Missing native closure node');if(row.renderSettingsNode)fail('Render settings require their specialized action');}
 }
 // Copy every authored member. Rewrite only parsed dependency fields or declared
 // file channels; labels and ordinary string values are never filenames.
 function resources(document,dependencies,options){
  var fields={url:1,source:1,parent:1,parent_in_place:1,conform_target:1,node:1,geometry:1,uv_set:1,default_uv_set:1,image:1,image_file:1,output:1,current_camera:1,target:1,geometry_url:1,node_url:1},mapped={},stack=[],i;
  function file(f){if(!f)return f;if(Object.prototype.hasOwnProperty.call(mapped,'$'+f))return mapped['$'+f];if(f.charAt(0)==='/')return f;if(options.isCancelled&&options.isCancelled()){var cancelled=Error('Cancelled');cancelled.code='CANCELLED';throw cancelled;}if(typeof options.resolveExternal!=='function')fail('Relative dependency requires the original source resolver: '+f);var r=options.resolveExternal(f,{uris:[f]});if(!r||r.exists!==true||typeof r.uri!=='string'||r.uri.charAt(0)!=='/'||r.uri.charAt(1)==='/'||/[?#\\\x00-\x1f]/.test(r.uri)||decodeURIComponent(r.uri).split('/').indexOf('..')>=0)fail('Relative dependency was not safely rebased: '+f);mapped['$'+f]=r.uri;return r.uri;}
  function uri(s){if(typeof s!=='string'||!s)return s;var r=SaveGuardMinimalSelector.parseURI(s);if(r.kind==='unsafe')fail('Unsafe native resource reference');if(!r.file||r.file.charAt(0)==='/')return s;var replacement=file(r.file),offset=(r.scheme||'').length+(r.nodePath?r.nodePath.length+1:0);return s.substring(0,offset)+replacement+s.substring(offset+r.file.length);}
  for(i=0;i<dependencies.length;i++)file(dependencies[i].file);
  function enter(value){for(var si=0;si<stack.length;si++)if(stack[si].value===value)fail('Cyclic native record');var frame={value:value,out:Object.prototype.toString.call(value)==='[object Array]'?[]:{},keys:Object.keys(value),next:0};stack.push(frame);return frame.out;}
  var result=enter(document);while(stack.length){var f=stack[stack.length-1];if(f.next===f.keys.length){stack.pop();continue;}var key=f.keys[f.next++],v=f.value[key];if(key==='__proto__')fail('Unsafe native member');if(typeof v==='number'&&!isFinite(v))fail('Nonfinite native value');if(typeof v==='string'&&fields[key]&&!SaveGuardMinimalSelector.isPuppeteerNodeName(stack,key))f.out[key]=uri(v);else if(f.value.type==='file'&&(key==='value'||key==='current_value'))f.out[key]=uri(v);else if(f.value.type==='file'&&key==='keys'){f.out[key]=[];for(i=0;i<v.length;i++){var pair=v[i].slice(0);pair[1]=uri(pair[1]);f.out[key].push(pair);}}else f.out[key]=v&&typeof v==='object'?enter(v):v;}
  // Resolve a track declaration inside its exact saved owner, never by a global
  // channel label (different nodes may reuse the same channel ID).
  var records={},group,ri;for(group in result)if(/_library$/.test(group))for(ri=0;ri<result[group].length;ri++)records['$'+result[group][ri].id]=result[group][ri];var sceneGroups=['nodes','modifiers','materials','uvs'];for(var sg=0;sg<sceneGroups.length;sg++)for(ri=0;ri<(result.scene[sceneGroups[sg]]||[]).length;ri++){var record=result.scene[sceneGroups[sg]][ri];records['$'+record.id]=record;for(var gg=0;gg<(record.geometries||[]).length;gg++)records['$'+record.geometries[gg].id]=record.geometries[gg];}
  function channel(record,segments){var value=record;for(var pi=0;value&&pi<segments.length;pi++){var segment=segments[pi];if(segment==='value'||segment==='current_value')return value.type?value:value.channel;if(Object.prototype.toString.call(value)==='[object Array]'){var matches=[];for(var ai=0;ai<value.length;ai++)if(value[ai]&&(value[ai].id===segment||value[ai].type===segment||value[ai].channel&&value[ai].channel.id===segment))matches.push(value[ai].channel||value[ai]);if(matches.length>1)fail('Ambiguous native file channel');value=matches[0];}else value=value[segment];}return null;}
  function declared(record,segments){var seen={};while(record){if(seen['$'+record.id])fail('Native file-channel inheritance cycle');seen['$'+record.id]=true;var found=channel(record,segments);if(found)return found;var definition=SaveGuardMinimalSelector.parseURI(record.url||record.source||'');record=definition.kind==='local'?records['$'+definition.fragment]:null;}return null;}
  for(i=0;i<(result.scene.animations||[]).length;i++){var track=result.scene.animations[i],ref=SaveGuardMinimalSelector.parseURI(track.url),segments=decodeURIComponent(ref.query||'').replace(/^\?/, '').split('/'),record=records['$'+ref.fragment],declaration=declared(record,segments);for(var ki=0;ki<track.keys.length;ki++){var value=track.keys[ki][1];if(declaration&&declaration.type==='file')track.keys[ki][1]=uri(value);else if(!declaration&&typeof value==='string'&&value.charAt(0)!=='#'&&!/^(id:|name:)/.test(value)&&(/[/\\]/.test(value)||/\.(duf|dsf|png|jpg|jpeg|exr|hdr|ies|tif|tiff)$/i.test(value)))fail('Native animated resource needs an exact saved channel declaration');}}
  return result;
 }
 function compile(doc,id,action,options){
   options=options||{};if(options.isCancelled&&options.isCancelled()){var cancelled=Error('Cancelled');cancelled.code='CANCELLED';throw cancelled;}
   var channels=null,builtValue=null,projection=action==='loadObject'?collisionProjection(doc):{document:doc,links:[]},working=projection.document,planOptions={fullData:true,preserveAnimation:true,resolveAssetDocument:options.resolveAssetDocument,isCancelled:options.isCancelled},p=SaveGuardMinimalSelector.plan(working,[id],planOptions),omitted=[],i,m,src,dst,n;
   if(!p.ready)fail(p.errors.join('; '));for(i=0;i<projection.links.length;i++){var link=projection.links[i];if(p.nodeIds.indexOf(link.targetId)>=0)link.channel.node=link.uri;else if(p.locators.indexOf('scene.modifiers['+link.index+']')>=0)omitted.push({modifierId:link.modifierId,targetId:link.targetId,channel:'Collision Item'});}if(projection.links.length)p=SaveGuardMinimalSelector.plan(working,[id],planOptions);
   if(!p.ready)fail(p.errors.join('; '));if(!p.nodeIds.length)fail('Selected import is empty');

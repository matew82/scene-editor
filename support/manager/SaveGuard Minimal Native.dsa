  function build(doc,id){current();if(doc!==source||id!==info.request.sourceId)fail("Minimal source selection changed");var result=info.context.loadCacheLease&&info.context.loadCacheLease.compiled;if(result)needCached(info.context.loadCacheLease);else result=compile(doc,id,info.request.actionKey,{resolveExternal:info.resolver&&info.resolver.resolveExternal,resolveAssetDocument:info.resolver&&info.resolver.resolveAssetDocument,isCancelled:info.isCancelled});builtValue=result.built;channels=result.channels;return result;}

  function needCached(lease){if(!lease||lease.verify()!==true)fail("Cached payload changed");}
  var api={minimalNative:true,buildMerge:build,computePlacement:function(b){if(b!==builtValue)fail('Unknown minimal payload');return {rule:'native-preserved-ancestors',nodes:[],byId:{}};},
   prepare:function(req,cancelled){current();cancel(cancelled);if(req.kind!=='merge'||req.built!==builtValue)fail('Minimal request changed');
    var start=new Date().getTime(),lease=info.context.loadCacheLease;if(!lease&&info.context.loadCache)lease=info.context.loadCache.publish(req.built,channels);var token;if(lease){needCached(lease);token={path:lease.path,cacheLease:lease};}else{if(!stager)stager=newStager();token=stager.stage(req.built.document,req.source.path);}var r={token:token,source:req.source,count:req.built.document.scene.nodes.length,used:false,stageMs:new Date().getTime()-start};issued.push(r);return r;},
   apply:function(r,cancelled){var start=new Date().getTime(),report={ok:false,route:'minimal-native-output-v1',deepValidation:info.context.deepValidation===true,externalAssetReads:0,omittedCollisionTargets:builtValue.omittedCollisionTargets,outputAudited:false,restorationClaimed:false,mutationStarted:false},held=false,selectedBefore=[],primaryBefore=null,selectionCaptured=false,completed=false,io,mode;
    function failure(e,field){var text=String(e.message||e);if(field)report[field]=text;if(!report.error)report.error=text;if(e.code==='CANCELLED')report.cancelled=true;}
    function ownedSelection(){if(report.undoOwnershipLost||report.undoStateUnknown)fail('Owned Undo unavailable; selection retained');try{if(env.UndoStack.canPushItems()===true&&env.UndoStack.isInUndoRedo()===false)return;}catch(e){report.undoError=String(e);}report.undoOwnershipLost=true;report.undoStateUnknown=true;held=false;fail('Owned Undo unavailable; selection retained');}
    function restoreSelection(){ownedSelection();if(env.Scene.selectAllNodes(false)===false)fail('Selection clear failed');for(var si=0;si<selectedBefore.length;si++){ownedSelection();if(selectedBefore[si].select(true)===false)fail('Selection restore failed');}ownedSelection();if(env.Scene.setPrimarySelection(primaryBefore)===false)fail('Selection restoration failed');report.selectionReturned=true;}
    try{current();if(issued.indexOf(r)<0||r.used)fail('Unknown or consumed minimal receipt');r.used=true;cancel(cancelled);if(r.source.verify()!==true)fail('Source changed');if(info.resolver&&typeof info.resolver.verifyAll==='function'&&info.resolver.verifyAll()!==true)fail('Native dependencies changed');if((r.token.cacheLease?r.token.cacheLease.verify():stager.verify(r.token))!==true)fail('Staged payload changed');io=env.App.getAssetIOMgr();mode=env.DzAssetIOMgr.MergeFile;
     if(typeof mode!=='number'||!isFinite(mode)||Math.floor(mode)!==mode||typeof env.DzAssetIOMgr.OpenNew!=='number'||typeof env.DzAssetIOMgr.DefaultMethod!=='number'||mode===env.DzAssetIOMgr.OpenNew||mode===env.DzAssetIOMgr.DefaultMethod)fail('Explicit MergeFile unavailable');
     if(env.UndoStack.canPushItems()!==false||env.UndoStack.isInUndoRedo()!==false||env.Scene.isLoading()!==false||io.isReadingOrWriting()!==false)fail('Scene I/O or Undo busy');var timelinePlan=SaveGuardMinimalTimeline.plan(env.Scene,channels);SaveGuardMinimalTimeline.available(env,timelinePlan);report.timeline=timelinePlan;selectedBefore=SaveGuardSceneInventory.selected(env.Scene);primaryBefore=env.Scene.getPrimarySelection();selectionCaptured=true;cancel(cancelled);
     report.undoBeginAttempted=true;env.beginUndo();held=true;if(env.UndoStack.canPushItems()!==true)fail('Owned Undo did not start');report.mutationStarted=true;SaveGuardMinimalTimeline.set(env,timelinePlan.after);cancel(cancelled);report.nativeExecuted=true;var t=new Date().getTime(),code=io.doLoad(r.token.path,mode);report.mergeMs=new Date().getTime()-t;report.nativeExecuted=true;report.nativeCode=code!==null&&code!==undefined&&typeof code.valueOf==='function'?code.valueOf():code;if(typeof report.nativeCode!=='number'||report.nativeCode!==0)fail('Native merge failed: '+String(code));ownedSelection();cancel(cancelled);completed=true;
    }catch(e){failure(e);if(report.undoBeginAttempted&&!held&&!report.mutationStarted)report.undoStateUnknown=true;if(e.undoOwnershipLost)report.undoOwnershipLost=true;}
    finally{
     if(selectionCaptured&&report.mutationStarted)try{restoreSelection();}catch(selectionError){failure(selectionError,'selectionError');}
     if(held)try{if(env.UndoStack.canPushItems()!==true||report.undoOwnershipLost){held=false;report.undoOwnershipLost=true;throw Error('Owned Undo unavailable; no blind accept/cancel');}held=false;report.undoAcceptAttempted=true;env.acceptUndo(report.error?'SaveGuard minimal import - failed attempt':'SaveGuard minimal native import');report.undoAccepted=true;if(env.UndoStack.canPushItems()!==false)fail('Undo did not return to idle');}catch(undoError){report.undoStateUnknown=true;failure(undoError,'undoError');}
    }
    report.ok=completed&&!report.error&&report.undoAccepted===true;report.status=report.ok?'applied':report.undoOwnershipLost||report.undoStateUnknown?'recovery-required':report.cancelled&&!report.mutationStarted?'cancelled':report.mutationStarted?'failed-attempt':'stopped';report.recoveryRequired=report.status==='recovery-required';report.message=report.ok?'Native content import completed.':report.error;if(report.ok&&builtValue.omittedCollisionTargets.length)report.message+=' Smoothing collision targets outside the selection were cleared; check the smoothing result.';report.totalMs=new Date().getTime()-start;report.stageMs=r&&r.stageMs;if(typeof print==='function')print('SG_MANAGER_MINIMAL_NATIVE '+JSON.stringify(report));return report;},
   release:function(r){var at=issued.indexOf(r);if(at<0)return false;issued.splice(at,1);if(!r.token.cacheLease&&stager&&stager.release(r.token)!==true)fail('Owned staging cleanup returned false');return true;},close:function(){while(issued.length)api.release(issued[0]);closed=true;builtValue=null;}};return api;
 }
 return {compile:compile,eligible:eligible,resolver:resolver,create:create,ownedCharacterPointLight:ownedCharacterPointLight};
}());

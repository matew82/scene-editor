  function tick(){if(!alive)return;timer.stop();if(!alive||painting||parameterBusy||invalid)return;painting=true;try{if(!prepared){stage='compare-cache-read';snapshots=[host.readComparisonCache(paths[0],settings),host.readComparisonCache(paths[1],settings)];guard();stage='compare-cache-model';rows=compare(snapshots[0],snapshots[1],guard,settings);if(callbacks.unresolvedIds){var unresolvedA=callbacks.unresolvedIds[0]||[],unresolvedB=callbacks.unresolvedIds[1]||[];for(var ur=0;ur<rows.length;ur++)if(unresolvedA.indexOf(rows[ur].aId)>=0||unresolvedB.indexOf(rows[ur].bId)>=0){rows[ur].status='Unknown';rows[ur].shadeA=rows[ur].shadeB='unknown';rows[ur].eligible=false;if(rows[ur].a==='Absent')rows[ur].a='Not recorded / unresolved';if(rows[ur].b==='Absent')rows[ur].b='Not recorded / unresolved';}}baseRows=rows.slice(0);refreshSummary();differenceOpen=differenceBranches(rows);prepared=true;filter.enabled=true;enableExpansion(true);selectionState();chooseRows();}if(!fresh()){invalidate();return;}stage='compare-row-display';if(cursor===0)trace('tree-populate-begin',String(visible.length));var beforeCursor=cursor,until=Math.min(cursor+100,visible.length);while(cursor<until&&alive){var r=visible[cursor++],item=new env.DzListViewItem(r.parentKey&&itemByKey['$'+r.parentKey]||tree);item.selectable=true;item.addDataItem('SceneEditor.comparePair',r.eligible?r.pairKey:'');var siblingKey=r.parentKey||'root';if(lastSibling[siblingKey])item.moveItem(lastSibling[siblingKey]);lastSibling[siblingKey]=item;item.setText(0,r.group==='Render Settings'&&r.a!==r.property?r.property+': '+r.a:r.a);item.setText(1,r.group==='Render Settings'&&r.b!==r.property?r.property+': '+r.b:r.b);item.setPixmap(0,marks[r.shadeA]);item.setPixmap(1,marks[r.shadeB]);item.open=expanded(r.key);itemByKey['$'+r.key]=item;items.push(item);if(r.eligible&&selectedPairs['$'+r.pairKey])tree.setSelected(item,true);}if(beforeCursor<visible.length&&cursor===visible.length)trace('tree-populate-complete',String(cursor));if(alive
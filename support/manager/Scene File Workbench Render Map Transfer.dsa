/* Copy complete render maps, with private layered-image identities. No texture writes. */
var SceneEditorRenderMapTransfer=(function(){
 function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}function copy(v){return JSON.parse(JSON.stringify(v));}function need(v,s){if(!v)throw Error('Render map transfer: '+s);}function eq(a,b){return SceneEditorCore.equal(a,b);}function decode(v){return decodeURIComponent(String(v||''));}
 function supportsPath(p){return p&&p.length===2&&(p[0]==='ENVIRONMENT / HDRI'||p[0]==='TONE MAPPING')&&/ \/ Image$/.test(p[1]);}
 function reason(d){return !d||!supportsPath(d.path)?'Select the Image row to copy a complete map, including its layers, masks and adjustments.':d.status!=='Changed'&&d.status!=='Equal'?'Only recorded maps can be copied.':'';}
 function selectionEligibility(rows){for(var i=0;i<rows.length;i++){var why=reason(rows[i]);if(why)return{allowed:false,reason:why};}return{allowed:rows.length>0,reason:'Copy the complete map, including layers, masks and image adjustments. Other scene maps are kept unchanged.'};}
 function prepare(io,paths,rows,direction,guard){guard=guard||function(){};need(selectionEligibility(rows).allowed,'Select complete maps separately from other values');var a=paths[direction===0?0:1],b=paths[direction===0?1:0];need(String(a).replace(/\\/g,'/').toLowerCase()!==String(b).replace(/\\/g,'/').toLowerCase(),'Source and destination must differ');var source=new SceneEditorCore.Document(a,io,guard),target=new SceneEditorCore.Document(b,io,guard),expected=copy(target.data),ops=[],changes=[],nodes={},lib=copy(target.data.image_library||[]),libChanged=false,seen={},assets=[];
 function resolveAsset(raw,scene){try{return io.resolve(raw,scene);}catch(e){if(raw.indexOf('/resources/')!==0||typeof App==='undefined'||typeof App.getShadersPath!=='function')throw e;var file=String(App.getShadersPath()).replace(/\\/g,'/')+'/iray'+raw;return io.resolve(file.charAt(0)==='/'?file:'/'+file,scene);}}
 function checkFile(uri){if(!uri)return uri;var raw=decode(uri);need(!/[\x00-\x1f]/.test(raw),'Invalid image URI');need(typeof io.resolve==='function','Asset resolver unavailable');var resolved=resolveAsset(raw,a);need(resolved,'Missing source image');assets.push({uri:raw,path:resolved});if(raw.charAt(0)==='/'){need(resolveAsset(raw,b)===resolved,'Destination resolves this image differently');return uri;}resolved=String(resolved).replace(/\\/g,'/');need(/^[A-Za-z]:\//.test(resolved)||resolved.indexOf('//')===0,'Image path cannot be transferred safely');return encodeURI(resolved.charAt(0)==='/'?resolved:'/'+resolved);}
 function image(id){var found=null,defs=source.data.image_library||[];for(var i=0;i<defs.length;i++)if('#'+defs[i].id===decode(id)){need(!found,'Ambiguous source image');found=defs[i];}need(found&&!found.source&&!found.url&&found.map&&found.map.length,'Missing or external layered image');var im=copy(found),keys=['id','name','map_size','map_gamma','map'];for(var k in im)if(own(im,k))need(keys.indexOf(k)>=0,'Unsupported image field '+k);function layer(m){need(m&&typeof m==='object','Invalid map layer');var allowed=['url','label','active','color','transparency','invert','rotation','xmirror','ymirror','xscale','yscale','xoffset','yoffset','operation','mask'];for(var k in m)if(own(m,k))need(allowed.indexOf(k)>=0,'Unsupported map-layer dependency '+k);if(m.url)m.url=checkFile(m.url);if(m.mask)layer(m.mask);}for(var j=0;j<im.map.length;j++)layer(im.map[j]);var stem='SFW_Render_Map',n=1,idNew,used;do{idNew=stem+'_'+n++;used=false;for(j=0;j<lib.length;j++)if(lib[j].id===idNew)used=true;}while(used);im.id=idNew;lib.push(im);libChanged=true;return '#'+idNew;}
 for(var i=0;i<rows.length;i++){guard('Prepare complete render map');var d=rows[i];need(!reason(d),reason(d));need(eq(SceneEditorRenderTransfer.display(source.data,d.path),direction===0?d.valueA:d.valueB)&&eq(SceneEditorRenderTransfer.display(target.data,d.path),direction===0?d.valueB:d.valueA),'Map changed since comparison; compare again');var key=JSON.stringify(d.path);if(seen[key])continue;seen[key]=true;var name=d.path[1].replace(/ \/ Image$/,''),p=[d.path[0],name],from=SceneEditorRenderTransfer.binding(source.data,p),to=SceneEditorRenderTransfer.binding(target.data,p),sc=from.hits[0].channel,th=to.hits[0],tc=th.channel;need(th.helperNodePath,'Existing helper required');need(sc.type===tc.type,'Map property types differ');need(!sc.keys&&!sc.animations&&!sc.alias&&!tc.keys&&!tc.animations&&!tc.alias&&tc.locked!==true,'Animated, aliased or locked map');need(!(sc.image&&sc.image_file),'Ambiguous source map');if(sc.image_modification){var mf=['grayscale_mode','scale','offset','invert','horizontal_tiles','horizontal_tiling_offset','vertical_tiles','vertical_tiling_offset'];for(var mk in sc.image_modification)if(own(sc.image_modification,mk))need(mf.indexOf(mk)>=0,'Unsupported image adjustment '+mk);}var fields={image:null,image_file:null,image_modification:sc.image_modification?copy(sc.image_modification):null};if(sc.image)fields.image=image(sc.image);else if(sc.image_file){fields.image_file=checkFile(sc.image_file);var defs=source.data.image_library||[];for(var di=0;di<defs.length;di++){var maps=defs[di].map||[];for(var mi=0;mi<maps.length;mi++)if(decode(maps[mi].url)===decode(sc.image_file)){need(maps.length===1&&!defs[di].source,'Filename has layered or external image metadata');var imported=copy(defs[di]);imported.map[0].url=fields.image_file;var identical=false;for(var ti=0;ti<lib.length;ti++)for(var tm=0;tm<(lib[ti].map||[]).length;tm++)if(decode(lib[ti].map[tm].url)===decode(fields.image_file)){need(eq(lib[ti].map,imported.map)&&eq(lib[ti].map_gamma||0,imported.map_gamma||0),'Destination already uses this file with different image settings');identical=true;}if(!identical){var sn=lib.length,sid,collision;do{sid='SFW_Render_File_'+sn++;collision=false;for(var ix=0;ix<lib.length;ix++)if(lib[ix].id===sid)collision=true;}while(collision);imported.id=sid;lib.push(imported);libChanged=true;}}}}
 var ni=th.helperNodePath[2],node=expected.scene.nodes[ni];nodes['$'+ni]=ni;if(!node.extra)node.extra=[];var extra=null;for(var ei=0;ei<node.extra.length;ei++)if(node.extra[ei].type===th.extraType){need(!extra,'Ambiguous helper extra');extra=node.extra[ei];}if(!extra){extra={type:th.extraType,channels:[]};node.extra.push(extra);}if(!extra.channels)extra.channels=[];var dest=null;for(var ci=0;ci<extra.channels.length;ci++)if(extra.channels[ci].channel&&extra.channels[ci].channel.id===name){need(!dest,'Ambiguous helper channel');dest=extra.channels[ci].channel;}if(!dest){dest={id:name};extra.channels.push({channel:dest});}for(var field in fields)if(own(fields,field))dest[field]=fields[field];changes.push({object:'Render Settings',label:name+' / complete map (layers, masks and adjustments)',before:tc.image||tc.image_file||'None',after:sc.image||sc.image_file||'None'});
 }
 for(var nk in nodes)if(own(nodes,nk)){var index=nodes[nk],old=target.data.scene.nodes[index];ops.push(own(old,'extra')?{kind:'replace',path:['scene','nodes',index,'extra'],value:expected.scene.nodes[index].extra}:{kind:'add',path:['scene','nodes',index],key:'extra',value:expected.scene.nodes[index].extra});}if(libChanged){expected.image_library=lib;ops.push(own(target.data,'image_library')?{kind:'replace',path:['image_library'],value:lib}:{kind:'add',path:[],key:'image_library',value:lib});}var text=target.patch(ops);need(eq(SceneEditorCore.parseDocument(text,guard),expected),'Output validation failed');function verify(){source.verify();target.verify();for(var ai=0;ai<assets.length;ai++)need(resolveAsset(assets[ai].uri,a)===assets[ai].path,'Image resolution changed');}verify();return{kind:'renderMaps',source:a,target:b,document:target,text:text,changes:changes,verify:verify,committed:false};
 }
 return{supportsPath:supportsPath,reason:reason,selectionEligibility:selectionEligibility,prepare:prepare};
}());

  for(i=0;i<tracks.length;i++){
   defs.guard();var t=tracks[i],u=decodeURIComponent(String(t.url||""));
   if(u.indexOf("?value")<0)continue;
   need(!/name:\/\//.test(u),"Name-addressed shaping animation is ambiguous");
   u=u.replace(/^id:\//,"");
   var hash=u.indexOf("#"),query=u.indexOf("?"),prefix=u.substring(0,hash),fragment=u.substring(hash+1,query),colon=prefix.indexOf(":"),anchor=colon>=0?prefix.substring(0,colon):"",file=colon>=0?prefix.substring(colon+1):prefix;
   // A track explicitly scoped to another saved node cannot affect this figure.
   // Do not interpret or widen that other node's channel/key formats.
   var otherNode=false;
   if(anchor&&anchor.indexOf("/")<0&&anchor!==id)for(var ni=0;ni<doc.scene.nodes.length;ni++)if(doc.scene.nodes[ni].id===anchor)otherNode=true;
   if(otherNode)continue;
   need(hash>=0&&query>hash&&u.substring(query)==="?value"&&u.indexOf("#",hash+1)<0,"Unsupported shaping animation reference");
   var candidates=[],matched=null;
   for(var mi=0;mi<mods.length;mi++){
    var candidate=mods[mi],matches=!file?candidate.id===fragment:candidate.url&&candidate.url.charAt(0)==="/"&&uri(candidate.url)===uri(file+"#"+fragment);
    if(matches&&anchor){var path=anchor.split("/"),last="";for(var ai=0;ai<path.length;ai++)if(path[ai])last=path[ai];matches=last===candidate.id||candidate.parent&&local(candidate.parent)===last;}
    if(matches)candidates.push(candidate);
   }
   need(candidates.length===1,"Missing or ambiguous shaping animation owner");
   var owner=candidates[0];if(!owner.parent||!owners["$"+local(owner.parent)])continue;
   for(var ri=0;ri<rows.length;ri++)if(rows[ri].id===owner.id)matched=rows[ri];
   if(!matched)continue;
   need(!trackSeen["$"+matched.uri],"Duplicate shape animation");trackSeen["$"+matched.uri]=true;
   need(array(t.keys)&&t.keys.length===1&&t.keys[0].length===2&&t.keys[0][0]===0&&finite(t.keys[0][1])===matched.value,"Animated shaping is unsupported; sole matching frame-0 key required");
  }
  return {ready:true,errors:[],warnings:["Saved shaping values are applied to compatible existing controls. Pose and materials are retained.","Embedded morphs require matching geometry and vertex deltas; missing morphs are not created."],sourceId:id,sourceUri:sourceUri,geometryUri:geometryUri,rows:rows,records:records,excluded:excluded,definitionFiles:defs.files,
   definition:function(ref){return defs.get(uri(ref),"modifier_library");}};
 }
 // Destination-only installed shaping controls use resolved definition defaults, never a blanket zero.
 function match(plan,targets,cancelled){
  var seen={},assignments=[],skipped=[],i,t,d,s,def,value;
  for(i=0;i<targets.length;i++){
   if(cancelled&&cancelled()===true)throw Error("Shape cancelled");
   t=targets[i];var ref=t.localRow?t.localRow.uri:uri(t.uri);need(!seen["$"+ref],"Duplicate destination modifier identity");seen["$"+ref]=true;
   if(t.localRow){need(plan.records["$"+ref]===t.localRow&&t.localRow.localMorph,"Unverified local shape mapping");d=t.localRow.definition;}else d=plan.definition(ref);if(!d.presentation||d.presentation.type!=="Modifier/Shape")continue;
   need(d.channel&&d.channel.id==="value"&&d.channel.type==="float","Unsupported target shaping definition");
   s=plan.records["$"+ref];def=s?s.defaultValue:finite(d.channel.value);value=s?s.value:def;
   if(t.driven){if(typeof t.raw==="number"&&Math.abs(t.raw-value)<=0.000001){if(s&&value!==def)need(t.rawKeyWritable===true,"Authored driven shape requires a verified existing frame-0 raw key: "+ref);skipped.push(ref);continue;}need(t.rawKeyWritable===true,"Changed driven shape requires a verified existing frame-0 raw key: "+ref);}
   assignments.push({target:t,uri:ref,value:value,defaultValue:def,reset:!s});

 function local(v){need(typeof v==="string"&&/^#[^?#]+$/.test(v),"Expected local instance reference");return decodeURIComponent(v.substring(1));}
 function one(rows,id){need(array(rows),"Definition list unavailable");var found=null;for(var i=0;i<rows.length;i++)if(rows[i].id===id){need(!found,"Duplicate definition: "+id);found=rows[i];}need(found,"Missing definition: "+id);return found;}
 function localMorph(d,geometryUri,guard){

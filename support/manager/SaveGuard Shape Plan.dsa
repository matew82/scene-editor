  for(k in deltas)if(own(deltas,k))need(k==="count"||k==="values","Unsupported local delta data");
  for(i=0;i<deltas.values.length;i++){
   if(guard)guard();var row=deltas.values[i];need(array(row)&&row.length===4,"Invalid local morph delta");
   var index=finite(row[0]);need(index>=0&&index<count&&Math.floor(index)===index&&!seen["$"+index],"Invalid or duplicate local morph vertex");
   seen["$"+index]=true;var copy=[index];for(j=1;j<4;j++)copy.push(finite(row[j]));values.push(copy);
  }

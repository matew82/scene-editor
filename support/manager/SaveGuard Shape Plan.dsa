    else{canonical=uri(current);var split=canonical.indexOf("#"),file=canonical.substring(0,split),result=resolve(file);
     need(result&&result.verified===true&&result.document,"Unverified definition "+file);if(files.indexOf(file)<0)files.push(file);
     asset=result.document;record=one(asset[section]||[],canonical.substring(split+1));}
    chain.push({token:token,record:record});current=record.url||null;
    if(current&&current.charAt(0)==="#"&&asset!==doc)current=canonical.substring(0,canonical.indexOf("#"))+current;
   }
   for(j=chain.length-1;j>=0;j--){var next={},r=chain[j].record;for(k in base)if(own(base,k))next[k]=base[k];for(k in r)if(own(r,k)&&k!=="url")next[k]=r[k];
    if(base.channel||r.channel){next.channel={};var oldChannel=base.channel||{},newChannel=r.channel||{};for(k in oldChannel)if(own(oldChannel,k))next.channel[k]=oldChannel[k];for(k in newChannel)if(own(newChannel,k))next.channel[k]=newChannel[k];}
    if(base.presentation||r.presentation){next.presentation={};var bp=base.presentation||{},rp=r.presentation||{};for(k in bp)if(own(bp,k))next.presentation[k]=bp[k];for(k in rp)if(own(rp,k))next.presentation[k]=rp[k];}
    base=next;cache["$"+chain[j].token]=base;
   }return base;
  }return {get:get,files:files,guard:guard};
 }
 function compile(doc,id,resolve,cancelled){
  need(doc&&doc.scene&&array(doc.scene.nodes)&&array(doc.scene.modifiers||[]),"Malformed saved scene");
  var node=one(doc.scene.nodes,id),sourceUri=uri(node.url),defs=definitions(doc,resolve,cancelled),base=defs.get(sourceUri,"node_library");
  need(base.type==="figure"&&(!node.type||node.type==="figure"),"Choose a saved figure or rigged wearable");
  var geometries=node.geometries||base.geometries,owners={},records={},ids={},rows=[],excluded=[],mods=doc.scene.modifiers||[],i,m,ref,d,ch,value;
  need(array(geometries)&&geometries.length===1&&geometries[0].id,"Exactly one saved own geometry is required");
  var geometryUri=uri(geometries[0].url);owners["$"+id]=true;owners["$"+geometries[0].id]=true;
  for(i=0;i<mods.length;i++){
   defs.guard();m=mods[i];if(!m||typeof m.parent!=="string"||m.parent.charAt(0)!=="#")continue;
   if(!owners["$"+local(m.parent)])continue;
   need(typeof m.id==="string"&&m.id&&!ids["$"+m.id],"Duplicate modifier instance");ids["$"+m.id]=true;
   if(!m.url)continue;d=defs.get(m.url,"modifier_library");
   if(!d.presentation||d.presentation.type!=="Modifier/Shape"){excluded.push(m.id);continue;}
   need(!own(m,"formulas")&&!own(m,"morph")&&(!m.extra||array(m.extra)&&m.extra.length===0),"Saved shaping definition overrides require separate support");
   var isLocal=m.url.charAt(0)==="#",localData=isLocal?localMorph(d,geometryUri,defs.guard):null;
   ref=isLocal?"#"+local(m.url):uri(m.url);need(!records["$"+ref],"Duplicate shaping asset instance");
   ch={};var k,definedChannel=d.channel||{},savedChannel=m.channel||{};for(k in definedChannel)if(own(definedChannel,k))ch[k]=definedChannel[k];for(k in savedChannel)if(own(savedChannel,k))ch[k]=savedChannel[k];
   need(ch.type==="float"&&ch.id==="value","Unsupported shaping channel");
   need(!ch.keys&&!ch.keyframes,"Inline animated shaping is unsupported");
   var defaultValue=finite(own(m.channel,"value")?m.channel.value:d.channel.value);
   value=finite(own(m.channel,"current_value")?m.channel.current_value:isLocal&&own(d.channel,"current_value")?d.channel.current_value:defaultValue);
   var row={id:m.id,uri:ref,value:value,defaultValue:defaultValue,definition:d,localMorph:localData,explicit:own(m.channel,"current_value")||isLocal&&own(d.channel,"current_value")};
   records["$"+ref]=row;rows.push(row);
  }

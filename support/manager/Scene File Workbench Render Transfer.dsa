 function prepare(io,paths,rows,direction,guard){guard=guard||function(){};need(selectionEligibility(rows).allowed,selectionEligibility(rows).reason);var a=paths[direction===0?0:1],b=paths[direction===0?1:0];need(String(a).replace(/\\/g,'/').toLowerCase()!==String(b).replace(/\\/g,'/').toLowerCase(),'Source and destination must be different files');var source=new SceneEditorCore.Document(a,io,guard),target=new SceneEditorCore.Document(b,io,guard),ops=[],changes=[],seen={},helperStages={},sourceDisplay=displayIndex(source.data),targetDisplay=displayIndex(target.data);for(var i=0;i<rows.length;i++){guard('Prepare render setting '+(i+1)+' / '+rows.length);var d=rows[i],p=d.path,sv=direction===0?d.valueA:d.valueB,tv=direction===0?d.valueB:d.valueA;var displayKey=JSON.stringify(p),sa=sourceDisplay[displayKey],tb=targetDisplay[displayKey];need(sa&&tb&&!sa.ambiguous&&!tb.ambiguous&&same(sa.value,sv)&&same(tb.value,tv),'Render values changed since comparison; compare again');var from=binding(source.data,p),to=binding(target.data,p);if(from.canvasNames){need(to.canvasNames,'Destination canvases unavailable');var canvasName=from.canvasNames[from.value],canvasIndex=to.canvasNames.indexOf(canvasName);need(canvasIndex>=0,'Destination has no matching active canvas');from.value=canvasIndex;}if(from.direct){need(to.direct===from.direct,'Incompatible canvas settings');canvasValid(from,to,source.data,target.data);}else if(from.dimension){need(from.dimension===to.dimension,'Incompatible render fields');validDimension(from.dimension,from.value);}else{need(to.hits,'Incompatible render property');for(var f=0;f<from.hits.length;f++)validate(from.hits[f].channel,from.canvasNames?value(from.hits[f].channel):from.value);for(var h=0;h<to.hits.length;h++){var sc=from.hits[0].channel,tc=to.hits[h].channel;need(sc.type===tc.type,'Render property types differ');if(sc.type==='enum'&&!from.canvasNames)need(same(sc.enum_values,tc.enum_values),'Enum domains differ');validate(tc,from.value);}}var targ
/* Saved render value transfer. No live Scene API and no asset writes. ES3. */
var SceneEditorRenderTransfer=(function(){
 function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}function list(v){return Object.prototype.toString.call(v)==='[object Array]';}function copy(v){return JSON.parse(JSON.stringify(v));}function need(v,m){if(!v)throw Error('Render transfer: '+m);}function same(a,b){return SceneEditorCore.equal(a,b);}function decode(v){try{return decodeURIComponent(String(v||''));}catch(e){throw Error('Render transfer: invalid URI');}}
 var canvasFields={'Type':'type','Alpha':'has_alpha','Light path expression':'lpe','Node list':'mask','Index':'param_index','Edge color':'param_edge_color','Bias':'param_bias','Scale':'param_scale','Upscale':'param_upscale','Processing disabled':'param_processing_disabled'};
 var dims={'Image size (pixels)':'imageSize','Aspect ratio':'aspect_ratio','Constrain proportions':'isAspectConstrained'};
 function supportsPath(p){if(!list(p)||p.length<2)return false;if(p[0]==='DIMENSIONS')return p.length===2&&own(dims,p[1]);if(p[0]==='QUALITY / SAMPLES'||p[0]==='ENVIRONMENT / HDRI'||p[0]==='TONE MAPPING')return p.length===2&&p[1].indexOf(' / ')<0;if(p[0]==='ADDITIONAL RENDER SETTINGS'){var ci=p.indexOf('Canvases');if(ci>=0)return ci===2&&(p.length===4&&p[3]==='Render to canvases'||p.length===5&&own(canvasFields,p[4]));for(var i=1;i<p.length;i++)if(p[i].indexOf(' / Image')>=0)return false;return p.length>=3;}return false;}
 function reason(d){if(!d||d.kind!=='renderSetting'||!supportsPath(d.path))return 'This render setting depends on images, canvases or scene references and cannot be copied as a value.';if(d.status!=='Changed')return 'Select known changed render values.';return '';}
 function selectionEligibility(rows){if(!rows.length)return{allowed:false,reason:'Select render values to copy.'};for(var i=0;i<rows.length;i++){var why=reason(rows[i]);if(why)return{allowed:false,reason:why};}return{allowed:true,reason:'Copy selected render values. A verified backup is made before saving.'};}
 function block(doc){var ex=doc.scene&&doc.scene.extra||[],found=null;for(var i=0;i<ex.length;i++)if(ex[i].type==='studio_render_settings'){need(found===null,'Ambiguous render settings block');found={value:ex[i].render_options,path:['scene','extra',i,'render_options']};}need(found&&found.value,'Saved render settings unavailable');return found;}

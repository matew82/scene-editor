 function validate(c,v){need(c&&!c.alias&&!c.target_channel&&!c.keys&&!c.animations&&!(c.formulas||[]).length,'Animated or aliased channel is unsupported');need(c.locked!==true,'Destination channel is locked');need(['bool','int','enum','float','color','float_color','string'].indexOf(c.type)>=0,'Unsupported render property type');var t=c.type,i;if(t==='bool')need(typeof v==='boolean','Expected boolean');else if(t==='string')need(typeof v==='string','Expected text');else if(t==='color'||t==='float_color'){need(list(v)&&v.length===3,'Expected RGB color');for(i=0;i<3;i++)need(typeof v[i]==='number'&&isFinite(v[i])&&(t!=='color'||v[i]>=0&&v[i]<=1),'Invalid color');}else{need(typeof v==='number'&&isFinite(v),'Expected finite number');if(t==='int'||t==='enum')need(v===Math.floor(v),'Expected integer');if(t==='enum'){need(list(c.enum_values)&&v>=0&&v<c.enum_values.length,'Enum domain unavailable');}if(c.clamped===true){if(typeof c.min==='number')need(v>=c.min,'Value below destination limit');if(typeof c.max==='number')need(v<=c.max,'Value above destination limit');}}}
 function channel(entries,name){var hits=[];for(var i=0;i<entries.length;i++){var e=entries[i],cs=e.value.channels||[];for(var j=0;j<cs.length;j++)if(cs[j].channel&&cs[j].channel.id===name)hits.push({channel:cs[j].channel,path:e.path.concat(['channels',j,'channel']),owner:e.owner});}need(hits.length,'Saved channel is missing: '+name);for(i=1;i<hits.length;i++)need(same(hits[i].channel,hits[0].channel),'Ambiguous saved channel: '+name);return hits;}
 function elements(ro,names){var entries=[{value:ro.value,path:ro.path}],out;for(var depth=0;depth<names.length;depth++){out=[];for(var i=0;i<entries.length;i++){var field=depth===0?'render_elements':'children',children=entries[i].value[field]||[];for(var j=0;j<children.length;j++)if(children[j].id===names[depth])out.push({value:children[j],path:entries[i].path.concat([field,j])});}need(out.length,'Renderer group unavailable: '+names[depth]);for(i=1;i<out.length;i++)need(same(out[i].value,out[0].value),'Ambiguous renderer group: '+names[depth]);entries=out;}return entries;}

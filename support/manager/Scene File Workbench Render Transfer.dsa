 function helper(doc,kind,name){var nodes=doc.scene&&doc.scene.nodes||[],defs=doc.node_library||[],found=[],i,j;for(i=0;i<nodes.length;i++){var n=nodes[i],def=null;for(j=0;j<defs.length;j++)if('#'+defs[j].id===decode(n.url)){need(!def,'Ambiguous helper definition');def=defs[j];}if((marker(n)||marker(def))===kind)found.push({node:n,index:i,def:def});}need(found.length===1,'A unique existing render helper is required');var h=found[0];need(h.def&&!h.def.source&&!h.def.url,'External helper definitions are unsupported');var anim=doc.scene.animations||[];for(i=0;i<anim.length;i++){var u=decode(anim[i].url),id=u.replace(/^.*#/,'').split(/[?:/]/)[0];need(id!==h.node.id&&id!==h.def.id,'Animated render helpers are unsupported');}need(!(h.node.formulas||[]).length&&!(h.def.formulas||[]).length,'Formula-driven render helpers are unsupported');var ex=h.node.extra||[],hits=[],defaultChannel=null,defaultExtra=null;for(i=0;i<(h.def.extra||[]).length;i++)for(j=0;j<(h.def.extra[i].channels||[]).length;j++){var dc=h.def.extra[i].channels[j].channel;if(dc&&dc.id===name){need(!defaultChannel,'Ambiguous helper default');defaultChannel=dc;defaultExtra=h.def.extra[i].type;}}for(i=0;i<ex.length;i++)for(j=0;j<(ex[i].channels||[]).length;j++){var c=ex[i].channels[j].channel;if(c&&c.id===name){var merged=copy(defaultChannel||{});for(var k in c)if(own(c,k))merged[k]=copy(c[k]);hits.push({channel:merged,path:['scene','nodes',h.index,'extra',i,'channels',j,'channel'],authored:c,owner:h.node.id,helperNodePath:['scene','nodes',h.index],extraType:ex[i].type});}}if(!hits.length&&defaultChannel)hits.push({channel:defaultChannel,owner:h.node.id,helperNodePath:['scene','nodes',h.index],extraType:defaultExtra});need(hits.length===1,'Helper channel is missing or ambiguous');return hits;}
 function canvas(ro,p){var es=elements(ro,['NVIDIA Iray Render Options']);need(es.length===1,'Ambiguous canvas renderer');var ex=es[0].value.extra||[],b=null,bp;for(var i=0;i<ex.length;i++)if(ex[i].type==='studio/element_data/iray_settings'){need(!b,'Ambiguous canvas block');b=ex[i];bp=es[0].path.concat(['extra',i]);}need(b,'Canvas block missing');if(p[3]==='Render to canvases')return{direct:'canvas',value:b.render_to_canvases,path:bp.concat(['render_to_canvases']),field:'render_to_canvases'};var cs=b.canvases||[],found=-1;for(i=0;i<cs.length;i++)if(cs[i].id===p[3]){need(found<0,'Ambiguous canvas identity');found=i;}need(found>=0,'Matching canvas missing');var field=canvasFields[p[4]];need(own(cs[found],field),'Canvas field not authored');return{direct:'canvas',value:cs[found][field],path:bp.concat(['canvases',found,field]),field:field,canvasType:cs[found].type,block:b};}
 function canvasValid(from,to,sd,td){need(from.field===to.field,'Canvas fields differ');var v=from.value,k=from.field;need(typeof v===typeof to.value&&list(v)===list(to.value),'Canvas field types differ');if(k==='mask'){if(v==='')return;var p=['ADDITIONAL RENDER SETTINGS','NVIDIA Iray Render Options','Canvases','Node list '+v];var a=display(sd,p),b=display(td,p);need(a!==null&&a!=='Unknown'&&same(a,b),'Node list membership differs between scenes');return;}if(k==='type'){need(['Beauty','Diffuse','Specular','Glossy','Emission','Environment','Alpha','Depth','Normal','Velocity','LPE','LightPathExpression'].indexOf(v)>=0,'Unsupported canvas type');return;}if(k==='lpe'){need(typeof v==='string'&&v.split(';').length<=2,'Unsupported LPE references');need(v.indexOf('[')<0&&v.indexOf("'")<0&&v.indexOf('"')<0,'Scene-specific LPE labels are unsupported');return;}if(list(v)){need(v.length===to.value.length,'Canvas vector size differs');for(var i=0;i<v.length;i++)need(typeof v[i]==='number'&&isFinite(v[i]),'Invalid canvas vector');}else need(typeof v==='boolean'||typeof v==='number'&&isFinite(v),'Invalid canvas value');if(k==='param_index'||k==='param_upscale')need(v===Math.floor(v)&&v>=0,'Invalid canvas integer');}
 function binding(doc,p){var ro=block(doc);if(p[0]==='ADDITIONAL RENDER SETTINGS'&&p[2]==='Canvases')return canvas(ro,p);if(p[0]==='DIMENSIONS'){var key=dims[p[1]];need(own(ro.value,key),'Dimension value is not recorded');return{dimension:key,value:ro.value[key],path:ro.path.concat([key])};}var hits;if(p[0]==='QUALITY / SAMPLES')hits=channel(elements(ro,['NVIDIA Iray Render Options']),p[1]);else if(p[0]==='ENVIRONMENT / HDRI'||p[0]==='TONE MAPPING')hits=helper(doc,p[0]==='TONE MAPPING'?'tone':'environment',p[1]);else hits=channel(elements(ro,p.slice(1,p.length-1)),p[p.length-1]);var result={hits:hits,value:value(hits[0].channel)};if(p[p.length-1]==='Active Canvas'){var es=elements(ro,['NVIDIA Iray Render Options']);need(es.length===1,'Ambiguous canvas renderer');var ex=es[0].value.extra||[],cb=null;for(var ci=0;ci<ex.length;ci++)if(ex[ci].type==='studio/element_data/iray_settings'){need(!cb,'Ambiguous canvas block');cb=ex[ci];}need(cb&&list(cb.canvases),'Canvas definitions missing');var names=[],seenNames={};for(ci=0;ci<cb.canvases.length;ci++){var name=cb.canvases[ci].id;need(typeof name==='string'&&name&&!seenNames['$'+name],'Ambiguous canvas names');seenNames['$'+name]=true;names.push(name);}result.canvasNames=names;need(result.value===Math.floor(result.value)&&result.value>=0&&result.value<names.length,'Active canvas unavailable');}return result;}
 function display(doc,p){var rows=SaveGuardRenderSettings.rows(SaveGuardRenderSettings.selectSource(doc,true)),level=rows;for(var i=0;i<p.length;i++){var matches=[];for(var j=0;j<level.length;j++)if(level[j].label===p[i])matches.push(level[j]);need(matches.length===1,'Ambiguous comparison row');if(i===p.length-1){need(own(matches[0],'value'),'Select individual values');return matches[0].value;}level=matches[0].children||[];}return null;}
 function displayIndex(doc){var roots=SaveGuardRenderSettings.rows(SaveGuardRenderSettings.selectSource(doc,true)),out={};function walk(rows,path){for(var i=0;i<rows.length;i++){var n=rows[i],p=path.concat([n.label]),key=JSON.stringify(p);if(own(n,'value')){if(own(out,key))out[key]={ambiguous:true};else out[key]={value:n.value};}if(n.children)walk(n.children,p);}}walk(roots,[]);return out;}

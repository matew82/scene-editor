/* Saved scene settings editor. No live Scene mutation; writes only after explicit Save. */
var SceneEditorSavedSettings=(function(){
 function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}function array(v){return Object.prototype.toString.call(v)==='[object Array]';}function clone(v){return JSON.parse(JSON.stringify(v));}function fail(m){throw Error(m);}function get(v,p){for(var i=0;i<p.length;i++)v=v[p[i]];return v;}
 function fields(data){var out=[],extras=data.scene&&data.scene.extra||[],count=0;
  function walk(value,path,label,meta){if(value===null)return;if(typeof value!=='object'){out.push({path:path,label:label,value:value,type:typeof value,meta:meta||{}});return;}if(own(value,'channel')){var c=value.channel;if(c&&typeof c==='object'){var key=own(c,'current_value')?'current_value':own(c,'value')?'value':null;if(key)walk(c[key],path.concat(['channel',key]),String(c.label||c.id||label),c);if(typeof c.image_file==='string')walk(c.image_file,path.concat(['channel','image_file']),String(c.label||c.id||label)+' / image file',{id:String(c.id||label)+' map',type:'file',file_type:'file_open',file_filter:''});}return;}for(var k in value)if(own(value,k)&&k!=='id'&&k!=='type'&&k!=='url')walk(value[k],path.concat([array(value)?Number(k):k]),label?(label+' / '+k):k,meta);}
  for(var i=0;i<extras.length;i++)if(extras[i].type==='studio_render_settings'){count++;walk(extras[i].render_options,['scene','extra',i,'render_options'],'Render');}if(count!==1)fail('A unique saved render settings block is required.');
  var nodes=data.scene&&data.scene.nodes||[];function helper(n){var a=n.extra||[];for(var x=0;x<a.length;x++)if(a[x].type==='studio/node/environment'||a[x].type==='studio/node/tone_mapper')return true;return false;}
  var defs=data.node_library||[],ids={};for(i=0;i<defs.length;i++)if(helper(defs[i])){ids['#'+defs[i].id]=true;walk(defs[i].extra,['node_library',i,'extra'],defs[i].label||defs[i].id);}
  for(i=0;i<nodes.length;i++)if(helper(nodes[i])||ids[nodes[i].url])walk(nodes[i].extra,['scene','nodes',i,'extra'],nodes[i].label||nodes[i].id);return out;
 }

 var viewModels={};
 function cameraId(value){if(typeof value!=='string'||value.charAt(0)!=='#')return null;try{return decodeURIComponent(value.slice(1));}catch(e){return null;}}
 function invalidate(path){var key=String(path).replace(/\\/g,'/').toLowerCase();for(var k in viewModels)if(own(viewModels,k)&&String(viewModels[k].path).replace(/\\/g,'/').toLowerCase()===key)delete viewModels[k];}
 function viewStamp(env,io,path){if(typeof io.cacheStamp!=='function')return null;var canonical=path;if(typeof env.DzFileInfo==='function'){var f=new env.DzFileInfo(path);if(typeof f.canonicalFilePath==='function')canonical=String(f.canonicalFilePath());}if(!canonical)fail('The saved scene path is unavailable.');return{path:canonical,metadata:io.cacheStamp(canonical),profile:'active-view-1'};}
 function cameraChoices(data,objects){var nodes=data.scene&&data.scene.nodes||[],out=[],seen={},counts={},labels={},definitions={},sceneNodes={},i,n;for(i=0;i<(data.node_library||[]).length;i++){n=data.node_library[i];definitions['$'+n.id]=n.type;}for(i=0;i<nodes.length;i++){n=nodes[i];counts['$'+n.id]=(counts['$'+n.id]||0)+1;sceneNodes['$'+n.id]=n;}function add(id,label){if(counts['$'+id]!==1||seen['$'+id])return;seen['$'+id]=true;label=String(sceneNodes['$'+id].label||label||id);labels['$'+label]=(labels['$'+label]||0)+1;out.push({id:id,label:label,value:'#'+encodeURIComponent(id)});}for(i=0;i<objects.length;i++)if(/camera/i.test(objects[i].type))add(objects[i].id,objects[i].label);for(i=0;i<nodes.length;i++){n=nodes[i];if(n.type==='camera'||n.preview&&n.preview.type==='camera'||definitions['$'+cameraId(n.url)]==='camera')add(n.id,n.label);}for(i=0;i<out.length;i++)if(labels['$'+out[i].label]>1)out[i].label+=' ('+out[i].id+')';return out;}
 function plan(doc,changes){var ops=[],expected=clone(doc.data);for(var i=0;i<changes.length;i++){var c=changes[i],before=get(doc.data,c.path);if(before!==undefined&&typeof c.value!==typeof before||typeof c.value==='number'&&!isFinite(c.value))fail('Invalid value type: '+c.path.join(' / '));if(SceneEditorCore.equal(before,c.value))continue;var parent=get(expected,c.path.slice(0,-1));parent[c.path[c.path.length-1]]=c.value;ops.push(before===undefined?{kind:'add',path:c.path.slice(0,-1),key:c.path[c.path.length-1],value:c.value}:{kind:'replace',path:c.path,value:c.value});}var text=doc.patch(ops),parsed=SceneEditorCore.parseDocument(text,doc.guard);if(!SceneEditorCore.equal(expected,parsed))fail('Saved settings patch changed unrelated data.');return{text:text,diff:SceneEditorCore.diff(doc.data,parsed)};}
 var titles={render:'Render Settings','render-size':'Render Size','render-type':'Render Type','render-quality':'Render Quality',frame:'Current Frame',range:'Animation Range',fps:'FPS'};
 function timelineRecord(data){var extra=data.scene&&data.scene.extra||[],found=null;for(var i=0;i<extra.length;i++)if(extra[i].type==='studio_scene_settings'){if(found)fail('A unique saved timeline is required.');found={data:extra[i].animation_settings,path:['scene','extra',i,'animation_settings']};}if(!found||!found.data||typeof found.data.current_frames_per_second!=='number'||!isFinite(found.data.current_frames_per_second)||found.data.current_frames_per_second<=0)fail('A saved timeline with a valid FPS is required.');return found;}
 function scopedFields(data,kind){if(!own(titles,kind))fail('Unknown saved settings group.');if(kind==='frame'||kind==='range'||kind==='fps'){var t=timelineRecord(data),names=kind==='frame'?['current_time']:kind==='fps'?['current_frames_per_second']:['animation_range','play_range'],out=[];for(var i=0;i<names.length;i++){var key=names[i],value=t.data[key];if(value===undefined&&key==='play_range')continue;if(key.indexOf('_range')>=0){if(!array(value)||value.length!==2||typeof value[0]!=='number'||typeof value[1]!=='number'||!isFinite(value[0])||!isFinite(value[1])||value[0]>value[1])fail('Invalid saved timeline range.');for(var j=0;j<2;j++)out.push({path:t.path.concat([key,j]),label:(key==='animation_range'?'Animation':'Playback')+(j?' end frame':' start frame'),value:value[j]*t.data.current_frames_per_second,type:'number',scale:t.data.current_frames_per_second});}else{if(typeof value!=='number'||!isFinite(value))fail('The requested timeline value is not recorded.');out.push({path:t.path.concat([key]),label:kind==='fps'?'Frames per second (saved times stay unchanged)':'Current frame',value:kind==='fps'?value:value*t.data.current_frames_per_second,type:'number',scale:kind==='fps'?1:t.data.current_frames_per_second});}}return out;}
 var all=fields(data);if(kind==='render')return all;var result=[],quality={'Min Samples':true,'Max Samples':true,'Max Time':true,'Rendering Quality':true,'Rendering Quality Enable':true,'Rendering Converged Ratio':true,'Rendering Quality SSIM':true};for(var n=0;n<all.length;n++){var f=all[n],last=f.path[f.path.length-1],isOptions=f.path[0]==='scene'&&f.path[1]==='extra'&&f.path[3]==='render_options',head=f.path[4];if(isOptions&&(kind==='render-size'&&(head==='imageSize'||head==='aspect_ratio'||head==='isAspectConstrained')||kind==='render-type'&&head==='isCurrentFrameRender'||kind==='render-quality'&&f.meta&&quality[f.meta.id])){if(kind==='render-type')f.label='Render current frame only (Still Image)';result.push(f);}}if(!result.length)fail('This settings group is not recorded in the saved scene.');return result;}
 function validateScope(data,kind){if(kind==='render-size'){var dimensions=scopedFields(data,kind);for(var di=0;di<dimensions.length;di++)if((dimensions[di].path[4]==='imageSize'||dimensions[di].path[4]==='aspect_ratio')&&(typeof dimensions[di].value!=='number'||!isFinite(dimensions[di].value)||dimensions[di].value<=0))fail('Image dimensions and aspect ratio must be positive.');}if(kind==='fps'||kind==='frame'||kind==='range'){var t=timelineRecord(data).data;if(kind==='range'){var a=t.animation_range,p=t.play_range;if(!a||a[0]>a[1])fail('Animation start must not exceed end.');if(p&&(p[0]>p[1]||p[0]<a[0]||p[1]>a[1]))fail('Playback range must be ordered and lie within the animation range.');}return;}if(kind==='render-quality'){var list=scopedFields(data,kind),v={};for(var i=0;i<list.length;i++){var f=list[i];v[f.meta.id]=f.value;if(typeof f.value==='number'&&(!isFinite(f.value)||f.value<0))fail('Render quality values must be finite and non-negative.');if(/^(Min Samples|Max Samples|Max Time)$/.test(f.meta.id)&&Math.floor(f.value)!==f.value)fail('Samples and maximum time must be whole numbers.');if(f.meta.id==='Rendering Converged Ratio'&&f.value>1)fail('Converged ratio must be between 0 and 100%.');}if(v['Min Samples']!==undefined&&v['Max Samples']!==undefined&&v['Min Samples']>v['Max Samples'])fail('Minimum samples must not exceed maximum samples.');}}
 function RenderSession(path,io,guard,kind){this.path=path;this.io=io;this.guard=guard;this.kind=kind||'render';this.doc=new SceneEditorCore.Document(path,io,guard);this.rows=[{id:'render:static',label:'Render Settings',type:'render-settings'}];this.timings={mode:'saved-render-settings'};this.editor=null;}
 RenderSession.prototype.select=function(index){if(index!==0)fail('Unknown render settings selection.');if(!this.editor)this.editor=renderModel(this.doc,this.io,this.guard,this.kind);return{editor:this.editor,timings:{mode:'saved-render-settings'},diagnostics:[]};};
 RenderSession.prototype.saved=function(){this.doc=new SceneEditorCore.Document(this.path,this.io,this.guard);this.editor=null;return 0;};
 function renderModel(doc,io,guard,kind){kind=kind||'render';var list=scopedFields(doc.data,kind),seen={},model={doc:doc,io:io,guard:guard,props:{},order:[],pending:{},pendingClamped:{},camera:{id:'render:static',label:titles[kind]},propertySource:{requested:'Saved DUF',effective:'Saved DUF'},definitionRevision:0},i;
  for(i=0;i<list.length;i++){var field=list[i],fieldPath=field.path.slice(0),value=field.value,meta=clone(field.meta||{}),type=field.type==='boolean'?'bool':field.type==='number'?(meta.type==='int'||meta.type==='enum'?meta.type:'float'):meta.type==='file'?'file':'string',label=field.label,container=get(doc.data,fieldPath.slice(0,-1));
   if(!field.scale&&typeof fieldPath[fieldPath.length-1]==='number'&&array(container)&&(container.length===2||container.length===3)){var numeric=true,integer=true;for(var vi=0;vi<container.length;vi++){if(typeof container[vi]!=='number'||!isFinite(container[vi]))numeric=false;if(Math.floor(container[vi])!==container[vi])integer=false;}if(numeric){fieldPath.pop();value=clone(container);type=meta.type==='color'||meta.type==='float_color'?meta.type:container.length===2?(fieldPath[fieldPath.length-1]==='imageSize'&&integer?'int2':'float2'):'float3';label=label.replace(/ \/ [0-9]+$/,'');}}
   var id=JSON.stringify(fieldPath);if(seen[id])continue;seen[id]=true;var groups=[titles[kind]],node=null;if(fieldPath[0]==='node_library')node=doc.data.node_library[fieldPath[1]];else if(fieldPath[0]==='scene'&&fieldPath[1]==='nodes')node=doc.data.scene.nodes[fieldPath[2]];if(node){groups=[node.label||node.name||node.id];var ex=node.extra||[];for(var ei=0;ei<ex.length;ei++){if(ex[ei].type==='studio/node/environment')groups=['Environment'];if(ex[ei].type==='studio/node/tone_mapper')groups=['Tone Mapping'];}}if(typeof meta.group==='string'){var g=meta.group.split('/');for(var gi=0;gi<g.length;gi++)if(g[gi])groups.push(g[gi]);}else if(fieldPath.indexOf('render_elements')>=0)groups.push('Renderer Options');
   var last=fieldPath[fieldPath.length-1],internal=last==='version'||last==='file_version',channelIndex=fieldPath.indexOf('channel'),channelPath=channelIndex>=0?fieldPath.slice(0,channelIndex+1):null;if(internal){meta.locked=true;groups.push('Internal metadata');}if(last==='imageSize')label='Image Size';meta.id=meta.id||String(last);var p={id:id,key:['render',id],groups:groups,label:label,type:type,value:clone(value),meta:meta,layers:[{doc:doc}],companions:[],path:fieldPath,channelPath:channelPath,scale:field.scale||1};if(internal)p.issue='Internal record version; read-only.';model.props[id]=p;model.order.push(id);
  }
  model.set=function(id,value,policy){var p=this.props[id];if(!p)fail('Unknown render property.');if(p.path[p.path.length-1]==='imageSize'){if(!array(value)||value.length!==2||value[0]<=0||value[1]<=0||Math.floor(value[0])!==value[0]||Math.floor(value[1])!==value[1])fail('Image dimensions must be positive whole numbers.');}SceneEditorCore.Editor.prototype.set.call(this,id,value,policy);this._builtPlan=null;};
  model.build=function(){var signature=JSON.stringify([this.pending,this.pendingClamped]);if(this._builtPlan&&this._builtPlan.signature===signature)return this._builtPlan;var changes=[];for(var id in this.pending)if(own(this.pending,id)){var p=this.props[id];SceneEditorCore.validate(p,this.pending[id]);if(p.meta.locked)fail('Read-only render metadata.');changes.push({path:p.path,value:p.scale!==1?this.pending[id]/p.scale:this.pending[id]});if(own(this.pendingClamped,id)&&p.channelPath)changes.push({path:p.channelPath.concat(['clamped']),value:this.pendingClamped[id]});}var result=plan(doc,changes);validateScope(SceneEditorCore.parseDocument(result.text,guard),kind);result.signature=signature;this._builtPlan=result;return result;};
  model.save=function(){var patch=this.build();if(!patch.diff.length)fail('No changes.');doc.verify();var result=io.install(doc,patch.text,guard,function(){doc.verify();});invalidate(doc.path);return{file:doc.path,semanticDiff:patch.diff,assetWrites:false,sourceProtection:result.sourceProtection||'Exact original binary bytes',nativeAcceptance:'Pending user test'};};return model;
 }
 function pendingChoice(env){var answer=2,dlg=new env.DzBasicDialog(),links=[],live=true;dlg.caption='Scene Editor - Unsaved render settings';dlg.getWidget().objectName='SceneEditorRenderPendingDialog';dlg.minWidth=480;dlg.sizeGripEnabled=true;dlg.showAcceptButton(false);dlg.showCancelButton(false);dlg.showHelpButton(false);var label=new env.DzLabel(dlg);label.text='Render settings have pending edits. Save them, discard them, or return to the editor.';label.wordWrap=true;dlg.addWidget(label);var row=new env.DzWidget(dlg),layout=new env.DzHBoxLayout(row);layout.addStretch(1);function add(text,value){var b=new env.DzPushButton(row);b.text=text;b.minHeight=34;b.autoDefault=false;layout.addWidget(b);var fn=function(){if(live){answer=value;dlg.close();}};env.connect(b,'clicked()',fn);links.push([b,fn]);}add('Save',0);add('Discard',1);add('Cancel',2);dlg.addWidget(row);try{dlg.exec();}finally{live=false;for(var i=links.length-1;i>=0;i--)env.disconnect(links[i][0],'clicked()',links[i][1]);}return answer;}
 function showRender(env,root,path,onSaved,preferences,kind){preferences=preferences||{};kind=kind||'render';if(!own(titles,kind))fail('Unknown saved settings group.');return SceneEditorUI.show(env,root,{path:path,objectId:'render:static',settingsManaged:true,dialogTitle:'Scene Editor - '+titles[kind],dialogName:'SceneEditorSavedSettings-'+kind,propertySource:'Saved DUF',propertyView:preferences.propertyView||'Controls',sessionFactory:function(source,io,guard){return new RenderSession(source,io,guard,kind);},confirmPending:function(){return pendingChoice(env);},onSaved:onSaved});}

 function show(env,root,path,kind,objects,onSaved,preferences){if(kind!=='view')return showRender(env,root,path,onSaved,preferences,kind);
  var progress=false,lastPulse=0,saving=false,dlg=null,active=true,links=[],saved=false,io,baseline,model,choices,combo,save,cancel;
  function guard(){if(!progress)return;var now=new Date().getTime();if(now-lastPulse>=250){lastPulse=now;env.processEvents();}if(env.progressIsCancelled()||saving&&dlg&&dlg.getWidget().visible===false){var error=Error('Operation cancelled.');error.code='CANCELLED';throw error;}}
  function work(title,fn){var supported=typeof env.startProgress==='function'&&typeof env.finishProgress==='function'&&typeof env.processEvents==='function'&&typeof env.progressIsCancelled==='function';if(supported){if(env.progressIsActive&&env.progressIsActive())fail('Wait for the active operation.');env.startProgress(title,10000,true,true);progress=true;}try{return fn();}finally{if(progress){progress=false;env.finishProgress();}}}
  io=SceneEditorIO.create(env,guard);baseline=viewStamp(env,io,path);var key=baseline?'$'+baseline.path:null,cached=key&&viewModels[key];
  if(cached&&SceneEditorCore.equal(cached.stamp,baseline))model=cached;
  else model=work('Read saved scene settings',function(){var doc=new SceneEditorCore.Document(path,io,guard);if(!doc.data.scene)fail('The saved scene is unavailable.');var result={path:baseline?baseline.path:path,stamp:baseline,current:doc.data.scene.current_camera,choices:cameraChoices(doc.data,objects||[])};if(baseline){if(!SceneEditorCore.equal(baseline,viewStamp(env,io,path)))fail('The saved scene changed while reading. Reopen Active View.');viewModels[key]=result;}return result;});
  choices=model.choices;var currentId=cameraId(model.current),selectedIndex=-1;for(var ci=0;ci<choices.length;ci++)if(choices[ci].id===currentId)selectedIndex=ci;
  dlg=new env.DzBasicDialog();dlg.caption='Scene Editor - Active View';dlg.getWidget().objectName='SceneEditorActiveViewDialog';dlg.minWidth=650;dlg.minHeight=180;dlg.sizeGripEnabled=true;var font=dlg.font;if(font){font.pointSize=Math.max(12,(Number(font.pointSize)||10)+1);dlg.font=font;}dlg.showAcceptButton(false);dlg.showCancelButton(false);dlg.showHelpButton(false);
  function bind(w,fn,signal){signal=signal||'clicked()';var f=function(){if(active&&!saving)fn();};env.connect(w,signal,f);links.push([w,signal,f]);}function label(text){var w=new env.DzLabel(dlg);w.text=text;w.wordWrap=true;dlg.addWidget(w);return w;}
  label('Changes affect this saved DUF only after Save. Closing or Cancel leaves it unchanged.');if(selectedIndex<0)label(choices.length?'The saved active view is not available. Select a camera.':'No saved cameras are available.');
  combo=new env.DzComboBox(dlg);if(font)combo.font=font;for(ci=0;ci<choices.length;ci++)combo.addItem(choices[ci].label);combo.currentItem=selectedIndex;dlg.addWidget(combo);
  var footer=new env.DzWidget(dlg),bar=new env.DzHBoxLayout(footer);cancel=new env.DzPushButton(footer);save=new env.DzPushButton(footer);cancel.text='Cancel';save.text='Save';cancel.autoDefault=false;save.autoDefault=false;cancel.minHeight=34;save.minHeight=34;bar.addStretch(1);bar.addWidget(cancel);bar.addWidget(save);dlg.addWidget(footer);
  function changed(){var choice=choices[Number(combo.currentItem)];return !!choice&&choice.id!==currentId;}function refresh(){save.enabled=!saving&&changed();}bind(combo,refresh,'activated(int)');refresh();bind(cancel,function(){dlg.close();});
  bind(save,function(){try{if(!changed()){dlg.close();return;}var choice=choices[Number(combo.currentItem)];saving=true;refresh();cancel.enabled=false;var patch;try{work('Save scene settings',function(){if(baseline&&!SceneEditorCore.equal(baseline,viewStamp(env,io,path)))fail('The saved scene changed. Reopen Active View.');var doc=new SceneEditorCore.Document(path,io,guard);if(!doc.data.scene||!SceneEditorCore.equal(doc.data.scene.current_camera,model.current))fail('The saved active view changed. Reopen Active View.');var currentChoices=cameraChoices(doc.data,objects||[]),found=false;for(var i=0;i<currentChoices.length;i++)if(currentChoices[i].id===choice.id)found=true;if(!found)fail('The selected camera is no longer available.');patch=plan(doc,[{path:['scene','current_camera'],value:choice.value}]);if(!patch.diff.length)return;doc.verify();io.install(doc,patch.text,guard,function(){doc.verify();});invalidate(model.path);});}finally{saving=false;refresh();cancel.enabled=true;}if(patch&&patch.diff.length){saved=true;if(onSaved)onSaved({semanticDiff:patch.diff},path);}dlg.close();}catch(error){invalidate(model.path);env.MessageBox.warning(String(error.message||error),'Scene Editor','OK');}});
  try{dlg.exec();}finally{active=false;for(var l=links.length-1;l>=0;l--)env.disconnect(links[l][0],links[l][1],links[l][2]);}return saved;
 }

 return{invalidate:invalidate,scopedFields:scopedFields,validateScope:validateScope,titles:titles,RenderSession:RenderSession,renderModel:renderModel,pendingChoice:pendingChoice,fields:fields,cameraChoices:cameraChoices,plan:plan,show:show};
}());

var SaveGuardCameraManager=(function(){
 function create(env,root){var resolver=null,activeOptions=null,currentOptions=null,cache=null,source=null,sourcePath='',busy=false,closed=false,blocked=false;
  function need(v,m){if(!v)throw Error(m);}
  function host(){need(SaveGuardNativeRuntime.hostSupported(env),'Camera host build or required native APIs unavailable');}
   function cancelled(){var callback=activeOptions&&activeOptions.isCancelled||currentOptions&&currentOptions.isCancelled;return typeof callback==='function'&&callback()===true;}
   function check(){if(cancelled()){var e=Error('Camera preparation cancelled');e.code='CANCELLED';throw e;}}
   function dependencies(){check();if(!resolver)resolver=SaveGuardAssetResolver.create(env,{sourceDocumentPath:currentOptions&&currentOptions.version&&currentOptions.version.manifest.source||sourcePath,lowMemoryMode:false,deepValidation:false,reader:SaveGuardNativeSource,isCancelled:cancelled});return resolver;}
   var planningOptions={isCancelled:cancelled,resolveAssetDocument:function(file){return dependencies().resolveAssetDocument(file);},resolveExternal:function(file,info){return dependencies().resolveExternal(file,info);}};
  function open(path,cacheOptions){host();need(!busy&&!closed&&!blocked,'Camera manager unavailable');currentOptions=cacheOptions||null;busy=true;try{if(source)source.provider.close();if(cache)cache.close();cache=null;source=null;if(resolver){resolver.close();resolver=null;}sourcePath=String(path);var hit=null,id=cacheOptions&&cacheOptions.request.sourceId;planningOptions.sourceId=id;if(cacheOptions&&typeof SaveGuardLoadCache!=="undefined")try{cache=SaveGuardLoadCache.create(cacheOptions.version,cacheOptions.request,cacheOptions.mode,cacheOptions.deep,null,planningOptions);hit=cache?cache.find():null;}catch(cacheError){if(cacheError.code==='CANCELLED')throw cacheError;cache=null;}
   var s;if(hit){var projected=SaveGuardCameraSourceProjection.project(hit.document,check,planningOptions);s={stats:{loadCacheHit:true},provider:{listCameras:function(){return JSON.parse(JSON.stringify(projected.rows));},selectCamera:function(selectedId){need(hit.verify()===true,'Camera cache changed');return SaveGuardCameraSourceProjection.select(projected,selectedId,check,planningOptions);},verifySource:hit.verify,close:function(){projected=null;}}};}else{s=SaveGuardCameraSource.read(path,{lowMemoryMode:false,deepValidation:false,isCancelled:cancelled,resolveAssetDocument:planningOptions.resolveAssetDocument,sourceId:id});if(s.error){var sourceError=Error(s.error.message);sourceError.code=s.error.code;throw sourceError;}if(cache)try{var template=s.provider.selectCamera(id);need(s.provider.verifySource()===true,'Saved camera changed before cache publication');cache.publish({document:template,summary:{ready:true},idMap:{},dependencies:[],omittedCollisionTargets:[]},null);}catch(publicationError){if(publicationError.code==='CANCELLED')throw publicationError;}}
   source=s;sourcePath=String(path);return {cameras:source.provider.listCameras(),stats:source.stats};}catch(openError){if(resolver)try{resolver.close();}catch(openCloseError){openError.dependencyCleanupError=String(openCloseError);}resolver=null;throw openError;}finally{busy=false;}}

  function apply(id,mode,force,actionOptions){host();need(!busy&&!closed&&!blocked&&source,'Choose a saved copy first');need(mode==='add'||mode==='replace','Unknown camera action');busy=true;activeOptions=actionOptions||null;var folder=null,report={candidate:'manual-camera-manager-v1',revision:'camera-manager-v1',build:String(env.App.longVersionString),sourcePath:sourcePath,sourceId:id,mode:mode,forcedRollback:force===true,deepValidation:false,nativeManagerWorkflowVerified:false},start=new Date().getTime();
   try{check();need(source.provider.verifySource()===true,'Saved copy changed');var doc=source.provider.selectCamera(id);folder=SaveGuardStorage.reserve(root,'run');var namespace='SGManagerCamera_'+String(new env.DzFileInfo(folder).fileName()).replace(/[^A-Za-z0-9_]/g,'_'),plan=(planningOptions.namespace=namespace,SaveGuardCameraPlan.extract(doc,id,planningOptions));report.savedLabel=plan.label;report.sourceStats=source.stats;var serialized=JSON.stringify(plan.document);var staged=SaveGuardStorage.writeJSONNew(folder,'payload.json',plan.document),payload=folder+'/payload.duf';need(!new env.DzFileInfo(payload).exists()&&new env.DzFile(staged).rename(payload),'Cannot publish camera payload');function verify(){check();return source.provider.verifySource()===true&&JSON.stringify(SaveGuardStorage.readJSON(payload,Number(new env.DzFileInfo(payload).size())))===serialized&&JSON.stringify(plan.document)===serialized&&(!resolver||resolver.verifyAll()===true);}need(verify(),'Selected payload changed');report.payload=payload;report.result=SaveGuardCameraRestore.run(env,plan,payload,mode,force,verify);if(report.result.status==='recovery-required')blocked=true;
   }catch(e){report.error=String(e);if(e&&e.code==='CANCELLED')report.cancelled=true;}finally{if(resolver)try{resolver.close();}catch(resolverCloseError){report.dependencyCleanupError=String(resolverCloseError);}resolver=null;activeOptions=null;report.milliseconds=new Date().getTime()-start;try{if(!folder)folder=SaveGuardStorage.reserve(root,'run');report.evidence=folder;SaveGuardStorage.writeJSONNew(folder,'result.json',report);}catch(evidenceError){report.evidenceError=String(evidenceError);}busy=false;}return report;
  }
  return {open:open,apply:apply,isBlocked:function(){return blocked;},close:function(){closed=true;try{if(source)source.provider.close();if(cache)cache.close();}finally{try{if(resolver)resolver.close();}finally{resolver=null;cache=null;source=null;currentOptions=null;activeOptions=null;}}}};
 }
 return {create:create};
}());

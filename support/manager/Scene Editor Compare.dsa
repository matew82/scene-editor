  function refreshSummary(){var summary=comparisonSummary(baseRows,details,rows);comparedPairs=summary.compared;comparisonType.text=summary.typeText;differenceSummary.text="Found <font color='#e7cf88'><b>"+summary.differences+"</b></font>"+(summary.differences===1?' difference':' differences');differenceSummary.toolTip=summary.unresolved?summary.unresolved+' unresolved entries are shown as Unknown.':'';status.toolTip=parameterNotice;}
  function showWorkProgress(message){var match=typeof message==='string'?/^Compare [Pp]arameters ([0-9]+) \/ ([0-9]+)$/.exec(message):null;if(!match)return;var done=Number(match[1]);if(Number(match[2])!==workTotal||done<workCompleted||done>workTotal)return;if(done===workCompleted)return;workCompleted=done;status.text='Compare Parameters '+done+' / '+workTotal;var filled=workTotal?Math.floor(done*20/workTotal):0,meter='';for(var mi=0;mi<20;mi++)meter+=mi<filled?'\u25a0':'\u25a1';progressMeter.text=meter+' '+Math.floor(done*100/workTotal)+'%';progressMeter.visible=true;}

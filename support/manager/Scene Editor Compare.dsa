  function queueSelection(){if(!alive||painting||parameterBusy||selectionSync||updatingControls||invalid||!prepared)return;selectionPending=true;selectionTimer.stop();selectionTimer.start(1);}
  function readSelection(){if(!alive)return;selectionTimer.stop();selectionPending=false;if(!alive||widget.visible===false||painting||parameterBusy||selectionSync||updatingControls||invalid||!prepared)return;selectionSync=true;trace('selection-sync-begin');try{var serial=generation;for(var i=0;i<visible.length;i++){var r=visible[i];if(!r.eligible)continue;var item=itemByKey['$'+r.key];if(!item)continue;if(!alive||generation!==serial||painting||parameterBusy)return;var chosen=tree.isSelected(item),key='$'+r.pairKey;if(chosen)selectedPairs[key]=true;else delete selectedPairs[key];}selectionState();trace('selection-sync-complete');}catch(e){if(alive&&widget.visible!==false){invalidate();status.text=String(e.message||e);if(typeof callbacks.onError==='function')callbacks.onError(e,{stage:'compare-selection',action:'compareScenes'});}}finally{selectionSync=false;}}
  function selectPairs(value){if(!alive||painting||parameterBusy||invalid||!prepared)return;selectionTimer.stop();selectionPending=false;trace('select-all-begin',value?'select':'deselect');painting=true;try{tree.clearSelection();selectedPairs={};for(var i=0;i<baseRows.length;i++)if(baseRows[i].eligible){var r=baseRows[i];if(value)selectedPairs['$'+r.pairKey]=true;else delete selectedPairs['$'+r.pairKey];var item=itemByKey['$'+r.key];if(item)tree.setSelected(item,value);}}finally{painting=false;}selectionState();trace('select-all-complete',value?'select':'deselect');}
  function runParameters(){if(!alive||painting||parameterBusy||invalid||!prepared)return;if(selectionPending)readSelection();var pairs=[];for(var i=0;i<baseRows.length;i++){var r=baseRows[i];if(r.eligible&&selectedPairs['$'+r.pairKey])pairs.push({key:r.key,aId:r.aId,bId:r.bId});}if(!pairs.length)return;timer.stop();selectionTimer.stop();selectionPending=false;trace('parameters-begin',String(pairs.length));parameterBusy=true;parameterCancelled=false;parameterFailed=false;workTotal=pairs.length;workCompleted=-1;status.wordWrap=false;status.text='Extract parameter records';progressMeter.visible=false;cancelParameters.visible=true;filter.enabled=false;enableExpansion(false);removeA.enabled=false;removeB.enabled=false;selectionState();var completed=false;try{if(!fresh()){invalidate();return;}if(!host.parameterComparison)host.parameterComparison=SceneEditorParameterCompare.create(SceneEditorParameterCompare.nativeAdapter(env));var result=host.parameterComparison.compare(paths,pairs,function(message){if(parameterCancelled||!alive||widget.visible===false){if(widget.visible===false)alive=false;var e=Error('Parameter comparison cancelled');e.code='CANCELLED';throw e;}showWorkProgress(message);guard();});if(!fresh()){invalidate();return;}trace('parameters-model-complete',String(pairs.length));if(parameterRevision!==result.revision)details={};parameterRevision=result.revision;for(i=0;i<pairs.length;i++){details[pairs[i].key]=result.details[pairs[i].key];for(var bi=0;bi<baseRows.length;bi++)if(baseRows[bi].key===pairs[i].key){baseRows[bi].instanceA=!!(result.instances&&result.instances[pairs[i].key]&&result.instances[pairs[i].key].a);baseRows[bi].instanceB=!!(result.instances&&result.instances[pairs[i].key]&&result.instances[pairs[i].key].b);}}rows=parameterRows(baseRows,details);differenceOpen=differenceBranches(rows);parameterNotice='';refreshSummary();completed=true;}catch(e){if(e.code==='CANCELLED'||!alive){parameterNotice='Parameter comparison cancelled. Previous completed 
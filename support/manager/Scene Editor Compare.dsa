  function rebuild(){if(!alive||painting||parameterBusy||invalid||!prepared)return;timer.stop();selectionTimer.stop();selectionPending=false;painting=true;try{generation++;items=[];itemByKey={};lastSibling={};trace('tree-clear-begin');tree.clear();trace('tree-clear-complete');chooseRows();}finally{painting=false;}timer.start(1);}
  function removeSource(index){if(!alive)return;removePath=paths[index];alive=false;selectionTimer.stop();selectionPending=false;timer.stop();dlg.close();}try{bind(removeA,'clicked()',function(){removeSource(0);});bind(removeB,'clicked()',function(){removeSource(1);});
  bind(selectAll,'clicked()',function(){selectPairs(true);});bind(deselectAll,'clicked()',function(){selectPairs(false);});bind(compareSelected,'clicked()',runParameters);bind(cancelParameters,'clicked()',function(){parameterCancelled=true;});bind(tree,'selectionChanged()',queueSelection);bind(selectionTimer,'timeout()',readSelection);bind(expandAll,'clicked()',function(){applyExpansion('all');});bind(collapseAll,'clicked()',function(){applyExpansion('none');});bind(expandDifferences,'clicked()',function(){applyExpansion('differences');});bind(timer,'timeout()',tick);bind(filter,'clicked()',rebuild);bind(close,'clicked()',function(){alive=false;selectionTimer.stop();selectionPending=false;timer.stop();dlg.close();});timer.start(1);stage='compare-dialog-exec';dlg.exec();}catch(e){try{e.stage=stage;}catch(ignoreStage){}throw e;}finally{alive=false;generation++;selectionTimer.stop();selectionPending=false;items=[];itemByKey={};lastSibling={};timer.stop();for(var i=links.length-1;i>=0;i--)try{env.disconnect(links[i][0],links[i][1],links[i][2]);}catch(ignore){}items=[];}return{rows:rows,removePath:removePath};

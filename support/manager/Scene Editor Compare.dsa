  function fresh(){for(var i=0;i<snapshots.length;i++)if(snapshots[i].ok){try{if(canonical(host.signature(paths[i]))!==canonical(snapshots[i].signature))return false;}catch(e){return false;}}return true;}
  function enableExpansion(value){for(var i=0;i<expansionControls.length;i++)expansionControls[i].enabled=value;}function expanded(key){return expansionMode==='all'||expansionMode==='differences'&&!!differenceOpen['$'+key];}function applyExpansion(mode){if(!alive||painting||parameterBusy||invalid||!prepared)return;painting=true;try{expansionMode=mode;for(var i=0;i<visible.length;i++){var item=itemByKey['$'+visible[i].key];if(item)item.open=expanded(visible[i].key);}}catch(e){invalidate();status.text=String(e.message||e);if(typeof callbacks.onError==='function')callbacks.onError(e,{stage:'compare-tree-expansion',action:'compareScenes'});}finally{painting=false;}}

/* Full-scene selected-file operations through documented DzContentMgr.openFile.
 * No custom scene clearing or selective extraction. Native Save Changes is retained.
 */
var SceneEditorSceneActions=(function(){
 function create(env,options){env=env||{};options=options||{};var busy=false,closed=false;
  function manager(){if(!env.App||typeof env.App.getContentMgr!=='function')throw Error('DAZ Content Manager is unavailable');var value=env.App.getContentMgr();if(!value||typeof value.openFile!=='function')throw Error('DzContentMgr.openFile is unavailable');return value;}
  function info(kind){var reason='',available=true;try{manager();if(kind==='load'&&(!env.Scene||typeof env.Scene.needsSave!=='function'||!env.MainWindow||typeof env.MainWindow.askSaveChanges!=='function'))throw Error('Native unsaved-scene protection is unavailable');}catch(e){reason=String(e.message||e);available=false;}return{enabled:available&&!busy&&!closed,available:available,reason:closed?'Scene Editor is closing':busy?'Another scene operation is active':reason,method:'DzContentMgr.openFile',merge:kind==='merge'};}
  function capabilities(){return{load:info('load'),merge:info('merge'),method:'DzContentMgr.openFile',standardActionsOnly:false};}
  function idle(){if(env.Scene&&((typeof env.Scene.isLoading==='function'&&env.Scene.isLoading())||(typeof env.Scene.isClearing==='function'&&env.Scene.isClearing())))throw Error('DAZ is already changing the current scene');var io=env.App&&typeof env.App.getAssetIOMgr==='function'?env.App.getAssetIOMgr():null;if(io&&typeof io.isReadingOrWriting==='function'&&io.isReadingOrWriting())throw Error('DAZ file I/O is already active');}
  function execute(kind,path){var receipt={success:false,performed:false,cancelled:false,scenePath:typeof path==='string'?path:'',kind:kind,actionKey:kind==='load'?'loadScene':'mergeScene',nativeExecuted:false,historyRecorded:false},cap=info(kind),io,result,dirty,file;
   if(!cap.enabled){receipt.blocked=true;receipt.error={code:'SCENE_OPERATION_UNAVAILABLE',message:cap.reason};return receipt;}
   busy=true;try{
    if(!receipt.scenePath||!/\.duf$/i.test(receipt.scenePath))throw Error('Select an existing DUF scene');
    if(typeof env.DzFileInfo!=='function')throw Error('Scene file validation is unavailable');file=new env.DzFileInfo(receipt.scenePath);if(!file.exists()||!file.isFile())throw Error('Selected scene file does not exist');
    idle();
    if(kind==='load'){
     dirty=env.Scene.needsSave();if(typeof dirty!=='boolean')throw Error('Cannot determine whether the current scene has unsaved changes');
     if(dirty){result=env.MainWindow.askSaveChanges();if(result===false){receipt.cancelled=true;receipt.outcome='cancelled-before-load';receipt.message='Load Scene cancelled; the selected DUF was not opened.';return receipt;}if(result!==true)throw Error('Native Save Changes returned an unknown result');}
    }
    if(closed){receipt.cancelled=true;receipt.outcome='closed-before-load';return receipt;}
    idle();file=new env.DzFileInfo(receipt.scenePath);if(!file.exists()||!file.isFile())throw Error('Selected scene disappeared before loading');
    receipt.nativeExecuted=true;result=manager().openFile(receipt.scenePath,kind==='merge');
    if(result===true){receipt.success=true;receipt.performed=true;receipt.outcome='loaded';if(typeof options.onSuccess==='function')try{receipt.historyRecorded=options.onSuccess(receipt)===true;}catch(historyError){receipt.historyWarning='Scene operation completed, but recent-folder metadata failed: '+String(historyError.message||historyError);}}
    else if(result===false){receipt.outcome='not-loaded';receipt.message='DAZ did not complete the scene operation (cancelled or failed). Recent folders were not changed.';}
    else{receipt.outcome='unknown';receipt.error={code:'SCENE_OPERATION_RESULT_UNKNOWN',message:'DzContentMgr.openFile returned no documented Boolean result; success was not recorded'};}
    return receipt;
   }catch(e){receipt.error={code:'SCENE_OPERATION_FAILED',message:String(e.message||e)};receipt.outcome='error';return receipt;}finally{busy=false;}
  }
  return{capabilities:capabilities,load:function(path){return execute('load',path);},merge:function(path){return execute('merge',path);},isBusy:function(){return busy;},close:function(){closed=true;}};
 }
 function nativeEnvironment(){return{App:typeof App==='undefined'?null:App,Scene:typeof Scene==='undefined'?null:Scene,MainWindow:typeof MainWindow==='undefined'?null:MainWindow,DzFileInfo:typeof DzFileInfo==='undefined'?null:DzFileInfo};}
 return{create:create,nativeEnvironment:nativeEnvironment};
}());

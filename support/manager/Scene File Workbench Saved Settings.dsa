 function RenderSession(path,io,guard,kind,projection){this.path=path;this.io=io;this.guard=guard;this.kind=kind||'render';this.doc=null;if(projection)try{scopedFields(projection,this.kind);this.doc={path:path,data:clone(projection),guard:guard,settingsProjection:true};}catch(unavailable){}if(!this.doc)this.doc=new SceneEditorCore.Document(path,io,guard);this.rows=[{id:'render:static',label:'Render Settings',type:'render-settings'}];this.timings={mode:'saved-render-settings'};this.editor=null;}

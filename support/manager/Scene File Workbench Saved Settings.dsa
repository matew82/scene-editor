 function plan(doc,changes){var ops=[],expected=clone(doc.data);for(var i=0;i<changes.length;i++){var c=changes[i],before=get(doc.data,c.path);if(before!==undefined&&typeof c.value!==typeof before||typeof c.value==='number'&&!isFinite(c.value))fail('Invalid value type: '+c.path.join(' / '));if(SceneEditorCore.equal(before,c.value))continue;var parent=get(expected,c.path.slice(0,-1));parent[c.path[c.path.length-1]]=c.value;ops.push(before===undefined?{kind:'add',path:c.path.slice(0,-1),key:c.path[c.path.length-1],value:c.value}:{kind:'replace',path:c.path,value:c.value});}var text=doc.patch(ops),parsed=SceneEditorCore.parseDocument(text,doc.guard);if(!SceneEditorCore.equal(expected,parsed))fail('Saved settings patch changed unrelated data.');return{text:text,diff:SceneEditorCore.diff(doc.data,parsed)};}
 // Compact settings only touch scene.extra. Validate and diff that subtree with the
 // existing token writer, then splice it back without cloning/parsing unrelated assets.
 function planCompact(doc,changes,kind){

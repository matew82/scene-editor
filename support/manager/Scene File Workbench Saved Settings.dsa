 function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}function array(v){return Object.prototype.toString.call(v)==='[object Array]';}function clone(v){return JSON.parse(JSON.stringify(v));}function fail(m){throw Error(m);}function get(v,p){for(var i=0;i<p.length;i++)v=v[p[i]];return v;}

  model.build=function(){var signature=JSON.stringify([this.pending,this.pendingClamped]);if(this._builtPlan&&this._builtPlan.signature===signature)return this._builtPlan;if(doc.settingsProjection){doc=new SceneEditorCore.Document(doc.path,io,guard);this.doc=doc;}var changes=[];for(var id in this.pending)if(own(this.pending,id)){var p=this.props[id];SceneEditorCore.validate(p,this.pending[id]);if(p.meta.locked)fail('Read-only render metadata.');changes.push({path:p.path,value:p.scale!==1?this.pending[id]/p.scale:this.pending[id]});if(own(this.pendingClamped,id)&&p.channelPath)changes.push({path:p.channelPath.concat(['clamped']),value:this.pendingClamped[id]});}var result;if(kind==='render'){result=plan(doc,changes);validateScope(SceneEditorCore.parseDocument(result.text,guard),kind);}else result=planCompact(doc,changes,kind);result.signature=signature;this._builtPlan=result;return result;};

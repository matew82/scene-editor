 var viewModels={};
 function cameraId(value){if(typeof value!=='string'||value.charAt(0)!=='#')return null;try{return decodeURIComponent(value.slice(1));}catch(e){return null;}}
 function invalidate(path){var key=String(path).replace(/\\/g,'/').toLowerCase();for(var k in viewModels)if(own(viewModels,k)&&String(viewModels[k].path).replace(/\\/g,'/').toLowerCase()===key)delete viewModels[k];}

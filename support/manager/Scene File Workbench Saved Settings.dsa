  model.save=function(){var patch=this.build();if(!patch.diff.length)fail('No changes.');var result=io.install(doc,patch.text,guard,function(){doc.verify();});invalidate(doc.path);return{file:doc.path,semanticDiff:patch.diff,assetWrites:false,sourceProtection:result.sourceProtection||'Exact original binary bytes',nativeAcceptance:'Pending user test'};};return model;
 }
 function pendingChoice(env){var answer=2,dlg=new env.DzBasicDialog(),links=[],live=true;dlg.caption='Scene File Workbench - Unsaved render settings';dlg.getWidget().objectName='SceneEditorRenderPendingDialog';dlg.minWidth=480;dlg.sizeGripEnabled=true;dlg.showAcceptButton(false);dlg.showCancelButton(false);dlg.showHelpButton(false);var label=new env.DzLabel(dlg);label.text='Render settings have pending edits. Save them, discard them, or return to the editor.';label.wordWrap=true;dlg.addWidget(label);var row=new env.DzWidget(dlg),layout=new env.DzHBoxLayout(row);layout.addStretch(1);function add(text,value){var b=new env.DzPushButton(row);b.text=text;b.minHeight=34;b.autoDefault=false;layout.addWidget(b);var fn=function(){if(live){answer=value;dlg.close();}};env.connect(b,'clicked()',fn);links.push([b,fn]);}add('Save',0);add('Discard',1);add('Cancel',2);dlg.addWidget(row);try{dlg.exec();}finally{live=false;for(var i=links.length-1;i>=0;i--)env.disconnect(links[i][0],'clicked()',links[i][1]);}return answer;}
 function activeViewportSize(env){try{var manager=env.MainWindow&&env.MainWindow.getViewportMgr(),viewport=manager&&manager.getActiveViewport(),view=viewport&&viewport.get3DViewport(),size=view&&view.currentDimensions(),w=size&&size.width,h=size&&size.height;if(typeof w!=='number'||typeof h!=='number'||!isFinite(w)||!isFinite(h)||w<1||h<1||w>2147483647||h>2147483647||Math.floor(w)!==w||Math.floor(h)!==h)fail('Active viewport size is unavailable.');return[w,h];}catch(viewportError){fail('Active viewport size is unavailable: '+String(viewportError.message||viewportError));}}
 function showRender(env,root,path,onSaved,preferences,kind,projection){preferences=preferences||{};kind=kind||'render';if(!own(titles,kind))fail('Unknown saved settings group.');return SceneEditorUI.show(env,root,{path:path,objectId:'render:static',settingsManaged:true,fitContent:true,hidePropertyFilters:kind!=='render',compactSettingsActions:kind!=='render',renderTypeChoice:kind==='render-type',renderSizePresetChoice:kind==='render-size',getViewportSize:function(){return activeViewportSize(env);},dialogTitle:'Scene File Workbench - '+titles[kind],dialogName:'SceneEditorSavedSettings-'+kind,propertySource:'Saved DUF',propertyView:preferences.propertyView||'Controls',sessionFactory:function(source,io,guard){return new RenderSession(source,io,guard,kind,projection);},confirmPending:function(){return pendingChoice(env);},onSaved:onSaved});}

 function show(env,root,path,kind,objects,onSaved,preferences,projection){if(kind!=='view')return showRender(env,root,path,onSaved,preferences,kind,projection);
  var progress=false,lastPulse=0,saving=false,dlg=null,active=true,links=[],saved=false,io,baseline,model,choices,combo,save,cancel;
  function guard(){if(!progress)return;var now=new Date().getTime();if(now-lastPulse>=250){lastPulse=now;env.processEvents();}if(env.progressIsCancelled()||saving&&dlg&&dlg.getWidget().visible===false){var error=Error('Operation cancelled.');error.code='CANCELLED';throw error;}}
  function work(title,fn){var supported=typeof env.startProgress==='function'&&typeof env.finishProgress==='function'&&typeof env.processEvents==='function'&&typeof env.progressIsCancelled==='function';if(supported){if(env.progressIsActive&&env.progressIsActive())fail('Wait for the active operation.');env.startProgress(title,10000,true,true);progress=true;}try{return fn();}finally{if(progress){progress=false;env.finishProgress();}}}
  io=SceneEditorIO.create(env,guard);baseline=viewStamp(env,io,path);var key=baseline?'$'+baseline.path:null,cached=key&&viewModels[key];
  if(projection&&projection.scene&&projection.scene.nodes&&projection.node_library)model={path:baseline?baseline.path:path,stamp:baseline,current:projection.scene.current_camera,choices:cameraChoices(projection,objects||[])};
  else if(cached&&SceneEditorCore.equal(cached.stamp,baseline))model=cached;
  else model=work('Read saved scene settings',function(){var doc=new SceneEditorCore.Document(path,io,guard);if(!doc.data.scene)fail('The saved scene is unavailable.');var result={path:baseline?baseline.path:path,stamp:baseline,current:doc.data.scene.current_camera,choices:cameraChoices(doc.data,objects||[])};if(baseline){if(!SceneEditorCore.equal(baseline,viewStamp(env,io,path)))fail('The saved scene changed while reading. Reopen Active View.');viewModels[key]=result;}return result;});
  choices=model.choices;var currentId=cameraId(model.current),selectedIndex=-1;for(var ci=0;ci<choices.length;ci++)if(choices[ci].id===currentId)selectedIndex=ci;
  dlg=new env.DzBasicDialog();dlg.caption='Scene File Workbench - Active View';dlg.getWidget().objectName='SceneEditorActiveViewDialog';dlg.minWidth=650;dlg.minHeight=180;dlg.sizeGripEnabled=true;var font=dlg.font;if(font){font.pointSize=Math.max(12,(Number(font.pointSize)||10)+1);dlg.font=font;}dlg.showAcceptButton(false);dlg.showCancelButton(false);dlg.showHelpButton(false);
  function bind(w,fn,signal){signal=signal||'clicked()';var f=function(){if(active&&!saving)fn();};env.connect(w,signal,f);links.push([w,signal,f]);}function label(text){var w=new env.DzLabel(dlg);w.text=text;w.wordWrap=true;dlg.addWidget(w);return w;}
  label('Changes affect this saved DUF only after Save. Closing or Cancel leaves it unchanged.');if(selectedIndex<0)label(choices.length?'The saved active view is not available. Select a camera.':'No saved cameras are available.');
  combo=new env.DzComboBox(dlg);if(font)combo.font=font;for(ci=0;ci<choices.length;ci++)combo.addItem(choices[ci].label);combo.currentItem=selectedIndex;dlg.addWidget(combo);
  var footer=new env.DzWidget(dlg),bar=new env.DzHBoxLayout(footer);cancel=new env.DzPushButton(footer);save=new env.DzPushButton(footer);cancel.text='Cancel';save.text='Save';save.getWidget().styleSheet='QPushButton { background-color: #3f704d; color: white; border: 1px solid #64876b; border-radius: 4px; padding: 6px 14px; } QPushButton:hover:enabled { background-color: #4b815b; } QPushButton:pressed:enabled { background-color: #31583c; } QPushButton:disabled { background-color: #37383c; color: #929397; border-color: #515256; }';cancel.autoDefault=false;save.autoDefault=false;cancel.minHeight=34;save.minHeight=34;bar.addStretch(1);bar.addWidget(cancel);bar.addWidget(save);dlg.addWidget(footer);
  function changed(){var choice=choices[Number(combo.currentItem)];return !!choice&&choice.id!==currentId;}function refresh(){save.enabled=!saving&&changed();}bind(combo,refresh,'activated(int)');refresh();bind(cancel,function(){dlg.close();});
  bind(save,function(){try{if(!changed()){dlg.close();return;}var choice=choices[Number(combo.currentItem)];saving=true;refresh();cancel.enabled=false;var patch;try{work('Save scene settings',function(){var doc=new SceneEditorCore.Document(path,io,guard);if(!doc.data.scene||!SceneEditorCore.equal(doc.data.scene.current_camera,model.current))fail('The saved active view changed. Reopen Active View.');var currentChoices=cameraChoices(doc.data,objects||[]),found=false;for(var i=0;i<currentChoices.length;i++)if(currentChoices[i].id===choice.id)found=true;if(!found)fail('The selected camera is no longer available.');patch=planActiveView(doc,choice.value);if(!patch.diff.length)return;io.install(doc,patch.text,guard,function(){doc.verify();});invalidate(model.path);});}finally{saving=false;refresh();cancel.enabled=true;}if(patch&&patch.diff.length){saved=true;if(onSaved)onSaved({semanticDiff:patch.diff},path);}dlg.close();}catch(error){invalidate(model.path);env.MessageBox.warning(String(error.message||error),'Scene File Workbench','OK');}});
  try{dlg.exec();}finally{active=false;for(var l=links.length-1;l>=0;l--)env.disconnect(links[l][0],links[l][1],links[l][2]);}return saved;
 }

 return{activeViewportSize:activeViewportSize,invalidate:invalidate,scopedFields:scopedFields,validateScope:validateScope,titles:titles,RenderSession:RenderSession,renderModel:renderModel,pendingChoice:pendingChoice,fields:fields,cameraChoices:cameraChoices,plan:plan,planCompact:planCompact,planActiveView:planActiveView,show:show};

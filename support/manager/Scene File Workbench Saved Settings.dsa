 var all=fields(data);if(kind==='render')return all;var result=[],quality={'Min Samples':true,'Max Samples':true,'Max Time':true,'Rendering Quality':true,'Rendering Quality Enable':true,'Rendering Converged Ratio':true,'Rendering Quality SSIM':true};for(var n=0;n<all.length;n++){var f=all[n],last=f.path[f.path.length-1],isOptions=f.path[0]==='scene'&&f.path[1]==='extra'&&f.path[3]==='render_options',head=f.path[4];if(isOptions&&(kind==='render-size'&&(head==='imageSize'||head==='aspect_ratio'||head==='isAspectConstrained'||head==='renderViewport')||kind==='render-type'&&head==='isCurrentFrameRender'||kind==='render-quality'&&f.meta&&quality[f.meta.id])){if(kind==='render-type')f.label='Render current frame only (Still Image)';result.push(f);}}if(!result.length)fail('This settings group is not recorded in the saved scene.');return result;}

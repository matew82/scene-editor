            if (!isCamera(request)) { return base.prepareAction.apply(base, arguments); }
            need(!busy, 'Wait for the current camera action.'); busy = true;
            try {
                release(); var version = validate(request);
                camera = SaveGuardCameraManager.create(env, root + '/camera-actions');
                var loaded = camera.open(version.path,{version:current.version,request:request,mode:base.readSettings().loadCacheMode||"protected",deep:base.readSettings().deepValidation===true,isCancelled:isCancelled}), found = null, i;
                for (i = 0; i < loaded.cameras.length; i += 1) { if (loaded.cameras[i].id === request.sourceId) { need(!found,'Duplicate saved camera identity.'); found = loaded.cameras[i]; } }
                need(found, 'Selected saved camera is unavailable.'); need(!found.error, errorText(found && found.error));
                validate(request);

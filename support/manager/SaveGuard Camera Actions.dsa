                if (!result || result.ok !== true) { return {ok:false,error:errorText(report.error || result && result.error || 'Camera action failed.') + (blocked ? result && result.candidate === 'native-camera-output-v1' ? ' STOP: Undo ownership or completion is uncertain; inspect the scene before continuing.' : ' STOP: rollback could not be verified.' : result && result.rollback && result.rollback.verified ? ' Previous camera state restored.' : ''),cameraReport:report,cancelled:report.cancelled===true||!!(result&&result.cancelled),code:report.cancelled===true||result&&result.cancelled?'CANCELLED':undefined}; }

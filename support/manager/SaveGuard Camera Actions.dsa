            var pin = current.rows['$' + r.rowKey];
            need(pin && pin.id === r.rowId && pin.sourceId === r.sourceId && pin.type === r.rowType, 'Saved camera row changed; select it again.');
            need(typeof checker === 'function' && checker(r) === true, 'Camera selection changed; select it again.');
            var prefs = base.readSettings();

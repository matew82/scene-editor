var SaveGuardEmissives=(function(){
 function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}function dec(s){try{return decodeURIComponent(String(s||''));}catch(e){return String(s||'');}}
 var allow={'Emission Color':1,'Emission Temperature':1,'Emission Profile':1,'Luminance':1,'Luminance Units':1,'Luminous Efficacy':1,'Two Sided Light':1,'Emission Enable':1,'Emission Enabled':1};
 function extract(doc,guard){guard=guard||function(){};var defs={},owners={},rows=[],visited=0,kept=0,i,j,k,ms=doc.material_library||[],nodes=doc.scene&&doc.scene.nodes||[],materials=doc.scene&&doc.scene.materials||[],summary={materials:materials.length,definitions:ms.length,nodes:nodes.length,linked:0,unlinked:0,knownIray:0,unknownShader:0,explicitNonzero:0,explicitZero:0,mapDependent:0,incomplete:0,externalBase:0,instanceEmissionOverrides:0};

 function sparse(m){guard();var out={channels:{},shader:null,source:m.source||null};for(var e=0;e<(m.extra||[]).length;e++){var ex=m.extra[e];if(ex.type==='studio/material/uber_iray')out.shader='Iray Uber';else if(ex.type==='studio/material/daz_brick')out.shader='Unknown/custom brick';for(var c=0;c<(ex.channels||[]).length;c++){var ch=ex.channels[c].channel;visited++;if(visited%256===0)guard();if(!ch||!own(allow,ch.id))continue;kept++;var v={};if(own(ch,'value'))v.value=ch.value;if(own(ch,'current_value'))v.current_value=ch.current_value;if(own(ch,'image_file'))v.image_file=ch.image_file;if(own(ch,'image'))v.image=ch.image;if(ch.keys||ch.animations)v.animated=true;out.channels[ch.id]=v;}}return out;}
 for(i=0;i<ms.length;i++){k='$'+dec('#'+ms[i].id);defs[k]=own(defs,k)?null:sparse(ms[i]);}
 for(i=0;i<nodes.length;i++)for(j=0;j<(nodes[i].geometries||[]).length;j++){var g=nodes[i].geometries[j],key='$#'+dec(g.id);owners[key]=own(owners,key)?null:{id:nodes[i].id,label:nodes[i].label||nodes[i].name||nodes[i].id};}
 for(i=0;i<materials.length;i++){var m=materials[i],base=defs['$'+dec(m.url)],inst=sparse(m),channels={},name;if(base){for(name in base.channels)if(own(base.channels,name))channels[name]=base.channels[name];}for(name in inst.channels)if(own(inst.channels,name)){var merged={},old=channels[name]||{},prop;for(prop in old)if(own(old,prop))merged[prop]=old[prop];for(prop in inst.channels[name])if(own(inst.channels[name],prop))merged[prop]=inst.channels[name][prop];channels[name]=merged;summary.instanceEmissionOverrides++;}var owner=owners['$'+dec(m.geometry)],shader=inst.shader||base&&base.shader,external=!base||!!base.source,status='unknown',color=channels['Emission Color'],lum=channels.Luminance;function value(c){return c&&(own(c,'current_value')?c.current_value:c.value);}var cv=value(color),lv=value(lum),mapped=!!(color&&(color.image||color.image_file)||lum&&(lum.image||lum.image_file));if(owner)summary.linked++;else summary.unlinked++;if(external)summary.externalBase++;if(shader==='Iray Uber'){summary.knownIray++;if(mapped){status='map-dependent';summary.mapDependent++;}else if(!external&&color&&lum&&!color.animated&&!lum.animated&&Object.prototype.toString.call(cv)==='[object Array]'&&cv.length===3&&typeof lv==='number'){if(lv>0&&(cv[0]>0||cv[1]>0||cv[2]>0)){status='explicit-nonzero-candidate';summary.explicitNonzero++;}else{status='explicit-zero';summary.explicitZero++;}}else summary.incomplete++;}else{summary.unknownShader++;}rows.push({material:m.id,geometry:m.geometry,groups:m.groups||[],node:owner||null,shader:shader||'unknown',status:status,externalBase:external,channels:channels});}
 summary.channelIdsVisited=visited;summary.fieldsRetained=kept;return {summary:summary,rows:rows};}
 function collect(doc,guard){var result=extract(doc,guard),byId={},objects=[],counts=result.summary;for(var i=0;i<result.rows.length;i++){var r=result.rows[i];if(r.status==='explicit-zero'||!r.node)continue;var key='$'+r.node.id,o=byId[key];if(!o){o={id:r.node.id,nonzero:0,mapped:0,unknown:0,surfaces:[],confirmedSurfaces:[]};byId[key]=o;objects.push(o);}if(r.status==='explicit-nonzero-candidate'){o.nonzero++;var surfaceNames=r.groups.length?r.groups:[r.material];for(var si=0;si<surfaceNames.length&&o.confirmedSurfaces.length<64;si++)if(typeof surfaceNames[si]==='string'&&o.confirmedSurfaces.indexOf(surfaceNames[si])<0)o.confirmedSurfaces.push(surfaceNames[si]);}else if(r.status==='map-dependent')o.mapped++;else o.unknown++;if(o.surfaces.length<64)o.surfaces.push(r.material);}return {objects:objects,summary:counts};}
 return {collect:collect};
}());

   if(manager)for(g=0;g<groups.length;g++){var pair=groups[g];if(typeof manager[pair[0]]!=='function'||typeof manager[pair[1]]!=='function'){diagnostics.push(pair[2]+' directory API unavailable');continue;}
    try{count=Number(manager[pair[0]]());if(!isFinite(count)||count<0||Math.floor(count)!==count)throw Error('Invalid configured directory count');}catch(countError){diagnostics.push(pair[2]+': '+String(countError.message||countError));continue;}
    for(i=0;i<count;i++){try{var value=manager[pair[1]](i);if(value===null||value===undefined||String(value)===''){diagnostics.push(pair[2]+' directory '+i+' is empty');continue;}path=canonical(String(value));var k=literalKey(path);if(seen[k])continue;seen[k]=true;if(exists(path)&&info(path).isDir())return path;diagnostics.push(pair[2]+' directory '+i+' is missing or not a folder');}catch(pathError){diagnostics.push(pair[2]+' directory '+i+': '+String(pathError.message||pathError));}}
   }

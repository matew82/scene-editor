  function classifyContentPath(path){var inventory=configuredContentRoots(),result={path:null,classification:'unknown',insideGallery:null,role:'unknown',contentRoot:null,relativePath:null,rootAvailable:false,exists:false,directory:false,diagnostics:inventory.diagnostics.slice(0)},candidate,k,i,match=null;
   try{candidate=contentCanonical(path);result.path=candidate;var f=info(candidate);result.exists=f.exists();result.directory=result.exists&&f.isDir();k=literalKey(candidate);}catch(pathError){result.diagnostics.push('Selected path: '+String(pathError.message||pathError));return result;}
   for(i=0;i<inventory.roots.length;i++){var root=inventory.roots[i],rk=literalKey(root.path);if((k===rk||k.indexOf(rk+'/')===0)&&(!match||rk.length>literalKey(match.path).length))match=root;}
   if(match){result.classification='inside';result.insideGallery=true;result.role=k===literalKey(match.path)?'gallery-root':'gallery-descendant';result.contentRoot=match.path;result.relativePath=k===literalKey(match.path)?'':candidate.substring(match.path.replace(/\/$/,'').length).replace(/^\//,'');result.rootAvailable=match.available;return result;}
   if(inventory.available&&inventory.complete){result.classification='outside';result.insideGallery=false;result.role='outside-gallery';}return result;

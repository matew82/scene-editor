  function configuredContentRoots(){var result={available:false,complete:false,roots:[],diagnostics:[]},manager,count,i,seen={};
   try{if(!env.App||typeof env.App.getContentMgr!=='function')throw Error('Content Manager API unavailable');manager=env.App.getContentMgr();if(!manager||typeof manager.getNumContentDirectories!=='function'||typeof manager.getContentDirectoryPath!=='function')throw Error('DAZ content directory API unavailable');count=Number(manager.getNumContentDirectories());if(!isFinite(count)||count<0||Math.floor(count)!==count)throw Error('Invalid configured DAZ content directory count');result.available=true;result.complete=true;}catch(managerError){result.diagnostics.push(String(managerError.message||managerError));return result;}

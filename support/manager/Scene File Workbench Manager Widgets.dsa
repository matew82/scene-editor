/* Exact reusable native widget helpers from current SaveGuard Manager UI; no catalog/action entrypoint. */
var SceneEditorManagerWidgets=(function(){
function splitterState(control){try{if(typeof control.saveState!=='function')return '';var data=control.saveState();if(!data||typeof data.toHex!=='function')return '';return String(data.toHex().convertToString());}catch(ignore){return '';}}
function restoreSplitter(control,text){try{if(typeof text!=='string'||!text||text.length%2||!/^[0-9a-f]+$/i.test(text)||typeof ByteArray!=='function'||typeof control.restoreState!=='function')return false;var decoder=new ByteArray();if(typeof decoder.fromHex!=='function')return false;return control.restoreState(decoder.fromHex(new ByteArray(text)))===true;}catch(ignore){return false;}}
function dialog(title, width, height) {
        var w = new DzBasicDialog(); w.caption = title; var available = null; try { if (typeof DzDesktopWidget !== "undefined") { available = new DzDesktopWidget().availableGeometry(); } } catch (ignoredDesktop) {}
        var desktopWidth = Number(available && available.width), desktopHeight = Number(available && available.height);
        if (desktopWidth > 100 && desktopHeight > 100) { width = Math.min(width, desktopWidth - 32); height = Math.min(height, desktopHeight - 64); w.maxWidth = desktopWidth - 32; w.maxHeight = desktopHeight - 64; }
        w.minWidth = width; w.minHeight = height;
        if (available && desktopWidth > 100 && desktopHeight > 100) { w.setGeometry(Number(available.x) + 16, Number(available.y) + 16, width, height); } w.sizeGripEnabled = true;
        w.setAcceptButtonText("Close"); w.showCancelButton(false); w.showHelpButton(false);
        var font = w.font; font.pointSize = Math.max(12, Number(font.pointSize) || 12);
        try { if (typeof font.families === "function") { var families=font.families(); for(var fi=0;fi<families.length;fi+=1){if(String(families[fi]).toLowerCase()==="georgia"){font.family="Georgia";break;}} } } catch (ignoredFont) {} w.font = font;
        return w;
    }
// Retain real native filename text for type-to-select, tooltips and accessibility.
// Mark recent rows with color artwork only: thumbnail underline or compact left bar.
function sceneRecentMarker(env, thumbnail, recent, icons) {
    if(!recent)return{pixmap:icons?thumbnail:new env.Pixmap(),marked:false};
    try{
        if(typeof env.Image!=='function'||env.Image.Format_ARGB32===undefined||typeof env.Pixmap!=='function'||typeof env.Color!=='function')return null;
        var image,width,height,x,y;
        if(icons){if(!thumbnail||typeof thumbnail.toImage!=='function')return null;var source=thumbnail.toImage();if(!source||source.isNull()||typeof source.copy!=='function')return null;image=source.copy();width=Number(image.width);height=Number(image.height);if(!isFinite(width)||!isFinite(height)||width<6||height<6||width>256||height>256)return null;}
        else{width=6;height=22;image=new env.Image(width,height,env.Image.Format_ARGB32);}
        if(image.isNull()||typeof image.setPixel!=='function')return null;
        var color=new env.Color(231,207,136,255);
        if(icons){for(y=height-6;y<height;y++)for(x=0;x<width;x++)image.setPixel(x,y,color);}
        else image.fill(color);
        var pixmap=new env.Pixmap();pixmap.fromImage(image);return pixmap.isNull()?null:{pixmap:pixmap,marked:true};
    }catch(ignoreRecentArtwork){return null;}
}
function thumbnailCache(adapter) {
        var cache = {}, order = [], limit = 120;
        function create(path, size, warning, selected, important, comparisonSlot) {
            var img = new Image(), missing = true, scaled, pix = new Pixmap(), x, band, color;
            if (path) {
                try {
                    if ((!adapter.imageExists || adapter.imageExists(path)) && img.load(path) && !img.isNull() && img.width > 0 && img.height > 0) {
                        // Square previews use a center crop; full screenshots below preserve aspect ratio.
                        var side = Math.min(img.width, img.height);
                        scaled = img.copy(Math.floor((img.width - side) / 2), Math.floor((img.height - side) / 2), side, side).smoothScale(size, size); missing = false;
                    }
                } catch (ignoreImage) {}
            }
            if (!scaled || scaled.isNull()) { scaled = new Image(size, size, Image.Format_RGB32); scaled.fill(new Color(52, 57, 63)); missing = true; }
            if (important || warning || selected) {
                color = important ? (selected ? new Color(255, 193, 120) : new Color(231, 137, 49)) : warning ? (selected ? new Color(255, 153, 156) : new Color(224, 63, 67)) : new Color(80, 200, 120);
                for (band = 0; band < 3; band += 1) { for (x = 0; x < size; x += 1) {
                    scaled.setPixel(x, band, color); scaled.setPixel(x, size - 1 - band, color);
                    scaled.setPixel(band, x, color); scaled.setPixel(size - 1 - band, x, color);
                } }
            }
            if((comparisonSlot==='A'||comparisonSlot==='B')&&size>=32){var bx=size-28,by=4,ink=new Color(225,245,255),edge=new Color(120,204,247),fill=new Color(32,66,88),xx,yy,glyph=comparisonSlot==='A'?['01110','10001','10001','11111','10001','10001','10001']:['11110','10001','10001','11110','10001','10001','11110'];for(yy=0;yy<24;yy++)for(xx=0;xx<24;xx++)scaled.setPixel(bx+xx,by+yy,xx===0||yy===0||xx===23||yy===23?edge:fill);for(yy=0;yy<7;yy++)for(xx=0;xx<5;xx++)if(glyph[yy].charAt(xx)==='1'){scaled.setPixel(bx+7+xx*2,by+5+yy*2,ink);scaled.setPixel(bx+8+xx*2,by+5+yy*2,ink);scaled.setPixel(bx+7+xx*2,by+6+yy*2,ink);scaled.setPixel(bx+8+xx*2,by+6+yy*2,ink);}}
            pix.fromImage(scaled); return { pixmap: pix, missing: missing };
        }
        return { get: function (path, size, warning, selected, important, comparisonSlot) {
            selected = selected === true;
            var key = "$" + path + "|" + size + "|" + warning + "|" + selected + "|" + (important===true)+"|"+(comparisonSlot||"");
            if (!Object.prototype.hasOwnProperty.call(cache, key)) {
                if (order.length >= limit) { delete cache[order.shift()]; }
                cache[key] = create(path, size, warning, selected, important, comparisonSlot); order.push(key);
            }
            return cache[key];
        }, clear: function () { cache = {}; order = []; } };
    }
function imageButtonPixmap(control, pixmap, width, height) {
        control.pixmap = pixmap;
        var nativeButton = control.getWidget(), current = nativeButton && nativeButton.iconSize;
        if (!current || typeof Size !== "function") { throw Error("Native image-button icon sizing is unavailable."); }
        nativeButton.iconSize = new Size(width, height);
        current = nativeButton.iconSize;
        if (!current || Number(current.width) !== width || Number(current.height) !== height) { throw Error("Native image-button icon size was not applied."); }
    }
var buttonIconNames=["Scene File Workbench Edit saved properties","Scene File Workbench Edit saved materials","Scene File Workbench Folder Gallery Shortcut","Scene File Workbench Folder Outside Shortcut","Scene File Workbench Folder Gallery Shortcut Recent","Scene File Workbench Folder Outside Shortcut Recent","Scene File Workbench Parent Directory", "Scene File Workbench Folder Gallery", "Scene File Workbench Folder Outside", "Scene File Workbench Action Character", "Scene File Workbench Action Collapse", "Scene File Workbench Action Expand", "Scene File Workbench Action Find", "Scene File Workbench Action Materials", "Scene File Workbench Action Object", "Scene File Workbench Action Pose", "Scene File Workbench Action Restore Pose", "Scene File Workbench Action Restore Shape", "Scene File Workbench Action Shape", "Scene File Workbench Action Transforms", "Scene File Workbench Action Wearable", "Scene File Workbench Add Camera", "Scene File Workbench Arrow Left", "Scene File Workbench Arrow Right", "Scene File Workbench Close", "Scene File Workbench Edit", "Scene File Workbench light-camera-hidden", "Scene File Workbench light-camera-unknown", "Scene File Workbench light-camera", "Scene File Workbench light-character", "Scene File Workbench light-distant-group", "Scene File Workbench light-distant", "Scene File Workbench light-emissive", "Scene File Workbench light-figure", "Scene File Workbench light-generic-group", "Scene File Workbench light-generic", "Scene File Workbench light-neutral", "Scene File Workbench light-object", "Scene File Workbench light-point-group", "Scene File Workbench light-point", "Scene File Workbench light-spot-group", "Scene File Workbench light-spot", "Scene File Workbench light-wearable", "Scene File Workbench Load Emissive", "Scene File Workbench Load Light Assembly", "Scene File Workbench Load Light", "Scene File Workbench Refresh", "Scene File Workbench Replace Camera", "Scene File Workbench Search", "Scene File Workbench Settings", "Scene File Workbench Manager", "Scene File Workbench Action Render Settings", "Scene File Workbench Backup", "Scene File Workbench Load Scene", "Scene File Workbench Merge Scene", "Scene File Workbench Note", "Scene File Workbench Save Note", "Scene File Workbench Important"];
function semanticButtonIcon(name){if(typeof name!=='string')return null;var value=name.replace(/^\s+|\s+$/g,'').replace(/\.png$/i,''),lower=value.toLowerCase(),i;if(lower==='settings')return 'Scene File Workbench Edit';value=value.replace(/^SaveGuard /i,'Scene File Workbench ');for(i=0;i<buttonIconNames.length;i++)if(buttonIconNames[i].toLowerCase()===value.toLowerCase()||buttonIconNames[i].substring('Scene File Workbench '.length).toLowerCase()===lower)return buttonIconNames[i];
 var map={'parentdirectory':'Parent Directory','foldergallery':'Folder Gallery','folderoutside':'Folder Outside','foldergalleryrecent':'Folder Gallery Recent','folderoutsiderecent':'Folder Outside Recent','foldergalleryshortcut':'Folder Gallery Shortcut','folderoutsideshortcut':'Folder Outside Shortcut','foldergalleryshortcutrecent':'Folder Gallery Shortcut Recent','folderoutsideshortcutrecent':'Folder Outside Shortcut Recent','choose folder...':'Folder Gallery','choose folder':'Folder Gallery','browse':'Folder Gallery','folder':'Folder Outside','parent folder':'Parent Directory','parent directory':'Parent Directory','up one folder':'Parent Directory','back':'Arrow Left','forward':'Arrow Right','refresh':'Refresh','refresh backups':'Refresh','settings':'Edit','close':'Close','cancel':'Close','close without saving':'Close','advanced filters':'Search','clear filters':'Close','backup this scene':'Backup','load scene':'Load Scene','merge scene':'Merge Scene','important':'Important','important scenes only':'Important','note':'Note','save note':'Save Note','open screenshot':'Search','open screenshots':'Search','advanced figure configuration':'Action Character','supported figures':'Action Character','add selected figure':'Action Character','restore missing defaults':'Refresh','use this list':'Settings','save settings':'Settings','clear caches for missing files':'Refresh','clear current-folder caches':'Refresh','clear all caches':'Refresh','add object condition':'Action Object','remove':'Close','expand':'Action Expand','collapse':'Action Collapse','find':'Search','find by exact label':'Search','edit':'Edit','edit saved properties':'Edit saved properties','edit saved materials':'Edit saved materials','edit properties':'Edit','apply render settings':'Action Render Settings'};
 if(lower.indexOf('[..]')===0)return'Scene File Workbench Arrow Left';if(lower.indexOf('[folder]')===0)return'Scene File Workbench Arrow Right';if(Object.prototype.hasOwnProperty.call(map,lower))return'Scene File Workbench '+map[lower];return null;}
function applyIcon(env,control,path,title,options){options=options||{};var compact=options.compact!==false,size=options.iconSize||(compact?48:24),buttonSize=options.buttonSize||52;if(!env||typeof env.DzFileInfo!=='function'||typeof env.Pixmap!=='function'||typeof env.Size!=='function')throw Error('Native icon file/Pixmap/Size APIs are unavailable.');if(typeof path!=='string'||!path||/[\x00-\x1f]/.test(path))throw Error('A valid required Scene File Workbench icon path is needed.');var info=new env.DzFileInfo(path);if(typeof info.exists!=='function'||typeof info.isFile!=='function'||typeof info.isReadable!=='function')throw Error('Native icon file validation APIs are unavailable.');if(!info.exists()||!info.isFile()||!info.isReadable())throw Error('Required Scene File Workbench icon is missing or unreadable: '+path);var pixmap=new env.Pixmap(path);if(typeof pixmap.isNull!=='function'||pixmap.isNull())throw Error('Required Scene File Workbench icon could not be decoded: '+path);if(!control||typeof control.getWidget!=='function'||typeof control.setFixedSize!=='function')throw Error('Native icon button APIs are unavailable.');var nativeButton=control.getWidget();if(!nativeButton||!nativeButton.iconSize)throw Error('Native image-button icon sizing is unavailable.');var tooltip=control.toolTip||control.text||title||'Scene File Workbench action';control.pixmap=pixmap;control.sizedFromIcon=compact;control.autoDefault=false;nativeButton.iconSize=new env.Size(size,size);var actual=nativeButton.iconSize;if(!actual||Number(actual.width)!==size||Number(actual.height)!==size)throw Error('Native image-button icon size was not applied.');control.toolTip=String(tooltip);if(compact){control.text='';control.setFixedSize(buttonSize,buttonSize);}else control.minHeight=Math.max(34,Number(control.minHeight)||0);return{path:path,iconWidth:size,iconHeight:size,compact:compact,controlWidth:compact?buttonSize:null,controlHeight:compact?buttonSize:null};}
function applyButtonIcon(env,control,name,root){var icon=semanticButtonIcon(name);if(!icon)throw Error('No Scene File Workbench icon mapping for action: '+String(name));root=root||env&&env.sceneEditorRoot;if(typeof root!=='string'||!root)throw Error('Scene File Workbench project root is required for action icons.');root=root.replace(/\\/g,'/').replace(/\/+$/,'');return applyIcon(env,control,root+'/icons/'+icon+'.png',String(name),{compact:false});}

return{sceneRecentMarker:sceneRecentMarker,splitterState:splitterState,restoreSplitter:restoreSplitter,semanticButtonIcon:semanticButtonIcon,applyIcon:applyIcon,applyButtonIcon:applyButtonIcon,dialog:dialog,thumbnailCache:thumbnailCache,imageButtonPixmap:imageButtonPixmap};
}());

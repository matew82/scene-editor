// Pure DSON transform evaluator. Native build conformance is a separate audit gate.
var SaveGuardDSONPlacement = (function () {
    function own(o, k) { return !!o && Object.prototype.hasOwnProperty.call(o, k); }
    function fail(message) { var e = new Error(message); e.code = "PLACEMENT_UNSUPPORTED"; throw e; }
    function identity() { return [1,0,0,0,1,0,0,0,1]; }
    function mul(a,b) { var o=[],r,c,k; for(r=0;r<3;r+=1){for(c=0;c<3;c+=1){o[r*3+c]=0;for(k=0;k<3;k+=1){o[r*3+c]+=a[r*3+k]*b[k*3+c];}}}return o; }

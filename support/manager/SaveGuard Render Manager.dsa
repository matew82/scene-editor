var SaveGuardRenderManager=(function(){
 function need(v,m){if(!v)throw Error(m);}
 function cancel(check){if(typeof check==='function'&&check()){var e=Error('Render action cancelled');e.code='CANCELLED';throw e;}}
 function context(preview,version,request,options){
  need(request.tabKey==='render'&&request.sourceId==='render:static'&&request.rowKey==='render:static'&&request.versionId===preview.versionId&&request.inspectionToken===preview.inspectionToken,'Render source identity differs');need(options&&preview.provider.verifySource()===true,'Saved inspection changed');
  var source=null,selected=null,closed=false;try{source=SaveGuardNativeSource.open(version.scenePath,{renderSource:true,deepValidation:options.deepValidation===true,isCancelled:options.isCancelled,onProgress:options.onProgress});selected=source.select(request.sourceId);var row={id:'render:static',sourceId:'render:static',rowKey:'render:static',label:'Saved render settings',type:'Static Iray',selectable:true,actionKeys:['applyRenderSettings'],sceneExtraIndex:0,catalogRenderIndex:0},view={versionId:preview.versionId,inspectionToken:preview.inspectionToken,selectiveAvailable:true,tabs:{render:[row]},mapping:{rowByKey:{}}};view.mapping.rowByKey['$render:static']={kind:'render-setting',locator:'render:static',sceneExtraIndex:0,catalogRenderIndex:0};var c={versionId:preview.versionId,scenePath:version.scenePath,inspectionToken:preview.inspectionToken,lowMemoryMode:false,deepValidation:options.deepValidation===true,nativeSelected:true,planningDocument:selected.document,catalog:{rows:[],errors:[]},view:view,provider:selected.provider,readResult:selected};return {context:c,verify:function(){need(!closed&&c.provider===selected.provider&&c.planningDocument===selected.document,'Render context closed/changed');return selected.provider.verifySource();},close:function(){if(!closed){closed=true;selected.provider.close();}}};}catch(e){if(selected)selected.provider.close();else if(source)source.close();throw e;}
 }
 function create(env,info,profile){need(profile&&profile.verified&&profile.undoRedoVerified&&profile.actionKey==='applyRenderSettings'&&profile.buildId===String(env.buildId)&&profile.platform===env.platform,'Render settings not verified for this host');need(info.context.lowMemoryMode===false,'Render restoration requires Low RAM OFF');var context=info.context,doc=context.planningDocument,provider=context.provider,resolver=info.resolver,closed=false,plan=null,binding=null,baseline=null,issued=[],resources=[];
  function resolve(file){if(decodeURIComponent(file).indexOf('/resources/')!==0)return resolver.resolveExternal(file,{uris:[file]});var found=SaveGuardRenderSettings.resource(env,file);resources.push({uri:file,identity:JSON.stringify(found)});return found;}
  function live(check){need(!closed&&info.context===context&&context.planningDocument===doc&&context.provider===provider&&info.resolver===resolver,'Render context changed');need(provider.verifySource()===true&&resolver.verifyAll()===true,'Render source/dependency changed');for(var ri=0;ri<resources.length;ri++)need(JSON.stringify(SaveGuardRenderSettings.resource(env,resources[ri].uri))===resources[ri].identity,'Iray resource changed');if(check){var current=SaveGuardRenderSettings.bind(env,plan);need(current.bound.length===binding.bound.length,'Render target structure changed');for(var i=0;i<current.bound.length;i++)need(env.pointersAreEqual(current.bound[i].p,binding.bound[i].p),'Render target changed');need(JSON.stringify(SaveGuardRenderSettings.snapshot(current))===baseline,'Render settings changed after preparation; apply again');}}
  return {buildRender:function(source,id){live();need(source===doc&&id==='render:static','Unknown render source');plan=SaveGuardRenderSettings.compile(doc,resolve);binding=SaveGuardRenderSettings.bind(env,plan);baseline=JSON.stringify(SaveGuardRenderSettings.snapshot(binding));return {plan:plan};},prepare:function(request,cancelled){live();need(plan&&request.plan===plan&&request.kind==='render','Unknown render plan');cancel(cancelled);need(request.source.verify()===true,'Source changed');var receipt={kind:'render'};issued.push({receipt:receipt,source:request.source,used:false});return receipt;},apply:function(receipt,cancelled){live(true);cancel(cancelled);var item=null;for(var i=0;i<issued.length;i++)if(issued[i].receipt===receipt)item=issued[i];need(item&&!item.used,'Unknown or consumed render receipt');need(item.source.verify()===true,'Source changed');item.used=true;return SaveGuardRenderSettings.run(env,plan,false,cancelled);},release:function(receipt){for(var i=0;i<issued.length;i++)if(issued[i].receipt===receipt){issued.splice(i,1);return true;}return false;},close:function(){closed=true;issued=[];resources=[];binding=null;baseline=null;plan=null;}};
 }
 return {create:create,context:context};
}());

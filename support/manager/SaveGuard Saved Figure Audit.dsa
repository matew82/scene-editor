            captureScene:function(){if(typeof env.pointersAreEqual!=="function"){fail("AUDIT_IDENTITY","Native pointer comparison is required.");}var reg=registry(),s={token:{},registry:reg,state:snapshotScene(reg),entry:null,expected:null};issued.push(s);return s.token;},
            readScene:function(token){return copy(privateSnapshot(token).state);},nativeKey:function(token,node){return privateSnapshot(token).registry.key(node);},verifyUnchanged:verifyUnchanged,

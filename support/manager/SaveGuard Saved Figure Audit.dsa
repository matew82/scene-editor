                            if(options.verifyImportedContent&&options.verifyImportedContent(sceneEditorCompat_native,d,entry)!==true){errors.push("Imported content verification failed: "+d.id);}
                            bindings["$"+d.id]={stagedId:d.id,nativeKey:matched.key,definitionId:d.definitionId,parentId:d.parentId};used["$"+matched.key]=true;pending.splice(i,1);progress=true;
                        }else if(candidates.length>1){errors.push("Ambiguous native binding for staged node "+d.id);pending.splice(i,1);progress=true;}
                    }}
                    for(i=0;i<pending.length;i+=1){errors.push("No unique native identity/parent match: "+pending[i].id);}
                    if(snapshot.expected.rule==="profile-validated-native-reconstruction"){
                        if(!options.reconstruction||!options.reconstruction.verifyBindings(snapshot.expected,entry,function(id){var binding=bindings["$"+id];return binding?snapshot.registry.handle(binding.nativeKey):null;})){errors.push("Native reconstruction relationships/controls were not verified");}
                    }
                    if(entry.built.idMap){for(var sourceId in entry.built.idMap){if(own(entry.built.idMap,sourceId)&&own(bindings,"$"+entry.built.idMap[sourceId])){bindings["$"+entry.built.idMap[sourceId]].savedId=sourceId.charAt(0)==="$"?sourceId.substring(1):sourceId;}}}
                }
            }catch(e){errors.push((e.code||"AUDIT")+": "+text(e.message||e));}
            last={phase:rollback?"rollback":"outcome",ok:!errors.length,errors:errors,bindings:bindings,coverage:after?after.coverage:snapshot&&snapshot.state?snapshot.state.coverage:[],
                dirtyFlagPolicy:rollback?"preserve-or-raise-v1":null,flagObservation:rollback&&after&&snapshot&&snapshot.state?rollbackFlags(snapshot.state,after,[]):null,selectionDeferred:true,selectionScope:"ApplyHost restores and verifies selection after this port",runtimeWorldScope:snapshot&&snapshot.expected&&snapshot.expected.runtimeWorldScope||"Independent numeric saved world matrices",nativeVerified:false};return !errors.length;
        }
        function comparableState(state,settings) {
            var out=copy(state);delete out.byKey;delete out.coverage;delete out.propertiesObserved;
            if(!settings.checkSelection){delete out.selection;}if(settings.checkDirty===false){delete out.dirty;delete out.assetDirty;}
            out.nodes.sort(function(a,b){return a.key<b.key?-1:a.key>b.key?1:0;});return out;
        }

                        for(j=0;j<added.length;j+=1){var actual=added[j];if(own(used,"$"+actual.key)||actual.parentKey!==(parent?parent.nativeKey:null)){continue;}var handle=snapshot.registry.handle(actual.key),identity=options.matchImportedIdentity?options.matchImportedIdentity(handle,d,entry)===true:actual.assetId===d.definitionId;

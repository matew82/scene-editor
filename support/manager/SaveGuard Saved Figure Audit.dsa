            releaseSnapshot:function(token){for(var i=0;i<issued.length;i+=1){if(issued[i].token===token){if(options.reconstruction&&issued[i].expected){options.reconstruction.release(issued[i].expected);}issued.splice(i,1);return true;}}return false;},
            lastReport:function(){return last;},sameNative:same,
            coverage:function(){return {scope:"merge observed state and expected node identity/parent/world placement",nativeVerified:false,
                limitations:["No exhaustive unrelated mesh buffers or private plugin/controller serialization.","Requested fitted/parent_in_place/constraint-driven placement needs a separate validated expected-placement implementation.","Added material/geometry payload semantics require verifyImportedContent for stronger claims.","Undo/redo history is outside the scene-state audit."]};}};
    }
    return {create:create};
}());

            settings=settings||{};var errors=[],before,after,snapshot,flags=null;
            try{snapshot=privateSnapshot(token);var observed=snapshotScene(snapshot.registry);
                if(settings.rollbackFlags!==undefined){
                    if(settings.rollbackFlags!=="preserve-or-raise-v1"||settings.project||settings.checkDirty===false){fail("AUDIT_FLAGS","Rollback flag policy cannot hide or project scene content.");}
                    flags=rollbackFlags(snapshot.state,observed,errors);
                }
                compare(snapshot.state.time,observed.time,"scene time",errors,0,0);
                before=comparableState(snapshot.state,settings);after=comparableState(observed,settings);
                if(flags){delete before.dirty;delete after.dirty;delete before.assetDirty;delete after.assetDirty;}
                if(settings.project){before=settings.project(before);after=settings.project(after);if(!before||typeof before!=="object"||!after||typeof after!=="object"){fail("AUDIT_PROJECT","Trusted projection must return observed-state objects.");}}
                compare(before,after,"scene",errors,options.existingAbsoluteTolerance||0.000001,options.existingRelativeTolerance||0.00000001);
            }catch(e){errors.push((e.code||"AUDIT")+": "+text(e.message||e));}
            last={phase:"unchanged",ok:!errors.length,errors:errors,flagObservation:flags,coverage:snapshot?snapshot.state.coverage.slice(0):[],selectionDeferred:!settings.checkSelection,nativeVerified:false};return !errors.length;
        }

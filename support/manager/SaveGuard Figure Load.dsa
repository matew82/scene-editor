            for(i=0;i<mods.length;i++){if(!member(profile.modifierInstanceSignatures,signature(mods[i])))throw Error("Saved modifier override is outside accepted scope.");url=SaveGuardSelective.parseURI(mods[i].url);assetReference(mods[i].url,"modifier_library");if(url.kind!=="external"&&url.kind!=="local")throw Error("Invalid modifier reference");}

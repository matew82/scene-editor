                }
                report.ok=true;
            } catch(e) {report.error=String(e.message||e);}
            last=report;return report.ok;
        }
        return { assess:assess, verify:verify, lastReport:function(){return last?JSON.parse(JSON.stringify(last)):null;} };
    }
    return { create:create };
}());

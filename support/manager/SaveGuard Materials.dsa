 function geometryIdentity(sh,g){var info={assetSource:nativeString(g.assetSource),assetUri:nativeString(g.assetUri),via:'getGeometry'};info.uri=uri(info.assetSource)||uri(info.assetUri);if(!info.uri&&typeof sh.getCurrentGeometry==='function'){var base=sh.getCurrentGeometry();info.baseAvailable=!!base;if(base){info.baseAssetSource=nativeString(base.assetSource);info.baseAssetUri=nativeString(base.assetUri);info.uri=uri(info.baseAssetSource)||uri(info.baseAssetUri);info.via='getCurrentGeometry(BaseGeometry default)';}}return info;}
 function value(p){if(String(p.className())==='DzImageProperty')return null;if(typeof p.getFloatColorValue==='function'){var f=p.getFloatColorValue();return [Number(f.red),Number(f.green),Number(f.blue)];}if(typeof p.getColorValue==='function'){var c=p.getColorValue();return [Number(c.red)/255,Number(c.green)/255,Number(c.blue)/255];}return p.getValue();}
 function close(a,b){if(Object.prototype.toString.call(a)==='[object Array]'){if(!b||a.length!==b.length)return false;for(var i=0;i<a.length;i++)if(!close(a[i],b[i]))return false;return true;}if(typeof a==='number'||typeof a==='boolean')return isFinite(Number(b))&&Math.abs(Number(a)-Number(b))<=Math.max(0.00002,Math.abs(Number(a))*0.00002);return a===b;}
 // GeoShell render/graft caches may share a material without owning another scene node.
 function shellMaterialOwners(env,owners,shape,node,material){
  if(!owners||typeof owners.length!=='number'||!isFinite(owners.length)||owners.length<1||Math.floor(owners.length)!==owners.length)return false;
  var current=false;
  for(var i=0;i<owners.length;i++){
   var owner=owners[i];if(!owner)return false;
   if(env.pointersAreEqual(owner,shape)){current=true;continue;}
   if(typeof owner.getNode!=='function')return false;var ownerNode=owner.getNode();
   if(ownerNode){if(!env.pointersAreEqual(ownerNode,node))return false;}
   else if(ownerNode!==null||typeof owner.inherits!=='function'||!owner.inherits('DzGraftingFigureShape')||!/_InternalShellShape$/.test(String(owner.name)))return false;
   if(typeof owner.findMaterialIndex!=='function'||typeof owner.getNumMaterials!=='function'||typeof owner.getMaterial!=='function')return false;
   var index=Number(owner.findMaterialIndex(material)),count=Number(owner.getNumMaterials());
   if(!isFinite(index)||Math.floor(index)!==index||index<0||!isFinite(count)||Math.floor(count)!==count||index>=count||!env.pointersAreEqual(owner.getMaterial(index),material))return false;
  }
  return current;
 }
 function target(env){var s=env.Scene,t=s.getPrimarySelection(),selected=s.getSelectedNodeList();need(t&&selected.length===1&&env.pointersAreEqual(selected[0],t),'Select exactly one object with its own geometry');var selectionNode=t;if(typeof t.inherits==='function'&&t.inherits('DzBone')){need(typeof t.getSkeleton==='function','Bone skeleton API unavailable');t=t.getSkeleton();need(t&&t.inherits('DzFigure'),'Selected bone has no owning figure');}var o=t.getObject();need(o,'Selected target has no object or mesh; select the object with its own geometry');var sh=o.getCurrentShape();need(sh,'Selected target has no current shape');var geo=sh.getGeometry();need(geo,'Selected target has no geometry');need(env.pointersAreEqual(sh.getNode(),t),'Target shape must belong to the selected object');var materialCount=Number(sh.getNumMaterials()),groupCount=Number(geo.getNumMaterialGroups());need(isFinite(materialCount)&&materialCount>=0&&Math.floor(materialCount)===materialCount&&isFinite(groupCount)&&groupCount>=0&&Math.floor(groupCount)===groupCount,'Invalid target material surface count');need(materialCount>0,'Selected target has no material surfaces; select the object with its own mesh');var geometryShell=(typeof t.inherits==='function'&&t.inherits('DzGeometryShellNode'))||(typeof sh.inherits==='function'&&sh.inherits('DzGeometryShellShape')),shellSurfaces=groupCount===0&&geometryShell;need(groupCount>0||shellSurfaces,'Target geometry has no material groups');var mats=[],names=[],groupNames=[],seen={},groupSeen={};for(var i=0;i<materialCount;i++){var m=sh.getMaterial(i);need(m,'Missing target material');var name=String(m.name),owners=m.getShapeList();need(name&&!seen['$'+name],'Duplicate/invalid target surface name: '+name);seen['$'+name]=true;need(owners&&owners.length===1&&env.pointersAreEqual(owners[0],sh)||geometryShell&&shellMaterialOwners(env,owners,sh,t,m),'Shared material is unsupported');for(var mi=0;mi<mats.length;mi++)need(!env.pointersAreEqual(mats[mi],m),'Duplicate target material handle');mats.push(m);names.push(name);}for(var gi=0;gi<groupCount;gi++){var group=geo.getMaterialGroup(gi);need(group,'Missing target geometry material group');var groupName=String(group.name);need(groupName&&!groupSeen['$'+groupName],'Duplicate/invalid geometry material group: '+groupName);groupSeen['$'+groupName]=true;groupNames.push(groupName);need(seen['$'+groupName],'Geometry material group has no uniquely named target surface: '+groupName);}for(i=0;i<materialCount;i++)need(env.pointersAreEqual(sh.getMaterial(i),mats[i])&&String(mats[i].name)===names[i],'Target material mapping changed during read');for(gi=0;gi<groupCount;gi++)need(String(geo.getMaterialGroup(gi).name)===groupNames[gi],'Target geometry material groups changed during read');need(Number(sh.getNumMaterials())===materialCount&&Number(geo.getNumMaterialGroups())===groupCount,'Target surfaces changed during read');return {node:t,selectionNode:selectionNode,shape:sh,geometry:geo,geometryUri:geometryIdentity(sh,geo).uri,materials:mats,geometryShell:geometryShell,surfaceSource:shellSurfaces?'geometry-shell-shape':'geometry-material-groups',surfaceNames:names};}
 function snapshot(t){var out=[];for(var i=0;i<t.materials.length;i++){var m=t.shape.getMaterial(i),ps=m.getPropertyList(),props=[];need(ps&&typeof ps.length==='number'&&isFinite(ps.length)&&ps.length>=0&&Math.floor(ps.length)===ps.length,'Invalid target material property list');for(var j=0;j<ps.length;j++){var p=ps[j];need(typeof p.getNumKeys!=='function'||(p.getNumKeys()===0||(p.getNumKeys()===1&&Number(p.getKeyTime(0).valueOf())===0)),'Animated target material: '+String(p.name)+' keys='+p.getNumKeys());need(typeof p.getNumControllers!=='function'||p.getNumControllers()===0,'Controlled target material channel is unsupported');if(typeof p.getValue!=='function')continue;var map=typeof p.getMapValue==='function'?p.getMapValue():(String(p.className())==='DzImageProperty'?p.getValue():null);need(!map||!map.inherits('DzLayeredTexture'),'Layered target textures require separate acceptance');props.push({name:String(p.name),kind:String(p.className()),value:value(p),displayColor:typeof p.getColorValue==='function'?(function(){var cv=p.getColorValue();return [Number(cv.red)/255,Number(cv.green)/255,Number(cv.blue)/255];}()):null,map:map?String(map.getFilename()):null,gamma:map&&typeof map.getGamma==='function'?Number(map.getGamma()):null});}out.push({name:String(m.name),kind:String(m.className()),shaderName:typeof m.getBrickUserName==='function'?String(m.getBrickUserName()):null,properties:props});}return out;}
 function verify(plan,t,env){need(geometryIdentity(t.shape,t.geometry).uri===plan.geometryUri,'Result geometry mismatch');need(t.materials.length===plan.expected.length,'Result surface count mismatch');for(var i=0;i<plan.expected.length;i++){var found=false;for(var j=0;j<t.materials.length;j++)if(String(t.materials[j].name)===plan.expected[i].group)found=true;need(found,'Result surface missing: '+plan.expected[i].group);}return true;}
 function sharedTextures(plan,env){var out=[],seen={},records=plan.document.image_library||[];for(var i=0;i<records.length;i++){var im=records[i],maps=im.map||[],gamma=Number(im.map_gamma||0);need(isFinite(gamma),'Invalid texture gamma');for(var j=0;j<maps.length;j++){if(!maps[j].url)continue;var full=env.App.getContentMgr().findFile(uri(maps[j].url));need(full,'Missing texture '+maps[j].url);var image=env.App.getImageMgr().findImage(full);if(image){need(typeof image.getGamma==='function','Shared image gamma API unavailable');var actual=Number(image.getGamma());need(!gamma||Math.abs(actual-gamma)<0.000001,'Texture already loaded with different gamma');if(!seen['$'+full]){seen['$'+full]=true;out.push({image:image,gamma:actual});}}}}return out;}
 function run(env,plan,presetPath,force,options){
 options=options||{};var held=false,t=null,normalized=false,result={ok:false,status:'blocked',nativeExecuted:false,undoAccepted:false,fullRestorationVerified:false};
 function available(){if(result.undoStateUnknown)return false;try{if(env.UndoStack.canPushItems()===true&&env.UndoStack.isInUndoRedo()===false)return true;}catch(e){result.undoError=String(e);}held=false;result.undoStateUnknown=true;result.undoOwnershipLost=true;return false;}
 function owned(){need(available(),'Owned Undo unavailable; no further scene writes or blind accept/cancel');}
 function selection(n){owned();env.Scene.selectAllNodes(false);owned();n.select(true);owned();need(env.Scene.setPrimarySelection(n)!==false,'Cannot restore material selection');}
 function nativeCode(v){return v!==null&&v!==undefined&&typeof v.valueOf==='function'?v.valueOf():v;}
 try{
  need(!force,'Forced rollback is not supported by this native-only path');
  need(env.UndoStack.canPushItems()===false&&env.UndoStack.isInUndoRedo()===false,'Undo is busy');
  need(env.App.getRenderMgr().isRendering()===false&&env.Scene.isPlaying()===false,'Render/playback must be idle');
  if(options.cancelled&&options.cancelled()){result.cancelled=true;return result;}
  t=target(env);var identity=geometryIdentity(t.shape,t.geometry);
  need(t.materials.length>=plan.expected.length,'Saved surfaces exceed target surfaces');
  for(var i=0;i<plan.expected.length;i++){var found=false;for(var j=0;j<t.materials.length;j++)if(String(t.materials[j].name)===plan.expected[i].group)found=true;need(found,'Saved surface missing on target: '+plan.expected[i].group);}
  if(options.cancelled&&options.cancelled()){result.cancelled=true;return result;}
  result.undoBeginAttempted=true;env.beginUndo();held=true;owned();normalized=!env.pointersAreEqual(t.node,t.selectionNode);
  try{if(normalized)selection(t.node);owned();result.nativeExecuted=true;result.nativeCode=nativeCode(env.App.getAssetIOMgr().doLoad(presetPath,env.MergeFile));owned();need(typeof result.nativeCode==='number'&&isFinite(result.nativeCode)&&result.nativeCode===0,'Native material preset failed: '+String(result.nativeCode));}
  catch(loadError){result.nativeError=String(loadError);throw loadError;}
  finally{if(normalized&&available()){try{selection(t.selectionNode);}catch(selectionError){result.selectionRestoreError=String(selectionError);if(!result.nativeError)throw selectionError;}}}
  result.ok=true;result.status='applied';result.message='Native material preset applied. Undo is available.';
 }catch(e){result.error=String(e);result.ok=false;result.status=result.nativeExecuted?'native-error':'blocked';if(result.undoBeginAttempted&&!held&&!result.nativeExecuted)result.undoStateUnknown=true;}
 finally{if(held&&available()){held=false;try{env.acceptUndo('SaveGuard - Apply materials');result.undoAccepted=true;}catch(ue){result.ok=false;result.status='recovery-required';result.undoError=String(ue);result.undoStateUnknown=true;}}if(result.undoStateUnknown){result.ok=false;result.status='recovery-required';result.message=result.error||'Undo state is unknown; no further scene writes or blind accept/cancel.';}}
 return result;
 }

 return {selectSource:selectSource,compile:compile,target:target,snapshot:snapshot,verify:verify,run:run};
}());

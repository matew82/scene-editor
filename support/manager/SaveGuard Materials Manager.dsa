var SaveGuardMaterialsManager=(function(){
 function need(v,m){if(!v)throw Error(m);}
 function create(env,info,profile,newStager){
  need(profile&&profile.verified===true&&profile.undoRedoVerified===true&&profile.actionKey==='applyMaterials'&&profile.buildId===String(env.buildId)&&profile.platform===env.platform,'Materials are not accepted on this host');
  need(info.context.lowMemoryMode===false,'Materials require Low RAM OFF');
  var deep=info.context.deepValidation===true,context=info.context,doc=context.planningDocument,provider=context.provider,resolver=info.resolver,sourceId=info.request.sourceId,initial=SaveGuardMaterials.target(env),closed=false,busy=false,plan=null,execution=null,snapshot=null,stager=SaveGuardShapePresetIO.create(env).snapshotStaging(),issued=[];
  function live(checkMaterials){need((context.deepValidation===true)===deep&&!closed&&info.context===context&&context.planningDocument===doc&&context.provider===provider&&info.resolver===resolver&&info.request.sourceId===sourceId,'Material source context changed');need(provider.verifySource()===true&&resolver.verifyAll()===true,'Material source or dependency changed');var current=SaveGuardMaterials.target(env);need(env.pointersAreEqual(current.node,initial.node)&&env.pointersAreEqual(current.shape,initial.shape)&&env.pointersAreEqual(current.geometry,initial.geometry)&&current.geometryUri===initial.geometryUri,'Material target changed; prepare again');if(checkMaterials){need(current.materials.length===initial.materials.length,'Material target surfaces changed');for(var mi=0;mi<current.materials.length;mi++)need(env.pointersAreEqual(current.materials[mi],initial.materials[mi]),'Material target surface identity changed');}}
  function cancelled(fn){if(fn&&fn()===true){var e=Error('Materials cancelled before import');e.code='CANCELLED';throw e;}}
  var wrapper={
   buildMaterials:function(source,id){need(!busy&&!issued.length,"Finish the prepared material action before rebuilding");live();need(source===doc&&id===sourceId,'Material source identity changed');plan=SaveGuardMaterials.compile(doc,id,function(file,dependency){return resolver.resolveExternal(file,dependency);},function(file){return resolver.resolveAssetDocument(file);},initial.geometryUri,(function(){var names=[];for(var ti=0;ti<initial.materials.length;ti++)names.push(String(initial.materials[ti].name));return names;}()),initial.geometryShell===true);var captured=stager.capture(plan.document);if(snapshot)stager.discard(snapshot);snapshot=captured;var expected=[];for(var mi=0;mi<plan.expected.length;mi++)expected.push({group:plan.expected[mi].group});execution={geometryUri:plan.geometryUri,expected:expected};return {plan:plan};},
   prepare:function(request,isCancelled){live();cancelled(isCancelled);need(!busy&&request&&request.kind==='materials'&&request.plan===plan&&plan,'Unknown material preparation');need(request.source.verify()===true,'Saved source changed');var token=stager.create(snapshot),receipt={kind:'materials',stagedPath:token.path};try{live();cancelled(isCancelled);issued.push({receipt:receipt,token:token,used:false,source:request.source});return receipt;}catch(e){var removed=false;try{removed=stager.removeOwned(token)===true;if(!removed)e.cleanupError='Owned temporary cleanup returned false';}catch(cleanupError){e.cleanupError=String(cleanupError);}if(typeof print==='function')print('SaveGuard materials CLEANUP RESULT: '+JSON.stringify({temporaryRemoved:removed,error:e.cleanupError||null,nativeExecuted:false,undoAccepted:false}));throw e;}},
   apply:function(receipt,isCancelled){live(true);cancelled(isCancelled);need(!busy,'Materials action busy');var item=null;for(var i=0;i<issued.length;i++)if(issued[i].receipt===receipt)item=issued[i];need(item&&!item.used,'Unknown or consumed material receipt');item.used=true;need(item.source.verify()===true&&stager.verify(item.token)===true,'Material payload changed');live(true);cancelled(isCancelled);busy=true;try{var nativeEnv={App:env.App,Scene:env.Scene,UndoStack:env.UndoStack,MergeFile:Number(env.DzAssetIOMgr.MergeFile),pointersAreEqual:env.pointersAreEqual,beginUndo:env.beginUndo,acceptUndo:env.acceptUndo,cancelUndo:env.cancelUndo};var result=SaveGuardMaterials.run(nativeEnv,execution,item.token.path,false,{deep:deep,cancelled:isCancelled});result.nativeProfile=profile.evidenceId;item.result=result;if(typeof print==='function')print('SaveGuard materials NATIVE RESULT: '+JSON.stringify(result));return result;}finally{busy=false;}},
   release:function(receipt){for(var i=0;i<issued.length;i++)if(issued[i].receipt===receipt){var item=issued[i],removed=false,error=null;try{removed=stager.removeOwned(item.token)===true;if(!removed)error='Owned temporary cleanup returned false';}catch(cleanupError){error=String(cleanupError);}issued.splice(i,1);if(item.result){item.result.temporaryRemoved=removed;if(error)item.result.cleanupError=error;}if(typeof print==='function')print('SaveGuard materials CLEANUP RESULT: '+JSON.stringify({temporaryRemoved:removed,error:error,nativeExecuted:item.result?item.result.nativeExecuted:false,undoAccepted:item.result?item.result.undoAccepted:false}));return removed;}return false;},
   close:function(){if(closed)return;while(issued.length)wrapper.release(issued[0].receipt);closed=true;plan=null;initial=null;if(snapshot)stager.discard(snapshot);snapshot=null;execution=null;}
  };return wrapper;
 }
 return {create:create};
}());

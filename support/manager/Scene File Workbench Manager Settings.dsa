  draft.loadCacheMode=draft.loadCacheMode==='off'?'off':'all';draft.propertySource=draft.propertySource==='Own'?'Own':'DAZ';draft.propertyView=draft.propertyView==='TreeView'?'TreeView':draft.propertyView==='PlainControls'?'PlainControls':'Controls';draft.saveSceneFilters=draft.saveSceneFilters!==false;draft.sceneListMode=draft.sceneListMode==='filenames'?'filenames':'icons';
  var defaults=options.defaultFigureNames||(typeof SaveGuardSettings!=='undefined'?SaveGuardSettings.characterNames:[]);draft.recognizedCharacterNames=SaveGuardManagerModel.figureNames(draft.recognizedCharacterNames||defaults);
  dlg.showAcceptButton(false);dlg.showCancelButton(false);var actions=u.panel(dlg,true);actions.layout.spacing=20;actions.layout.addStretch(1);var save=u.button(actions.widget,'Save Settings'),cancel=u.button(actions.widget,'Cancel');cancel.minHeight=52;cancel.maxHeight=52;cancel.minWidth=160;cancel.maxWidth=160;cancel.autoDefault=false;save.minHeight=52;save.maxHeight=52;save.minWidth=220;save.maxWidth=220;save.getWidget().styleSheet='QPushButton { color:#F1F1F1; background-color:#33483D; border:1px solid #69B58A; border-radius:4px; padding:5px 12px; font-weight:bold; } QPushButton:hover { background-color:#3D5949; } QPushButton:pressed { background-color:#293C32; } QPushButton:disabled { color:#929397; background-color:#292A2D; border-color:#696A70; }';dlg.setDefaultButton(save);actions.layout.addWidget(save);actions.layout.addWidget(cancel);dlg.addWidget(u.heading(dlg,"<h2><font color='#B9A0E8'>Scene File Workbench Settings</font></h2>"));
  var source=u.panel(dlg,true),sourceLabel=u.heading(source.widget,'Property definitions'),daz=u.button(source.widget,'DAZ Cache',true),ownCache=u.button(source.widget,'Own Cache',true);source.layout.addWidget(sourceLabel);source.layout.addWidget(daz);source.layout.addWidget(ownCache);dlg.addWidget(source.widget);
  var sceneList=u.panel(dlg,true),sceneListLabel=u.heading(sceneList.widget,'Scene list'),sceneIcons=u.button(sceneList.widget,'With icons',true),sceneNames=u.button(sceneList.widget,'Filenames only',true);sceneList.layout.addWidget(sceneListLabel);sceneList.layout.addWidget(sceneIcons);sceneList.layout.addWidget(sceneNames);dlg.addWidget(sceneList.widget);sceneNames.toolTip='Compact scene filenames without thumbnail images. Recent files keep their yellow marker and double-click still renames.';
  var view=u.panel(dlg,true),viewLabel=u.heading(view.widget,'Property interface'),controls=u.button(view.widget,'Sliders with icons',true),plain=u.button(view.widget,'Plain sliders',true),tree=u.button(view.widget,'TreeView',true);view.layout.addWidget(viewLabel);view.layout.addWidget(controls);view.layout.addWidget(plain);view.layout.addWidget(tree);dlg.addWidget(view.widget);
  var rememberRow=u.panel(dlg,true),rememberFilters=u.button(rememberRow.widget,'Remember scene filters and sorting',true);rememberFilters.text='Remember scene filters and sorting';rememberFilters.toolTip='Restore scene name, Important, date/size limits, subfolders and sorting when Scene File Workbench opens. Object conditions are never saved. Turning this off clears the saved filters without changing this session.';rememberRow.layout.addWidget(rememberFilters);dlg.addWidget(rememberRow.widget);
  var loading=u.panel(dlg,true),preparedCache=u.button(loading.widget,'Prepared loading cache',true);loading.layout.addWidget(preparedCache);dlg.addWidget(loading.widget);preparedCache.toolTip='Reuse validated prepared saved-content payloads. CTRL source-frame and deep-validation requests prepare fresh data.';
  var advancedRow=u.panel(dlg,true),advanced=u.button(advancedRow.widget,'Advanced figure configuration');advancedRow.layout.addWidget(advanced);dlg.addWidget(advancedRow.widget);
  var cacheHeading=u.heading(dlg,"<h3><font color='#B9A0E8'>Cache maintenance</font></h3>");dlg.addWidget(cacheHeading);
  var missingRow=u.panel(dlg,true),missing=u.button(missingRow.widget,'Clear caches for missing files');missingRow.layout.addWidget(missing);dlg.addWidget(missingRow.widget);
  var scope=u.panel(dlg,true),folder=u.button(scope.widget,'Clear current-folder caches'),recursive=u.button(scope.widget,'Include subfolders: Off',true);scope.layout.addWidget(folder);scope.layout.addWidget(recursive);dlg.addWidget(scope.widget);folder.enabled=!!currentFolder;recursive.checked=false;folder.toolTip='Clear scene caches in the current folder, optionally including subfolders.';
  var allRow=u.panel(dlg,false),all=u.button(allRow.widget,'Clear all caches'),usage=u.label(allRow.widget,'');allRow.layout.spacing=0;allRow.layout.addWidget(all);allRow.layout.addSpacing(10);allRow.layout.addWidget(usage);allRow.layout.addSpacing(10);dlg.addWidget(allRow.widget);all.toolTip='Clear owned scene, shared definition and prepared loading caches. Notes, Important flags, Settings, source scenes and backups are preserved.';
  var feedback=u.label(dlg,'');feedback.visible=false;dlg.addWidget(feedback);dlg.addWidget(actions.widget);links.add(save,'clicked()',function(){saveRequested=true;dlg.close();});links.add(cancel,'clicked()',function(){saveRequested=false;dlg.close();});
  function refresh(remeasure){sceneIcons.checked=draft.sceneListMode==='icons';sceneNames.checked=draft.sceneListMode==='filenames';rememberFilters.checked=draft.saveSceneFilters;preparedCache.checked=draft.loadCacheMode!=='off';daz.checked=draft.propertySource==='DAZ';ownCache.checked=draft.propertySource==='Own';controls.checked=draft.propertyView==='Controls';plain.checked=draft.propertyView==='PlainControls';tree.checked=draft.propertyView==='TreeView';if(!usageSnapshot||remeasure)usageSnapshot=model.cacheUsage(options.guard);var x=usageSnapshot;usage.text='Cache usage: '+bytesText(x.bytes)+' in '+x.files+' files'+(x.unknownSizeFiles?' ('+x.unknownSizeFiles+' sizes unavailable)':'');}
  function cleanup(kind){if(maintenanceBusy)return;if(kind==='all'&&env.MessageBox.question('Clear all Scene File Workbench caches? Future inspection and property discovery will be slower while caches are rebuilt. Notes, Important flags, Settings, scenes and backups will not be removed.','Scene File Workbench - Clear caches','Clear all','Cancel')!==0)return;maintenanceBusy=true;missing.enabled=false;folder.enabled=false;all.enabled=false;recursive.enabled=false;advanced.enabled=false;try{var fn=function(guard){return model.cleanup(kind,currentFolder,recursive.checked===true,guard||options.guard||function(){});};var result=options.run?options.run('Clear Scene File Workbench caches',fn):fn(options.guard);cleaned=true;feedback.text='Cleanup '+result.status+': '+result.removed.length+' entries removed ('+bytesText(result.removedKnownBytes)+').'+(result.error?' '+result.error:'');feedback.visible=true;if(options.onCacheCleared)options.onCacheCleared(result);refresh(true);}catch(e){u.warn(e);try{refresh(true);}catch(usageError){usage.text='Cache usage unavailable: '+String(usageError.message||usageError);}}finally{maintenanceBusy=false;missing.enabled=true;folder.enabled=!!currentFolder;all.enabled=true;recursive.enabled=true;advanced.enabled=true;}}
  links.add(sceneIcons,'clicked()',function(){draft.sceneListMode='icons';refresh();});links.add(sceneNames,'clicked()',function(){draft.sceneListMode='filenames';refresh();});
  links.add(rememberFilters,'clicked()',function(){draft.saveSceneFilters=rememberFilters.checked===true;refresh();});
  links.add(preparedCache,'clicked()',function(){draft.loadCacheMode=preparedCache.checked?'all':'off';refresh();});
  links.add(daz,'clicked()',function(){draft.propertySource='DAZ';refresh();});links.add(ownCache,'clicked()',function(){draft.propertySource='Own';refresh();});links.add(controls,'clicked()',function(){draft.propertyView='Controls';refresh();});links.add(plain,'clicked()',function(){draft.propertyView='PlainControls';refresh();});links.add(tree,'clicked()',function(){draft.propertyView='TreeView';refresh();});
  links.add(advanced,'clicked()',function(){try{var value=figureManager(env,draft.recognizedCharacterNames,defaults);if(value!==null)draft.recognizedCharacterNames=value;}catch(e){u.warn(e);}});
  links.add(recursive,'clicked()',function(){recursive.text='Include subfolders: '+(recursive.checked?'On':'Off');});links.add(missing,'clicked()',function(){cleanup('nonexistent');});links.add(folder,'clicked()',function(){if(currentFolder)cleanup('folder');});links.add(all,'clicked()',function(){cleanup('all');});

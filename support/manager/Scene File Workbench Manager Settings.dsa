  var scroll=new env.DzScrollArea(dlg);scroll.widgetResizable=true;scroll.setHorizontalScrollbarDisplay(false);scroll.setVerticalScrollbarDisplay(true);scroll.minHeight=210;var body=u.panel(scroll,false),rows=u.panel(body.widget,false);body.layout.margin=0;body.layout.spacing=0;body.layout.addWidget(rows.widget,0);body.layout.addStretch(1);scroll.setWidget(body.widget);dlg.addWidget(scroll,1);
  function add(condition){condition=condition||{};var row=u.panel(rows.widget,true),label=u.edit(row.widget,condition.label||''),match=new env.DzComboBox(row.widget),presence=new env.DzComboBox(row.widget),remove=new env.DzPushButton(row.widget),entry={widget:row.widget,label:label,match:match,presence:presence,active:true};SceneEditorManagerWidgets.applyIcon(env,remove,(options.projectRoot||env.sceneEditorRoot)+'/icons/Scene File Workbench Remove Filter.png','Remove condition',{iconSize:26,buttonSize:34});remove.accessibleName='Remove condition';label.placeholderText='Object or character label';match.addItem('Exact label');match.addItem('Label prefix');match.currentItem=condition.match==='prefix'?1:0;presence.addItem('Present');presence.addItem('Absent');presence.currentItem=condition.presence==='absent'?1:0;row.layout.addWidget(label,1);row.layout.addWidget(match);row.layout.addWidget(presence);row.layout.addWidget(remove);rows.layout.addWidget(row.widget);conditions.push(entry);links.add(remove,'clicked()',function(){entry.active=false;row.widget.hide();});}
  var footer=u.panel(dlg,false);footer.layout.margin=0;footer.layout.spacing=10;var addButton=new env.DzPushButton(footer.widget);addButton.text='Add object condition';addButton.minHeight=34;addButton.maxHeight=34;addButton.autoDefault=false;addButton.getWidget().styleSheet='QPushButton { color:#F0F0F0; font-weight:bold; background-color:#A95716; border:1px solid #EFAD67; border-radius:4px; padding:3px 9px; } QPushButton:hover:enabled { border-width:2px; } QPushButton:pressed:enabled { background-color:#55565A; } QPushButton:disabled { color:#929397; background-color:#292A2D; border:1px solid #515256; font-weight:normal; }';footer.layout.addWidget(addButton);var actions=u.panel(footer.widget,true);actions.layout.margin=0;actions.layout.addStretch(1);var cancel=new env.DzPushButton(actions.widget),apply=new env.DzPushButton(actions.widget);cancel.text='Cancel';apply.text='Apply Filters';cancel.setFixedSize(130,34);apply.setFixedSize(130,34);cancel.autoDefault=false;apply.autoDefault=false;actions.layout.addWidget(cancel);actions.layout.addWidget(apply);footer.layout.addWidget(actions.widget);dlg.addWidget(footer.widget);links.add(cancel,'clicked()',function(){applyRequested=false;dlg.close();});links.add(apply,'clicked()',function(){applyRequested=true;dlg.close();});
  for(var i=0;i<(draft.objects||[]).length;i++)add(draft.objects[i]);links.add(addButton,'clicked()',function(){add();});links.add(descendants,'clicked()',function(){descendants.text='Include subfolders: '+(descendants.checked?'On':'Off');});

 }
 function dateText(ms){if(typeof ms!=='number'||!isFinite(ms))return'';var d=new Date(ms);function z(v){return('0'+v).slice(-2);}return d.getFullYear()+'-'+z(d.getMonth()+1)+'-'+z(d.getDate());}
 function dayBoundary(text,end){text=String(text).replace(/^\s+|\s+$/g,'');if(!text)return undefined;var m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(text);if(!m)throw Error('Use YYYY-MM-DD for dates.');var y=Number(m[1]),month=Number(m[2])-1,day=Number(m[3]),d=new Date(0);d.setFullYear(y,month,day);d.setHours(0,0,0,0);if(d.getFullYear()!==y||d.getMonth()!==month||d.getDate()!==day)throw Error('Invalid calendar date.');if(end)d.setDate(d.getDate()+1);return d.getTime()-(end?1:0);}
 function sizeBytes(text){text=String(text).replace(/^\s+|\s+$/g,'');if(!text)return undefined;var n=Number(text);if(!isFinite(n)||n<0||!text.match(/^(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?$/i))throw Error('Size must be a nonnegative number of MB.');var bytes=n*1000000;if(!isFinite(bytes))throw Error('Size boundary is not finite.');return bytes;}

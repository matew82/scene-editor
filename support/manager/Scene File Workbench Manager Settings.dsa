/* Scene File Workbench dialogs. Adapted from current SaveGuard Manager's native settings/figure registry UI.
   No scene load/value setters, source writes, or SaveGuard settings writes. */
var SceneEditorManagerDialogs=(function(){
 var has=Object.prototype.hasOwnProperty;
 function own(o,k){return has.call(o,k);}function clone(o){return JSON.parse(JSON.stringify(o||{}));}
 function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
 var toggleStyle='QPushButton { color:#F1F1F1; background-color:#37383C; border:1px solid #696A70; border-radius:4px; padding:5px; } QPushButton:checked { background-color:#33483D; border-color:#69B58A; font-weight:bold; }';
 function helpers(env,iconRoot){
  function links(){var all=[],active=true;return{add:function(o,s,f){var wrapped=function(){if(active)return f.apply(null,arguments);};env.connect(o,s,wrapped);all.push([o,s,wrapped]);},clear:function(){active=false;for(var i=all.length-1;i>=0;i--)try{env.disconnect(all[i][0],all[i][1],all[i][2]);}catch(ignore){}all=[];}};}
  function dialog(title,w,h){var d=new env.DzBasicDialog();d.caption=title;d.minWidth=w;d.minHeight=h;d.sizeGripEnabled=true;d.showHelpButton(false);d.showCancelButton(true);d.setCancelButtonText('Cancel');var f=d.font;if(f){f.pointSize=Math.max(12,Number(f.pointSize)||12);d.font=f;}return d;}
  function panel(parent,horizontal){var w=new env.DzGroupBox(parent);w.flat=true;var l=new env[horizontal?'DzHBoxLayout':'DzVBoxLayout'](w);l.margin=6;l.spacing=8;return{widget:w,layout:l};}
  function label(parent,text){var l=new env.DzLabel(parent);l.text=text;l.wordWrap=true;return l;}
  function heading(parent,text){var l=label(parent,text);l.alignment=env.DzWidget.AlignCenter;return l;}
  function button(parent,text,toggle){var b=new env.DzPushButton(parent);b.text=text;b.minHeight=34;if(toggle){b.setCheckable(true);b.getWidget().styleSheet=toggleStyle;}else SceneEditorManagerWidgets.applyButtonIcon(env,b,text,iconRoot||env.sceneEditorRoot);return b;}
  function edit(parent,text){var e=new env.DzLineEdit(parent);e.text=String(text===undefined?'':text);return e;}
  function warn(error){env.MessageBox.warning(String(error&&error.message||error),'Scene File Workbench','OK');}
  return{links:links,dialog:dialog,panel:panel,label:label,heading:heading,button:button,edit:edit,warn:warn};
 }
 function figureManager(env,names,defaults){
  var u=helpers(env),model=SaveGuardManagerModel,draft=model.figureNames(names),result=null,dlg=u.dialog('Scene File Workbench - Supported Figures',720,540),links=u.links(),entries=[],selectedName=null;
  dlg.showAcceptButton(false);var title=u.label(dlg,"<h2><font color='#B9A0E8'>Supported Figures</font></h2>");title.alignment=env.DzWidget.AlignCenter;dlg.addWidget(title);
  var list=new env.DzListView(dlg);list.selectionMode=env.DzListView.Single;list.rootIsDecorated=false;list.addColumn('Figure family');list.addColumn('Internal name');list.setSorting(-1);list.setColumnWidth(0,270);list.setColumnWidth(1,320);dlg.addWidget(list,1);
  var row=u.panel(dlg,true),add=u.button(row.widget,'Add Selected Figure'),remove=u.button(row.widget,'Remove'),reset=u.button(row.widget,'Restore missing defaults');row.layout.addWidget(add);row.layout.addWidget(remove);row.layout.addWidget(reset);dlg.addWidget(row.widget);
  var status=u.label(dlg,'Changes stay in this Settings draft until Save Settings.');dlg.addWidget(status);var actions=u.panel(dlg,true),cancel=u.button(actions.widget,'Close without saving'),use=u.button(actions.widget,'Use this list');actions.layout.addStretch(1);actions.layout.addWidget(cancel);actions.layout.addWidget(use);dlg.addWidget(actions.widget);
  function populate(){selectedName=null;entries=[];list.clear();for(var i=draft.length-1;i>=0;i--){var item=new env.DzListViewItem(list);item.setText(0,model.figureFamily(draft[i]));item.setText(1,draft[i]);entries.push({item:item,name:draft[i]});}remove.enabled=false;}
  function action(fn){try{fn();populate();status.text='Draft updated. Use this list, then Save Settings to apply.';}catch(e){u.warn(e);}}
  links.add(list,'currentChanged(DzListViewItem*)',function(item){selectedName=null;for(var i=0;i<entries.length;i++)if(entries[i].item===item)selectedName=entries[i].name;remove.enabled=selectedName!==null;});
  links.add(add,'clicked()',function(){action(function(){if(!env.Scene||typeof env.Scene.getPrimarySelection!=='function')throw Error('Current figure selection API is unavailable.');draft=model.addFigureName(draft,model.selectedFigureName(env.Scene.getPrimarySelection()));});});
  links.add(remove,'clicked()',function(){action(function(){var at=draft.indexOf(selectedName);if(at<0)throw Error('Select a registry entry.');draft.splice(at,1);});});
  links.add(reset,'clicked()',function(){action(function(){draft=model.resetFigureNames(draft,defaults);});});
  links.add(cancel,'clicked()',function(){dlg.close();});links.add(use,'clicked()',function(){result=model.figureNames(draft);dlg.close();});
  try{populate();dlg.exec();}finally{links.clear();}return result;
 }
 function bytesText(value){if(typeof value!=='number'||!isFinite(value)||value<0)return'unknown';if(value<1024)return value+' B';if(value<1048576)return(value/1024).toFixed(1)+' KiB';return(value/1048576).toFixed(1)+' MiB';}

/* Disposable Scene Editor projection cache. Copied SG document validation; working-file ownership instead of immutable backup-folder ownership. */
var SaveGuardInspectionCache=(function(){
 var filename='inspection-projection.json',limit=9007199254740991;
 function normal(p){return String(p||'').replace(/\\/g,'/').replace(/\/$/,'');}function key(p){return normal(p).toLowerCase();}function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}function isArray(o){return Object.prototype.toString.call(o)==='[object Array]';}function need(v,m){if(!v)throw Error('Scene Editor inspection cache: '+m);}
 function stat(p,dir){var f=new DzFileInfo(p),c=normal(f.canonicalFilePath());need(f.exists()&&!f.isSymLink()&&c&&key(c)===key(f.absoluteFilePath())&&(dir?f.isDir():f.isFile()),'missing or redirected owned cache path');return{path:c,size:Number(f.size()),modified:String(f.lastModified())};}
 function ownedHeader(h,folder,m){var owner=m&&m.sceneEditor;return !!(owner&&owner.schema===1&&typeof owner.id==='string'&&typeof owner.sourcePath==='string'&&h&&(h.schema==='inspection-projection-import-3-20261025'||h.schema==='inspection-projection-settings-4-20261108')&&h.backup===owner.id&&key(h.source)===key(owner.sourcePath)&&h.sceneEditorEvidence!==undefined&&(h.dazMajor===4||h.dazMajor===6)&&h.options&&isArray(h.options.recognizedCharacterNames));}
    function validDocument(d){
        if(!d||typeof d!=="object"||!isArray(d.node_library)||!d.scene||!isArray(d.scene.nodes)||!isArray(d.scene.extra)||!d.renderDetails)return false;
        if(typeof SaveGuardDerivedMetadata!=="undefined"&&!SaveGuardDerivedMetadata.validSummary(d.savedSceneInfo))return false;
        var allowed={file_version:1,node_library:1,scene:1,renderInfo:1,savedSceneInfo:1,renderDetails:1,timeline:1,emission:1,savedSettingsData:1},k;for(k in d)if(own(d,k)&&!allowed[k])return false;
        // Current Fast Inspect retains a compact settings snapshot, not a second full DUF.
        if(own(d,'savedSettingsData')){var sd=d.savedSettingsData;if(!sd||typeof sd!=='object'||isArray(sd)||!isArray(sd.node_library)||!sd.scene||typeof sd.scene!=='object'||isArray(sd.scene)||!isArray(sd.scene.nodes)||!isArray(sd.scene.extra))return false;for(k in sd)if(own(sd,k)&&k!=='node_library'&&k!=='scene')return false;for(k in sd.scene)if(own(sd.scene,k)&&k!=='nodes'&&k!=='extra'&&k!=='current_camera')return false;if(own(sd.scene,'current_camera')&&typeof sd.scene.current_camera!=='string')return false;}
        if(d.renderDetails.error!==undefined){if(typeof d.renderDetails.error!=='string')return false;}else{var rows=d.renderDetails.rows;if(!isArray(rows))return false;for(var ri=0;ri<rows.length;ri++){var row=rows[ri];if(!row||typeof row.label!=='string'||!isArray(row.children))return false;for(var ci=0;ci<row.children.length;ci++)if(!row.children[ci]||typeof row.children[ci].label!=='string'||typeof row.children[ci].value!=='string')return false;}}
        if(d.emission&&(!isArray(d.emission.objects)||d.emission.objects.some(function(v){return !v||typeof v!=='object';})))return false;
        var queue=[{v:d}],active=[];while(queue.length){var row=queue.pop(),v=row.v;if(row.exit){active.pop();continue;}if(typeof v==='number'&&!isFinite(v))return false;if(v&&typeof v==='object'){for(var ai=0;ai<active.length;ai++)if(active[ai]===v)return false;active.push(v);queue.push({exit:true});for(k in v)if(own(v,k)){if(k==='__proto__'||k==='constructor'||k==='prototype')return false;queue.push({v:v[k]});}}else if(v!==null&&typeof v!=='string'&&typeof v!=='number'&&typeof v!=='boolean')return false;}
        var sets=[d.node_library,d.scene.nodes];if(own(d,'savedSettingsData')){sets.push(d.savedSettingsData.node_library);sets.push(d.savedSettingsData.scene.nodes);}for(var si=0;si<sets.length;si++){for(var i=0;i<sets[si].length;i++){var n=sets[si][i];if(!n||typeof n!=='object'||typeof n.id!=='string')return false;for(var j=0;j<6;j++){k=['name','label','type','url','parent','conform_target'][j];if(own(n,k)&&typeof n[k]!=='string')return false;}}}return true;
    }
function validEnvelope(r){return !!r&&validDocument(r.document);}
 function slotName(name,h){name=name||filename;need(name===filename||name==='inspection-projection-daz4.json'||name==='inspection-projection-daz6.json','invalid projection filename');if(h&&name!==filename)need(name==='inspection-projection-daz'+h.dazMajor+'.json','projection major mismatch');return name;}
 function readOwned(folder,m,name){name=slotName(name);var d=stat(folder,true),f=stat(normal(folder)+'/'+name,false);need(key(f.path)===key(d.path+'/'+name),'cache path escaped owned folder');var r=SaveGuardStorage.readJSON(f.path,limit);need(validEnvelope(r)&&ownedHeader(r.header,folder,m),'unowned or invalid cache retained');slotName(name,r.header);return{value:r,stat:f};}
 function inventory(folder,m){var names=[filename,'inspection-projection-daz4.json','inspection-projection-daz6.json'],out=[];for(var i=0;i<names.length;i++){var name=names[i],f=new DzFileInfo(normal(folder)+'/'+name);if(f.exists()){var r=readOwned(folder,m,name);out.push([name,r.stat.size,r.stat.modified]);}}return out;}
 function write(folder,m,h,d,name){name=slotName(name,h);need(ownedHeader(h,folder,m)&&validDocument(d),'invalid cache publication');stat(folder,true);var path=normal(folder)+'/'+name,info=new DzFileInfo(path);if(info.exists()){var before=readOwned(folder,m,name),again=readOwned(folder,m,name);need(JSON.stringify(before.stat)===JSON.stringify(again.stat)&&JSON.stringify(before.value)===JSON.stringify(again.value),'cache changed before replacement');need(new DzFile(path).remove()===true,'cannot replace owned projection');}SaveGuardStorage.writeJSONNew(folder,name,{header:h,document:d});var saved=readOwned(folder,m,name);need(JSON.stringify(saved.value)===JSON.stringify({header:h,document:d}),'cache reread verification failed');return true;}
 return{filename:filename,limit:limit,validDocument:validDocument,ownedHeader:ownedHeader,readOwned:readOwned,inventory:inventory,write:write};
}());

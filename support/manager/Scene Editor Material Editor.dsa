/* Saved object materials. Shared property UI and exact-token DUF writes; external assets stay read-only. */
var SceneEditorMaterialEditor=(function(){
 var C=SceneEditorCore;
 function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}function array(x){return Object.prototype.toString.call(x)==='[object Array]';}function clone(x){return JSON.parse(JSON.stringify(x));}function fail(m){C.fail('MATERIAL_EDITOR',m);}
 function local(value){if(typeof value!=='string'||value.charAt(0)!=='#'||value.indexOf('?',1)>=0||value.indexOf('#',1)>=0)return null;try{return decodeURIComponent(value.substring(1));}catch(e){return null;}}
 function readableAssetName(value){if(value===null)return 'None';var raw=String(value),at=raw.lastIndexOf('#'),name=at>=0?raw.substring(at+1):raw.replace(/\\/g,'/').split('/').pop();try{name=decodeURIComponent(name);}catch(invalid){name=name.replace(/(?:%[0-9a-fA-F]{2})+/g,function(run){try{return decodeURIComponent(run);}catch(e){return run;}});}if(at<0)name=name.replace(/\.(?:dsf|duf)$/i,'');return name||'Unknown';}
 function get(o,p){for(var i=0;o!==undefined&&o!==null&&i<p.length;i++)o=o[p[i]];return o;}
 function groups(value){var out=[],a=typeof value==='string'?value.split('/'):[];for(var i=0;i<a.length;i++)if(a[i])out.push(a[i]);return out;}
 function createModel(doc,io,guard,objectId){
  var scene=doc.data.scene||{},nodes=scene.nodes||[],node=null,geometry={},i,j,records=[],seen={},dependencies={},bindings=[],models={},props={},order=[],choices=[],warnings=[];guard=guard||function(){};
  var geometryOwners={};for(var ownerAt=0;ownerAt<nodes.length;ownerAt++){guard('Index saved material ownership');for(var geometryAt=0;geometryAt<(nodes[ownerAt].geometries||[]).length;geometryAt++){var ownedId=nodes[ownerAt].geometries[geometryAt].id;geometryOwners['$'+ownedId]=(geometryOwners['$'+ownedId]||0)+1;}}for(i=0;i<nodes.length;i++)if(nodes[i].id===objectId){if(node)fail('The selected object identity is ambiguous.');node=nodes[i];}if(!node)fail('The selected object is no longer present.');
  for(i=0;i<(node.geometries||[]).length;i++){var geo=node.geometries[i];if(typeof geo.id!=='string'||own(geometry,'$'+geo.id)||geometryOwners['$'+geo.id]!==1)fail('Geometry identity is missing or ambiguous.');geometry['$'+geo.id]=geo;}
  var saved=scene.materials||[],materialIds={},surfaceOwners={};for(var savedAt=0;savedAt<saved.length;savedAt++)materialIds['$'+saved[savedAt].id]=(materialIds['$'+saved[savedAt].id]||0)+1;for(i=0;i<saved.length;i++){var record=saved[i],gid=local(record.geometry);if(!gid||!own(geometry,'$'+gid))continue;if(typeof record.id!=='string'||!record.id||seen['$'+record.id]||materialIds['$'+record.id]!==1)fail('Saved material identity is missing or ambiguous.');seen['$'+record.id]=true;if(!array(record.groups)||!record.groups.length)fail('A saved material has no surface names.');var names=[],surfaceSeen={};for(j=0;j<record.groups.length;j++){if(typeof record.groups[j]!=='string'||!record.groups[j]||surfaceSeen['$'+record.groups[j]])fail('Saved surface names are missing or ambiguous.');surfaceSeen['$'+record.groups[j]]=true;var surfaceKey=JSON.stringify([gid,record.groups[j]]);if(surfaceOwners['$'+surfaceKey])fail('A surface has multiple saved material bindings.');surfaceOwners['$'+surfaceKey]=true;names.push(record.groups[j]);}records.push({index:i,record:record,geometryId:gid,label:names.join(', '),key:JSON.stringify([gid,record.id])});}
  if(!records.length)fail('This object has no saved material bindings.');var labels={};for(i=0;i<records.length;i++)labels['$'+records[i].label]=(labels['$'+records[i].label]||0)+1;for(i=0;i<records.length;i++)if(labels['$'+records[i].label]>1)records[i].label+=' ('+records[i].geometryId+')';
  function external(path){if(dependencies['$'+path])return dependencies['$'+path];guard('Read material definition');var data,stamp=io.cacheStamp?io.cacheStamp(path):null,fallback=null;if(typeof io.readComparisonDocument==='function'&&typeof SceneEditorParameterCompare!=='undefined')data=io.readComparisonDocument(path,guard);else{fallback=new C.Document(path,io,guard);data=fallback.data;}if(stamp&& !C.equal(stamp,io.cacheStamp(path)))fail('A material definition changed while reading.');var d={path:path,data:data,stamp:stamp,fallback:fallback};dependencies['$'+path]=d;return d;}
  var root={path:doc.path,data:doc.data};
  function resolve(ref,scope){if(typeof ref!=='string'||ref.indexOf('#')<0)fail('A material definition reference is unresolved.');var at=ref.indexOf('#'),file=decodeURIComponent(ref.substring(0,at)),id=decodeURIComponent(ref.substring(at+1)),d=scope;if(file){if(/^[A-Za-z]:\//.test(file))file='/'+file;var path=io.resolve(file,scope.path);bindings.push({file:file,scope:scope.path,path:path});d=path===doc.path?root:external(path);}var library=d.data.material_library||[],found=null;for(var n=0;n<library.length;n++)if(library[n].id===id){if(found)fail('A material definition is ambiguous.');found=library[n];}if(!found)fail('A material definition is unavailable.');return{record:found,doc:d,library:true};}
  function chain(record){var layers=[],visited={},current={record:record,doc:root};while(current){guard('Resolve material inheritance');var identity=current.doc.path+'|'+(current.library?'library':'instance')+'#'+current.record.id;if(visited['$'+identity])fail('Material inheritance contains a cycle.');visited['$'+identity]=true;layers.unshift(current);var ref=current.record.url||current.record.source;current=ref?resolve(ref,current.doc):null;}return layers;}
  function descriptors(record){var out=[],keys={},k,e,n,extra=record.extra||[];function add(key,wrapper,recipe){if(keys['$'+key])fail('A material channel identity is ambiguous.');keys['$'+key]=true;out.push({key:key,wrapper:wrapper,channel:wrapper.channel,recipe:recipe});}for(k in record)if(own(record,k)&&record[k]&&typeof record[k]==='object'&&!array(record[k])&&record[k].channel)add('standard:'+k,record[k],{kind:'standard',field:k});var types={};for(e=0;e<extra.length;e++){if(!extra[e]||!array(extra[e].channels))continue;var type=extra[e].type;if(typeof type!=='string'||types['$'+type])fail('A material channel group identity is ambiguous.');types['$'+type]=true;for(n=0;n<extra[e].channels.length;n++){var w=extra[e].channels[n];if(!w||!w.channel||typeof w.channel.id!=='string')fail('A material channel identity is missing.');add('extra:'+JSON.stringify([type,w.channel.id]),w,{kind:'extra',type:type,id:w.channel.id});}}return out;}
  function verify(){doc.verify();for(var b=0;b<bindings.length;b++)if(io.resolve(bindings[b].file,bindings[b].scope)!==bindings[b].path)fail('Material definition precedence changed.');for(var key in dependencies)if(own(dependencies,key)){guard('Verify material definition');var d=dependencies[key];if(d.fallback)d.fallback.verify();else{if(d.stamp&&!C.equal(d.stamp,io.cacheStamp(d.path)))fail('A material definition changed.');if(!C.equal(d.data,io.readComparisonDocument(d.path,guard)))fail('A material definition changed.');}}}
  function add(binding,key,label,type,value,meta,category,recipe,field,issue){var id=JSON.stringify(['material',binding.key,key,field]),p={id:id,key:['material',binding.key,key,field],materialKey:binding.key,groups:[binding.label].concat(category),controlGroups:category.slice(0),label:String(label),type:type,value:value,meta:meta,layers:[{doc:doc}],companions:[],issue:issue||'',write:{binding:binding,recipe:recipe,field:field}};if(field==='info')p.displayText=readableAssetName(value);props[id]=p;order.push(id);}
  for(i=0;i<records.length;i++){
   var binding=records[i],layers=[],unresolved='',merged={},keys=[];try{layers=chain(binding.record);}catch(error){if(error.code==='CANCELLED'||error.code==='SOURCE_CHANGED')throw error;unresolved=String(error.message||error);layers=[{record:binding.record,doc:root}];warnings.push(binding.label+': '+unresolved);}
   choices.push({key:binding.key,label:binding.label});models[binding.key]=binding;
   add(binding,'shader','Shader','string',binding.record.url||binding.record.source||'Saved material',{id:'shader',locked:true},[],null,'info','');
   if(own(binding.record,'uv_set'))add(binding,'uv','UV Set','string',binding.record.uv_set===null?'None':String(binding.record.uv_set),{id:'uv_set',locked:true},[],null,'info','');
   for(var li=0;li<layers.length;li++){var descriptorsAt=descriptors(layers[li].record);for(j=0;j<descriptorsAt.length;j++){var descriptor=descriptorsAt[j],channel=descriptor.channel;if(typeof channel.id!=='string')fail('A material channel identity is missing.');var previous=merged['$'+descriptor.key],entry=previous||{meta:{},recipe:descriptor.recipe,value:undefined,category:[],map:null,issue:''};if(!previous)keys.push(descriptor.key);if(previous&&entry.meta.id!==channel.id)entry.issue='Material channel identity differs between layers.';for(var ck in channel)if(own(channel,ck))entry.meta[ck]=clone(channel[ck]);if(own(channel,'current_value'))entry.value=clone(channel.current_value);else if(own(channel,'value'))entry.value=clone(channel.value);if(typeof descriptor.wrapper.group==='string')entry.category=groups(descriptor.wrapper.group);else if(typeof channel.group==='string')entry.category=groups(channel.group);if(own(channel,'image')){entry.map=channel.image===null?null:{field:'reference',value:channel.image};}if(own(descriptor.wrapper,'image_file'))entry.map={field:'wrapper_image_file',value:descriptor.wrapper.image_file};if(own(channel,'image_file'))entry.map={field:'image_file',value:channel.image_file};if(channel.keys&&channel.keys.length)entry.issue='This material channel has saved animation keys.';merged['$'+descriptor.key]=entry;}}
   for(j=0;j<keys.length;j++){var entry=merged['$'+keys[j]],meta=entry.meta;entry.recipe.channelId=meta.id;entry.recipe.channelType=meta.type;var label=meta.label||meta.name||meta.id,type=meta.type||'unknown',issue=unresolved||entry.issue;try{C.validate({id:keys[j],type:type,meta:meta},entry.value);}catch(unsupported){issue=issue||'This material channel cannot be edited safely.';}add(binding,keys[j],label,type,entry.value,meta,entry.category,entry.recipe,'current_value',issue);if(entry.map){var editableMap=entry.map.field!=='reference'&&typeof entry.map.value==='string';add(binding,keys[j]+':map',label+' / Map',editableMap?'file':'string',typeof entry.map.value==='string'?entry.map.value:entry.map.value===null?'None':'Unknown',{id:meta.id+' map',locked:!editableMap,file_type:'file_open',file_filter:''},entry.category,entry.recipe,entry.map.field,unresolved||entry.issue);}}
  }
  var model={doc:doc,io:io,guard:guard,props:props,order:order,pending:{},pendingClamped:{},camera:{id:objectId,label:node.label||node.name||node.id},definitionRevision:1,materialChoices:choices,propertySource:{requested:'Saved DUF',effective:'Saved DUF'},warnings:warnings};
  model.set=function(id,value,policy){C.Editor.prototype.set.call(this,id,value,policy);this._builtPlan=null;};
  function object(o,k){if(!own(o,k))o[k]={};if(!o[k]||typeof o[k]!=='object'||array(o[k]))fail('A saved material container changed type.');return o[k];}
  function channelContainer(record,recipe,p){var wrapper;if(recipe.kind==='standard')wrapper=object(record,recipe.field);else{if(!own(record,'extra'))record.extra=[];if(!array(record.extra))fail('A saved material extra block is invalid.');var extra=null;for(var e=0;e<record.extra.length;e++)if(record.extra[e].type===recipe.type){if(extra)fail('A material channel group is ambiguous.');extra=record.extra[e];}if(!extra){extra={type:recipe.type,channels:[]};record.extra.push(extra);}if(!own(extra,'channels'))extra.channels=[];if(!array(extra.channels))fail('A material channel list is invalid.');for(var i=0;i<extra.channels.length;i++)if(extra.channels[i].channel&&extra.channels[i].channel.id===recipe.id){if(wrapper)fail('A material channel is ambiguous.');wrapper=extra.channels[i];}if(!wrapper){wrapper={channel:{id:recipe.id,type:recipe.channelType||p.type}};extra.channels.push(wrapper);}}var channel=object(wrapper,'channel'),channelId=recipe.channelId||recipe.id||p.meta.id;if(own(channel,'id')&&channel.id!==channelId)fail('A material channel identity changed.');if(!own(channel,'id'))channel.id=channelId;if(!own(channel,'type'))channel.type=recipe.channelType||p.type;return{wrapper:wrapper,channel:channel};}
  function operations(before,after,path,out){var key;if(C.equal(before,after))return;if(array(before)&&array(after)){if(after.length<before.length)fail('Material editing must not remove records.');for(var i=0;i<before.length;i++)operations(before[i],after[i],path.concat([i]),out);if(after.length>before.length)out.push({kind:'append',path:path,value:after.slice(before.length)});return;}if(before&&after&&typeof before==='object'&&typeof after==='object'&&!array(before)&&!array(after)){for(key in before)if(own(before,key)){if(!own(after,key))fail('Material editing must not remove fields.');operations(before[key],after[key],path.concat([key]),out);}for(key in after)if(own(after,key)&&!own(before,key))out.push({kind:'add',path:path,key:key,value:after[key]});return;}out.push({kind:'replace',path:path,value:after});}
  model.build=function(){var signature=JSON.stringify([this.pending,this.pendingClamped]);if(this._builtPlan&&this._builtPlan.signature===signature)return this._builtPlan;var edited={},id,p,record,container;for(id in this.pending)if(own(this.pending,id)){guard('Build material changes');p=this.props[id];if(!p||p.issue||p.meta.locked||!p.write.recipe)fail('A read-only material property cannot be changed.');C.validate(p,this.pending[id]);record=edited['$'+p.write.binding.index]||(edited['$'+p.write.binding.index]=clone(p.write.binding.record));container=channelContainer(record,p.write.recipe,p);if(p.write.field==='wrapper_image_file')container.wrapper.image_file=this.pending[id];else if(p.write.field==='image_file')container.channel.image_file=this.pending[id];else if(p.write.field==='current_value')container.channel.current_value=this.pending[id];else fail('Unsupported material property write.');if(own(this.pendingClamped,id))container.channel.clamped=this.pendingClamped[id];}
   var ops=[],index;for(index in edited)if(own(edited,index))operations(saved[Number(index.substring(1))],edited[index],['scene','materials',Number(index.substring(1))],ops);if(!ops.length)return{signature:signature,text:doc.text,diff:[]};var text=doc.patch(ops),parsed=C.parseDocument(text,guard),diff=C.diff(doc.data,parsed);for(var di=0;di<diff.length;di++)if(diff[di].path[0]!=='scene'||diff[di].path[1]!=='materials'||!own(edited,'$'+diff[di].path[2]))fail('Material patch changed unrelated scene data.');for(index in edited)if(own(edited,index)&&!C.equal(edited[index],parsed.scene.materials[Number(index.substring(1))]))fail('Material patch readback differs.');return this._builtPlan={signature:signature,text:text,diff:diff};};
  model.save=function(){var plan=this.build();if(!plan.diff.length)fail('No changes.');verify();var result=io.install(doc,plan.text,guard,verify);return{file:doc.path,semanticDiff:plan.diff,assetWrites:false,sourceProtection:result.sourceProtection||'Exact original binary bytes'};};
  return model;
 }
 function Session(path,io,guard,objectId){this.path=path;this.io=io;this.guard=guard;this.objectId=objectId;this.doc=new C.Document(path,io,guard);this.rows=[{id:objectId}];this.editor=null;this.timings={mode:'saved-materials'};}
 Session.prototype.select=function(index){if(index!==0)fail('Unknown material object selection.');if(!this.editor)this.editor=createModel(this.doc,this.io,this.guard,this.objectId);return{editor:this.editor,timings:{mode:'saved-materials'},diagnostics:this.editor.warnings.slice(0)};};
 Session.prototype.saved=function(){this.doc=new C.Document(this.path,this.io,this.guard);this.editor=null;return 0;};
 function show(env,root,path,id,settings,onSaved){settings=settings||{};return SceneEditorUI.show(env,root,{path:path,objectId:id,settingsManaged:true,dialogTitle:'Scene Editor - saved materials',dialogName:'SceneEditorObjectMaterials',propertySource:'Saved DUF',propertyView:settings.propertyView||'Controls',materialSelection:true,sessionFactory:function(source,io,guard){return new Session(source,io,guard,id);},onSaved:onSaved});}
 return{createModel:createModel,Session:Session,show:show};
}());

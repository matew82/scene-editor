/* Exact reusable native widget helpers from current SaveGuard Manager UI; no catalog/action entrypoint. */
var SceneEditorManagerWidgets=(function(){
function splitterState(control){try{if(typeof control.saveState!=='function')return '';var data=control.saveState();if(!data||typeof data.toHex!=='function')return '';return String(data.toHex().convertToString());}catch(ignore){return '';}}
function restoreSplitter(control,text){try{if(typeof text!=='string'||!text||text.length%2||!/^[0-9a-f]+$/i.test(text)||typeof ByteArray!=='function'||typeof control.restoreState!=='function')return false;var decoder=new ByteArray();if(typeof decoder.fromHex!=='function')return false;return control.restoreState(decoder.fromHex(new ByteArray(text)))===true;}catch(ignore){return false;}}
function dialog(title, width, height) {
        var w = new DzBasicDialog(); w.caption = title; var available = null; try { if (typeof DzDesktopWidget !== "undefined") { available = new DzDesktopWidget().availableGeometry(); } } catch (ignoredDesktop) {}
        var desktopWidth = Number(available && available.width), desktopHeight = Number(available && available.height);
        if (desktopWidth > 100 && desktopHeight > 100) { width = Math.min(width, desktopWidth - 32); height = Math.min(height, desktopHeight - 64); w.maxWidth = desktopWidth - 32; w.maxHeight = desktopHeight - 64; }
        w.minWidth = width; w.minHeight = height;
        if (available && desktopWidth > 100 && desktopHeight > 100) { w.setGeometry(Number(available.x) + 16, Number(available.y) + 16, width, height); } w.sizeGripEnabled = true;
        w.setAcceptButtonText("Close"); w.showCancelButton(false); w.showHelpButton(false);
        var font = w.font; font.pointSize = Math.max(12, Number(font.pointSize) || 12);
        try { if (typeof font.families === "function") { var families=font.families(); for(var fi=0;fi<families.length;fi+=1){if(String(families[fi]).toLowerCase()==="georgia"){font.family="Georgia";break;}} } } catch (ignoredFont) {} w.font = font;
        return w;
    }
function thumbnailCache(adapter) {
        var cache = {}, order = [], limit = 120;
        function create(path, size, warning, selected, important, comparisonSlot) {
            var img = new Image(), missing = true, scaled, pix = new Pixmap(), x, band, color;
            if (path) {
                try {
                    if ((!adapter.imageExists || adapter.imageExists(path)) && img.load(path) && !img.isNull() && img.width > 0 && img.height > 0) {
                        // Square previews use a center crop; full screenshots below preserve aspect ratio.
                        var side = Math.min(img.width, img.height);
                        scaled = img.copy(Math.floor((img.width - side) / 2), Math.floor((img.height - side) / 2), side, side).smoothScale(size, size); missing = false;
                    }
                } catch (ignoreImage) {}
            }
            if (!scaled || scaled.isNull()) { scaled = new Image(size, size, Image.Format_RGB32); scaled.fill(new Color(52, 57, 63)); missing = true; }
            if (important || warning || selected) {
                color = important ? (selected ? new Color(255, 193, 120) : new Color(231, 137, 49)) : warning ? (selected ? new Color(255, 153, 156) : new Color(224, 63, 67)) : new Color(80, 200, 120);
                for (band = 0; band < 3; band += 1) { for (x = 0; x < size; x += 1) {
                    scaled.setPixel(x, band, color); scaled.setPixel(x, size - 1 - band, color);
                    scaled.setPixel(band, x, color); scaled.setPixel(size - 1 - band, x, color);
                } }
            }
            if((comparisonSlot==='A'||comparisonSlot==='B')&&size>=32){var bx=size-28,by=4,ink=new Color(225,245,255),edge=new Color(120,204,247),fill=new Color(32,66,88),xx,yy,glyph=comparisonSlot==='A'?['01110','10001','10001','11111','10001','10001','10001']:['11110','10001','10001','11110','10001','10001','11110'];for(yy=0;yy<24;yy++)for(xx=0;xx<24;xx++)scaled.setPixel(bx+xx,by+yy,xx===0||yy===0||xx===23||yy===23?edge:fill);for(yy=0;yy<7;yy++)for(xx=0;xx<5;xx++)if(glyph[yy].charAt(xx)==='1'){scaled.setPixel(bx+7+xx*2,by+5+yy*2,ink);scaled.setPixel(bx+8+xx*2,by+5+yy*2,ink);scaled.setPixel(bx+7+xx*2,by+6+yy*2,ink);scaled.setPixel(bx+8+xx*2,by+6+yy*2,ink);}}
            pix.fromImage(scaled); return { pixmap: pix, missing: missing };
        }
        return { get: function (path, size, warning, selected, important, comparisonSlot) {
            selected = selected === true;
            var key = "$" + path + "|" + size + "|" + warning + "|" + selected + "|" + (important===true)+"|"+(comparisonSlot||"");
            if (!Object.prototype.hasOwnProperty.call(cache, key)) {
                if (order.length >= limit) { delete cache[order.shift()]; }
                cache[key] = create(path, size, warning, selected, important, comparisonSlot); order.push(key);
            }
            return cache[key];
        }, clear: function () { cache = {}; order = []; } };
    }
function imageButtonPixmap(control, pixmap, width, height) {
        control.pixmap = pixmap;
        var nativeButton = control.getWidget(), current = nativeButton && nativeButton.iconSize;
        if (!current || typeof Size !== "function") { throw Error("Native image-button icon sizing is unavailable."); }
        nativeButton.iconSize = new Size(width, height);
        current = nativeButton.iconSize;
        if (!current || Number(current.width) !== width || Number(current.height) !== height) { throw Error("Native image-button icon size was not applied."); }
    }
var buttonIconNames=["Scene Editor Edit saved properties","Scene Editor Edit saved materials","Scene Editor Folder Gallery Shortcut","Scene Editor Folder Outside Shortcut","Scene Editor Folder Gallery Shortcut Recent","Scene Editor Folder Outside Shortcut Recent","Scene Editor Parent Directory", "Scene Editor Folder Gallery", "Scene Editor Folder Outside", "Scene Editor Action Character", "Scene Editor Action Collapse", "Scene Editor Action Expand", "Scene Editor Action Find", "Scene Editor Action Materials", "Scene Editor Action Object", "Scene Editor Action Pose", "Scene Editor Action Restore Pose", "Scene Editor Action Restore Shape", "Scene Editor Action Shape", "Scene Editor Action Transforms", "Scene Editor Action Wearable", "Scene Editor Add Camera", "Scene Editor Arrow Left", "Scene Editor Arrow Right", "Scene Editor Close", "Scene Editor Edit", "Scene Editor light-camera-hidden", "Scene Editor light-camera-unknown", "Scene Editor light-camera", "Scene Editor light-character", "Scene Editor light-distant-group", "Scene Editor light-distant", "Scene Editor light-emissive", "Scene Editor light-figure", "Scene Editor light-generic-group", "Scene Editor light-generic", "Scene Editor light-neutral", "Scene Editor light-object", "Scene Editor light-point-group", "Scene Editor light-point", "Scene Editor light-spot-group", "Scene Editor light-spot", "Scene Editor light-wearable", "Scene Editor Load Emissive", "Scene Editor Load Light Assembly", "Scene Editor Load Light", "Scene Editor Refresh", "Scene Editor Replace Camera", "Scene Editor Search", "Scene Editor Settings", "Scene Editor Manager", "Scene Editor Action Render Settings", "Scene Editor Backup", "Scene Editor Load Scene", "Scene Editor Merge Scene", "Scene Editor Note", "Scene Editor Save Note", "Scene Editor Important"];
function semanticButtonIcon(name){if(typeof name!=='string')return null;var value=name.replace(/^\s+|\s+$/g,'').replace(/\.png$/i,''),lower=value.toLowerCase(),i;if(lower==='settings')return 'Scene Editor Edit';value=value.replace(/^SaveGuard /i,'Scene Editor ');for(i=0;i<buttonIconNames.length;i++)if(buttonIconNames[i].toLowerCase()===value.toLowerCase()||buttonIconNames[i].substring(13).toLowerCase()===lower)return buttonIconNames[i];
 var map={'parentdirectory':'Parent Directory','foldergallery':'Folder Gallery','folderoutside':'Folder Outside','foldergalleryrecent':'Folder Gallery Recent','folderoutsiderecent':'Folder Outside Recent','foldergalleryshortcut':'Folder Gallery Shortcut','folderoutsideshortcut':'Folder Outside Shortcut','foldergalleryshortcutrecent':'Folder Gallery Shortcut Recent','folderoutsideshortcutrecent':'Folder Outside Shortcut Recent','choose folder...':'Folder Gallery','choose folder':'Folder Gallery','browse':'Folder Gallery','folder':'Folder Outside','parent folder':'Parent Directory','parent directory':'Parent Directory','up one folder':'Parent Directory','back':'Arrow Left','forward':'Arrow Right','refresh':'Refresh','refresh backups':'Refresh','settings':'Edit','close':'Close','cancel':'Close','close without saving':'Close','advanced filters':'Search','clear filters':'Close','backup this scene':'Backup','load scene':'Load Scene','merge scene':'Merge Scene','important':'Important','important scenes only':'Important','note':'Note','save note':'Save Note','open screenshot':'Search','open screenshots':'Search','advanced figure configuration':'Action Character','supported figures':'Action Character','add selected figure':'Action Character','restore missing defaults':'Refresh','use this list':'Settings','save settings':'Settings','clear caches for missing files':'Refresh','clear current-folder caches':'Refresh','clear all caches':'Refresh','add object condition':'Action Object','remove':'Close','expand':'Action Expand','collapse':'Action Collapse','find':'Search','find by exact label':'Search','edit':'Edit','edit saved properties':'Edit saved properties','edit saved materials':'Edit saved materials','edit properties':'Edit','apply render settings':'Action Render Settings'};
 if(lower.indexOf('[..]')===0)return'Scene Editor Arrow Left';if(lower.indexOf('[folder]')===0)return'Scene Editor Arrow Right';if(Object.prototype.hasOwnProperty.call(map,lower))return'Scene Editor '+map[lower];return null;}
function applyIcon(env,control,path,title,options){options=options||{};var compact=options.compact!==false,size=options.iconSize||(compact?48:24),buttonSize=options.buttonSize||52;if(!env||typeof env.DzFileInfo!=='function'||typeof env.Pixmap!=='function'||typeof env.Size!=='function')throw Error('Native icon file/Pixmap/Size APIs are unavailable.');if(typeof path!=='string'||!path||/[\x00-\x1f]/.test(path))throw Error('A valid required Scene Editor icon path is needed.');var info=new env.DzFileInfo(path);if(typeof info.exists!=='function'||typeof info.isFile!=='function'||typeof info.isReadable!=='function')throw Error('Native icon file validation APIs are unavailable.');if(!info.exists()||!info.isFile()||!info.isReadable())throw Error('Required Scene Editor icon is missing or unreadable: '+path);var pixmap=new env.Pixmap(path);if(typeof pixmap.isNull!=='function'||pixmap.isNull())throw Error('Required Scene Editor icon could not be decoded: '+path);if(!control||typeof control.getWidget!=='function'||typeof control.setFixedSize!=='function')throw Error('Native icon button APIs are unavailable.');var nativeButton=control.getWidget();if(!nativeButton||!nativeButton.iconSize)throw Error('Native image-button icon sizing is unavailable.');var tooltip=control.toolTip||control.text||title||'Scene Editor action';control.pixmap=pixmap;control.sizedFromIcon=compact;control.autoDefault=false;nativeButton.iconSize=new env.Size(size,size);var actual=nativeButton.iconSize;if(!actual||Number(actual.width)!==size||Number(actual.height)!==size)throw Error('Native image-button icon size was not applied.');control.toolTip=String(tooltip);if(compact){control.text='';control.setFixedSize(buttonSize,buttonSize);}else control.minHeight=Math.max(34,Number(control.minHeight)||0);return{path:path,iconWidth:size,iconHeight:size,compact:compact,controlWidth:compact?buttonSize:null,controlHeight:compact?buttonSize:null};}
function applyButtonIcon(env,control,name,root){var icon=semanticButtonIcon(name);if(!icon)throw Error('No Scene Editor icon mapping for action: '+String(name));root=root||env&&env.sceneEditorRoot;if(typeof root!=='string'||!root)throw Error('Scene Editor project root is required for action icons.');root=root.replace(/\\/g,'/').replace(/\/+$/,'');return applyIcon(env,control,root+'/icons/'+icon+'.png',String(name),{compact:false});}

return{splitterState:splitterState,restoreSplitter:restoreSplitter,semanticButtonIcon:semanticButtonIcon,applyIcon:applyIcon,applyButtonIcon:applyButtonIcon,dialog:dialog,thumbnailCache:thumbnailCache,imageButtonPixmap:imageButtonPixmap};
}());

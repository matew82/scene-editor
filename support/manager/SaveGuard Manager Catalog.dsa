                    entry = raw.manifests[key];
                    if (!entry || typeof entry.signature !== "string" || !entry.manifest || typeof entry.manifest !== "object") { continue; }
                    var manifestPath = entry.path || key.substring(1), info = new DzFileInfo(manifestPath);
                    if (!info.exists() || !info.isFile()) { continue; }
                    var signature = Number(info.size()) + ":" + Number(info.lastModified().getTime());
                    if (signature !== entry.signature) { continue; }
                    nextCache[key] = {
                        signature: signature,
                        manifest: copyPlain(entry.manifest),

        var result = model.buildCatalog(records); result.warnings = warnings.concat(result.warnings); result.revision = ++revision; result.directoriesRead = directories; result.reusedVersions = reusedVersions; result.reusedFromDisk = reusedFromDisk; result.envelopes = resultEnvelopes; result.catalogDb = { ok: lastPersist.ok, path: lastPersist.path, error: lastPersist.error, reusedFromDisk: reusedFromDisk };

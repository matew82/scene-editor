// Read-only manifest discovery; no DUF, image, scene, or settings writes.
// Include after SaveGuard Manager Model.dsa. A caller owns this cache per dialog.
// Optional on-disk Catalog DB (mtime/dir stamps + version/manifest summaries) is separate
// from SaveGuardInspectionCache (per-copy DUF inspection projection).
function SaveGuardManagerCatalog(options) {
    options = options || {};
    var model = SaveGuardManagerModel, cache = {}, revision = 0, dirIndex = {}, lastRootKey = "",
        diskLoadedRoot = "", persistEnabled = options.persist !== false && options.maxDepth !== 0,
        dbFolderName = ".saveguard-catalog-db", dbFileName = "index.json",
        dbSchema = "saveguard-catalog-db-1", dbByteLimit = options.maxCatalogDbBytes || 33554432,
        lastPersist = { ok: false, reusedFromDisk: 0, path: "", error: "" };
    function own(object, key) { return Object.prototype.hasOwnProperty.call(object, key); }
    function exists(path) { var info = new DzFileInfo(path); return info.exists() && info.isFile(); }
    function dirExists(path) { var info = new DzFileInfo(path); return info.exists() && info.isDir() && !info.isSymLink(); }
    function dirStamp(path) {
        var info = new DzFileInfo(path);
        if (!info.exists()) { return ""; }
        return String(Number(info.lastModified().getTime())) + ":" + (info.isDir() ? "d" : "f") + ":" + String(Number(info.size()));
    }
    function skipDirName(name) {
        return name === "saveguard-user" || name === ".saveguard-maintenance" || name === ".saveguard-maintenance-lock" ||
            name === ".saveguard-recovery" || name === dbFolderName;
    }
    function dbPaths(root) {
        var folder = model.path(root) + "/" + dbFolderName;
        return { folder: folder, file: folder + "/" + dbFileName };
    }
    function clearMemory() { cache = {}; dirIndex = {}; lastRootKey = ""; diskLoadedRoot = ""; lastPersist = { ok: false, reusedFromDisk: 0, path: "", error: "" }; }
    function removeDiskFile(path) {
        var info = new DzFileInfo(path);
        if (!info.exists()) { return true; }
        if (!info.isFile() || info.isSymLink()) { return false; }
        return new DzFile(path).remove() === true;
    }
    function invalidateDisk(root) {
        clearMemory();
        if (!persistEnabled) { return true; }
        try {
            if (root) {
                var paths = dbPaths(root);
                if (!removeDiskFile(paths.file)) { return false; }
                var folderInfo = new DzFileInfo(paths.folder);

    function persistToDisk(root, rootKey) {
        lastPersist.ok = false;
        lastPersist.error = "";
        if (!persistEnabled || typeof SaveGuardStorage === "undefined") { return false; }
        try {
            var paths = dbPaths(root), dirs = {}, manifests = {}, key, entry, text;
            for (key in dirIndex) {

            if (text.length > dbByteLimit) {
                lastPersist.error = "Catalog DB exceeds " + dbByteLimit + " byte limit; not written.";
                return false;
            }
            SaveGuardStorage.ensureDirectory(paths.folder);
            if (!removeDiskFile(paths.file)) { throw Error("Cannot replace existing Catalog DB"); }
            // Drop a leftover partial from a prior crash before writeJSONNew.
            removeDiskFile(paths.file + ".partial");
            SaveGuardStorage.writeJSONNew(paths.folder, dbFileName, payload);
            lastPersist.ok = true;
            lastPersist.path = paths.file;
            return true;
        } catch (persistError) {
            lastPersist.error = String(persistError && persistError.message !== undefined ? persistError.message : persistError);
            return false;
        }
    }
    function readManifest(path) {
        var info = new DzFileInfo(path), size = Number(info.size()), modified = Number(info.lastModified().getTime()),
            signature = size + ":" + modified, key = "$" + model.pathKey(path), file, bytes, value;
        if (size <= 0 || size > (options.maxManifestBytes || 2097152)) { throw Error("Manifest empty or above the 2 MiB read limit"); }
        if (own(cache, key) && cache[key].signature === signature) { return cache[key]; }
        file = new DzFile(path);
        try {
            if (!file.open(DzFile.ReadOnly)) { throw Error("Cannot open manifest"); }
            bytes = file.read(size);
            if (!bytes || Number(bytes.length) !== size || file.error() !== DzFile.NoError || !file.eof()) { throw Error("Incomplete manifest read"); }
            value = JSON.parse(bytes.convertToString());
        } finally { file.close(); }
        var after = new DzFileInfo(path);
        if (Number(after.size()) !== size || Number(after.lastModified().getTime()) !== modified) { throw Error("Manifest changed during read"); }
        if (!value || typeof value !== "object" || Object.prototype.toString.call(value) === "[object Array]") { throw Error("Manifest is not an object"); }
        cache[key] = { signature: signature, manifest: value, modifiedAtEpochMs: modified };
        return cache[key];
    }
    function listChildDirs(path, depth, maxDepth) {
        var key = "$" + model.pathKey(path), stamp = dirStamp(path), cached = own(dirIndex, key) ? dirIndex[key] : null, children, i, names = [], alive = [], refreshed = false;
        if (!stamp) { return []; }
        if (cached && cached.stamp === stamp && cached.children) {
            for (i = 0; i < cached.children.length; i += 1) {
                if (dirExists(cached.children[i])) { alive.push(cached.children[i]); }
            }
            // Deleted children must never stay visible. If any vanished, re-list from disk.
            if (alive.length === cached.children.length) {
                cached.path = model.path(path);
                return alive.slice(0);
            }
            refreshed = true;
        }
        var dir = new DzDir(path);
        children = dir.entryList("*", DzDir.Dirs | DzDir.NoDotAndDotDot | DzDir.NoSymLinks, DzDir.Name);
        for (i = 0; i < (children ? children.length : 0); i += 1) {
            if (!skipDirName(String(children[i]))) {
                names.push(model.path(dir.filePath(String(children[i]))));
            }
        }
        var next = { path: model.path(path), stamp: stamp, children: names.slice(0), depth: depth };
        if (cached) {
            next.versionRecord = cached.versionRecord;
            next.manifestName = cached.manifestName;
            next.hadCapture = cached.hadCapture;
            next.derivedPresent = cached.derivedPresent;
        }
        dirIndex[key] = next;
        if (refreshed && typeof print === "function") { print("SaveGuard catalog: refreshed child list after delete at " + path); }
        return names;
    }
    function refreshVolatileFlags(versionRecord, folderPath, dir) {
        var copiedScene = model.safeFile(folderPath, ((versionRecord.manifest || {}).scene || {}).file);
        versionRecord.sceneFileExists = !!copiedScene && exists(copiedScene);
        versionRecord.invalidated = exists(dir.filePath("INVALID.json"));
        versionRecord.failed = exists(dir.filePath("FAILED.json"));
        return versionRecord;
    }
    function scan(root, scanOptions) {
        scanOptions = scanOptions || {};
        var rootInfo = new DzFileInfo(root), canonical = model.path(rootInfo.canonicalFilePath()), warnings = [], records = [],
            visited = {}, seenCache = {}, seenDirs = {}, stack = [{ path: model.path(rootInfo.absoluteFilePath()), depth: 0 }], directories = 0,
            maxDirectories = options.maxDirectories || 100000, maxDepth = typeof options.maxDepth === "number" ? options.maxDepth : 6,
            reusedVersions = 0, reusedFromDisk = 0, rootKey = "$" + model.pathKey(model.path(rootInfo.absoluteFilePath())), resultEnvelopes = [];
        if (!rootInfo.isAbsolute()) { throw Error("Backup directory must be absolute."); }
        if (scanOptions.force === true) { invalidateDisk(model.path(rootInfo.absoluteFilePath())); }
        if (rootKey !== lastRootKey) { dirIndex = {}; cache = {}; lastRootKey = rootKey; diskLoadedRoot = ""; }
        if (!rootInfo.exists()) {
            cache = {}; dirIndex = {};
            if (persistEnabled) { invalidateDisk(model.path(rootInfo.absoluteFilePath())); }
            return { scenes: [], warnings: ["Backup directory does not exist yet."], versionCount: 0, revision: ++revision, directoriesRead: 0, reusedVersions: 0, reusedFromDisk: 0, catalogDb: lastPersist };
        }
        if (!rootInfo.isDir()) { throw Error("Backup directory is not a directory."); }
        reusedFromDisk = hydrateFromDisk(model.path(rootInfo.absoluteFilePath()), rootKey);
        while (stack.length) {
            var current = stack.pop(), dir = new DzDir(current.path), actual = model.path(dir.canonicalPath()), key = "$" + model.pathKey(actual || current.path), i, childNames, stamp;
            if (own(visited, key)) { continue; } visited[key] = true; seenDirs[key] = true;
            if (canonical && actual && model.pathKey(actual) !== model.pathKey(canonical) && model.pathKey(actual).indexOf(model.pathKey(canonical) + "/") !== 0) {
                warnings.push("Skipped directory outside backup root: " + current.path); continue;
            }
            directories += 1;
            if (directories > maxDirectories) { warnings.push("Catalog directory limit reached; results are partial."); break; }
            if (!dir.isReadable()) { warnings.push("Unreadable directory: " + current.path); continue; }
            stamp = dirStamp(current.path);
            if (!stamp) { continue; }
            var manifestName = exists(dir.filePath("complete.json")) ? "complete.json" :
                exists(dir.filePath("pre-save.json")) ? "" : exists(dir.filePath("staging.json")) ? "staging.json" : "";
            if (manifestName) {
                var manifestPath = model.path(dir.filePath(manifestName)), capturePath = model.path(dir.filePath("capture.json")),
                    hadCapture = exists(capturePath), derivedHit = false, derivedNames = ["saveguard-derived.json", "saveguard-derived-v2.json"], di,
                    prior = own(dirIndex, key) ? dirIndex[key] : null, canReuse = prior && prior.stamp === stamp && prior.versionRecord && prior.manifestName === manifestName && prior.hadCapture === hadCapture;
                for (di = 0; canReuse && di < derivedNames.length; di += 1) {
                    if (exists(current.path + "/" + derivedNames[di]) !== !!prior.derivedPresent[derivedNames[di]]) { canReuse = false; }
                }
                // Folder must still exist; never show a stale disk/session row for a deleted copy.
                if (canReuse && !dirExists(current.path)) { canReuse = false; }
                if (canReuse) {
                    var reused = refreshVolatileFlags(copyPlain(prior.versionRecord), current.path, dir);
                    reused.folder = current.path;
                    records.push(reused);
                    prior.versionRecord = reused;
                    prior.path = model.path(current.path);
                    seenCache["$" + model.pathKey(manifestPath)] = true;
                    if (hadCapture) { seenCache["$" + model.pathKey(capturePath)] = true; }
                    for (di = 0; di < derivedNames.length; di += 1) {
                        if (prior.derivedPresent[derivedNames[di]]) { seenCache["$" + model.pathKey(current.path + "/" + derivedNames[di])] = true; }
                    }
                    reusedVersions += 1;
                } else {
                    try {
                        var record = readManifest(manifestPath); seenCache["$" + model.pathKey(manifestPath)] = true;
                        var presentationManifest = record.manifest,
                            captureResultState = record.manifest.capture ? "not published" : "not recorded", presentationWarnings = [], derivedPresent = {};
                        // Check every refresh, even when complete.json is already cached. A late
                        // immutable capture.json becomes visible without rewriting the saved copy.
                        if (manifestName === "complete.json" && hadCapture) {
                            try {
                                var captureRecord = readManifest(capturePath); seenCache["$" + model.pathKey(capturePath)] = true;
                                presentationManifest = model.mergeCapture(record.manifest, captureRecord.manifest, current.path, manifestPath);
                                captureResultState = "merged";
                            } catch (captureError) {
                                captureResultState = "rejected";
                                var captureWarning = capturePath + ": " + String(captureError);

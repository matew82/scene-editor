                return true;
            }
            return true;
        } catch (ignoreInvalidate) { return false; }
    }
    function copyPlain(value) {
        return JSON.parse(JSON.stringify(value));
    }
    function hydrateFromDisk(root, rootKey) {
        var reused = 0;
        if (!persistEnabled || typeof SaveGuardStorage === "undefined") { return 0; }
        if (diskLoadedRoot === rootKey) { return 0; }
        diskLoadedRoot = rootKey;
        try {
            var paths = dbPaths(root), fileInfo = new DzFileInfo(paths.file);

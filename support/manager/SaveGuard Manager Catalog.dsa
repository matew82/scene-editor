                            captureResultState: captureResultState, presentationWarnings: presentationWarnings,
                            manifestIdentity: model.path(new DzFileInfo(manifestPath).canonicalFilePath()) || manifestPath,
                            modifiedAtEpochMs: record.modifiedAtEpochMs, sceneFileExists: !!copiedScene && exists(copiedScene),
                            invalidated: exists(dir.filePath("INVALID.json")), failed: exists(dir.filePath("FAILED.json")) };
                        records.push(versionRecord);
                        dirIndex[key] = { path: model.path(current.path), stamp: stamp, children: prior && prior.stamp === stamp && prior.children ? prior.children : null, depth: current.depth,
                            versionRecord: versionRecord, manifestName: manifestName, hadCapture: hadCapture, derivedPresent: derivedPresent };
                    } catch (e) {

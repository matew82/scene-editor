                    versionRecord = copyPlain(entry.versionRecord);
                    reused += 1;
                }
                nextDir[key] = {
                    stamp: entry.stamp,
                    children: children,
                    depth: typeof entry.depth === "number" ? entry.depth : 0,
                    versionRecord: versionRecord,
                    manifestName: entry.manifestName || "",

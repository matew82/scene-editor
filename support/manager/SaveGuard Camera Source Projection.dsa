// Source-owned camera closure. IDs remain authored until the action's extraction.
var SaveGuardCameraSourceProjection=(function(){
 function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}
 function need(v,m){if(!v)throw Error('Camera source: '+m);}
 function copy(value,guard){if(!value||typeof value!=='object')return value;var stack=[];function enter(v){for(var i=0;i<stack.length;i++)need(stack[i].v!==v,'Cyclic source record');var f={v:v,out:Object.prototype.toString.call(v)==='[object Array]'?[]:{},keys:Object.keys(v),at:0};stack.push(f);return f.out;}var result=enter(value),steps=0;while(stack.length){if((steps++&63)===0)guard();var f=stack[stack.length-1];if(f.at===f.keys.length){stack.pop();continue;}var k=f.keys[f.at++];need(k!=='__proto__','Unsafe source member');var v=f.v[k];f.out[k]=v&&typeof v==='object'?enter(v):v;}guard();return result;}
 function subset(doc,locators,guard){var out={file_version:doc.file_version,scene:{}},seen={},i;for(i=0;i<locators.length;i++){guard();var match=/^(?:(scene)\.)?([a-z_]+)\[(\d+)\]$/.exec(locators[i]);need(match,'Invalid closure locator');if(own(seen,locators[i]))continue;seen[locators[i]]=true;var from=match[1]?doc.scene:doc,to=match[1]?out.scene:out,name=match[2],at=Number(match[3]);need(from&&from[name]&&at<from[name].length,'Missing closure record');if(!to[name])to[name]=[];to[name].push(copy(from[name][at],guard));}if(doc.asset_info)out.asset_info=copy(doc.asset_info,guard);return out;}
 function cameraType(doc,node,options,guard){var current=node,document=doc,file='',seen={},effective='',selective=SaveGuardSelective;while(current){guard();if(current.type&&!effective)effective=current.type;var link=current.url||current.source;if(!link)break;var ref=selective.parseURI(link);need((ref.kind==='local'||ref.kind==='external')&&!ref.nodePath&&!ref.query&&!ref.scheme,'Invalid camera definition reference');var key=file+'#'+ref.fragment;if(ref.kind==='external'){need(options&&typeof options.resolveAssetDocument==='function','Camera definition resolver unavailable');var request=ref.file;if(file&&request.charAt(0)!=='/')request=file.substring(0,file.lastIndexOf('/')+1)+request;var loaded=options.resolveAssetDocument(request);need(loaded&&loaded.verified===true&&loaded.document,'Camera definition not verified');document=loaded.document;file=loaded.uri||request;key=file+'#'+ref.fragment;}need(!own(seen,key),'Cyclic camera definition');seen[key]=true;var found=null,defs=document.node_library||[];for(var i=0;i<defs.length;i++){guard();if(defs[i].id===ref.fragment){need(!found,'Ambiguous camera definition');found=defs[i];}}need(found,'Missing camera definition');current=found;}return effective;}
 function planned(doc,id,guard,options){options=options||{};
  var view={},scene={},by={},defs={},key,i,j;for(key in doc)if(own(doc,key))view[key]=doc[key];for(key in doc.scene)if(own(doc.scene,key)&&key!=='animations')scene[key]=doc.scene[key];view.scene=scene;scene.animations=[];
  for(i=0;i<(doc.scene.nodes||[]).length;i++)by['$'+doc.scene.nodes[i].id]=doc.scene.nodes[i];for(i=0;i<(doc.node_library||[]).length;i++)defs['$'+doc.node_library[i].id]=doc.node_library[i];
  function sourceMatches(node,ref){var current=node,seen={};if(ref.kind==='local'&&node.id===ref.fragment)return true;while(current){guard();var link=current.url||current.source;if(!link)break;var p=SaveGuardSelective.parseURI(link);if(p.kind===ref.kind&&p.file===ref.file&&p.fragment===ref.fragment)return true;if(p.kind!=='local'||own(seen,'$'+p.fragment))break;seen['$'+p.fragment]=true;current=defs['$'+p.fragment];}return false;}
  function ownerPath(parts){var ids=[],i,j;for(i=0;i<parts.length;i++){if(!parts[i])return false;var id=decodeURIComponent(parts[i]);if(!own(by,'$'+id)||ids.indexOf(id)>=0)return false;ids.push(id);}for(i=1;i<ids.length;i++){var node=by['$'+ids[i]],seen={},found=false;while(node){guard();var link=node.parent||node.parent_in_place;if(!link)break;var p=SaveGuardSelective.parseURI(link);if(p.kind!=='local'||p.query||p.nodePath&&p.nodePath!==p.fragment||own(seen,'$'+p.fragment))break;seen['$'+p.fragment]=true;if(p.fragment===ids[i-1]){found=true;break;}node=by['$'+p.fragment];}if(!found)return false;}return true;}
  function compile(){guard();var p=SaveGuardSelective.plan(view,[id],{fullData:true,includeDescendants:false,preserveAnimation:true,resolveAssetDocument:options.resolveAssetDocument,isCancelled:function(){guard();return false;}});guard();return p;}
  var p=compile(),prior='',round=0;if(!p.ready)return p;
  while(true){guard();need(round++<=(doc.scene.nodes||[]).length,'Camera animation closure failed to converge');var owned={},defined={};for(i=0;i<p.nodeIds.length;i++)owned['$'+p.nodeIds[i]]=true;for(i=0;i<p.libraryNodeIds.length;i++)defined['$'+p.libraryNodeIds[i]]=true;var selected=[];
   for(i=0;i<(doc.scene.animations||[]).length;i++){guard();var a=doc.scene.animations[i],ref=SaveGuardSelective.parseURI(a.url||''),parts=(ref.nodePath||'').split('/'),owner='';for(j=0;j<parts.length;j++)if(parts[j])owner=decodeURIComponent(parts[j]);
    if(ref.kind==='local'&&own(defined,'$'+ref.fragment)){
     if(owner&&!own(owned,'$'+owner)){var foreign=by['$'+owner];need(foreign&&ownerPath(parts)&&sourceMatches(foreign,ref),'Ambiguous/foreign animation owner or definition: '+a.url);continue;}
     if(!owner){var matches=0;for(key in by)if(own(by,key)&&sourceMatches(by[key],ref))matches++;need(matches===1,'Ambiguous unqualified camera definition animation: '+a.url);}
    }
    selected.push(a);
   }
   scene.animations=selected;var next=compile();if(!next.ready)return next;var signature=JSON.stringify(next.nodeIds);if(signature===prior)return next;prior=signature;p=next;
  }
 }
 function project(source,guard,options){guard=guard||function(){};options=options||{};need(source&&source.scene,'Saved scene missing');guard();var cat=SaveGuardSelective.catalog(source,{isCancelled:function(){guard();return false;}}),rows=[],locators=[],i,j;for(i=0;i<cat.rows.length;i++){guard();var r=cat.rows[i];if(r.type!=='camera'&&r.id!==options.sourceId)continue;if(r.type!=='camera'){var selected=null;for(j=0;j<(source.scene.nodes||[]).length;j++)if(source.scene.nodes[j].id===r.id)selected=source.scene.nodes[j];if(cameraType(source,selected,options,guard)!=='camera')continue;}var p=planned(source,r.id,guard,options),row={id:r.id,label:'',ids:p.nodeIds.slice(0),definitionIds:p.libraryNodeIds.slice(0),error:p.ready?null:(p.errors||[]).join('; ')};for(j=0;j<(source.scene.nodes||[]).length;j++)if(source.scene.nodes[j].id===r.id)row.label=source.scene.nodes[j].label;rows.push(row);for(j=0;j<p.locators.length;j++)locators.push(p.locators[j]);}var document=subset(source,locators,guard);guard();return {document:document,rows:rows,retainedChars:JSON.stringify(document).length};}
 function select(projected,id,guard,options){guard=guard||function(){};var row=null;for(var i=0;i<projected.rows.length;i++){guard();if(projected.rows[i].id===id){need(!row,'Ambiguous selected camera');row=projected.rows[i];}}need(row,'Selected camera disappeared');need(!row.error,row.error);need(typeof row.label==='string'&&row.label.length,'Saved camera needs an explicit label');var p=planned(projected.document,id,guard,options);need(p.ready,(p.errors||[]).join('; '));return subset(projected.document,p.locators,guard);}
 return {project:project,select:select,copy:copy,cameraType:cameraType};
}());

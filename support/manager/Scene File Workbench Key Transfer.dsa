/* Selected animation-key transfer: explicit scalar scene-local tracks only. */
var SceneEditorKeyTransfer=(function(){
 var C=SceneEditorCore;
 function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}function arr(x){return Object.prototype.toString.call(x)==='[object Array]';}function cp(x){return JSON.parse(JSON.stringify(x));}function fail(m){throw Error(m);}function finite(n){return typeof n==='number'&&isFinite(n);}function scalar(t){return t==='float'||t==='int'||t==='enum'||t==='bool';}
 function reason(d,direction){if(!d||d.kind!=='animationKey'||d.status!=='Changed')return 'Select individual known changed animation keys.';if(!d.transferA||!d.transferB)return 'Both properties must have verified existing bindings.';if(d.transferA.issue||d.transferB.issue)return 'Property binding is unresolved.';if(!finite(d.fpsA)||d.fpsA<=0||!finite(d.fpsB)||d.fpsB<=0||d.fpsA!==d.fpsB)return 'Animation key transfer requires known identical FPS in both scenes.';if(!finite(d.time))return 'Key time is unknown.';var from=direction===1?d.keyB:d.keyA,to=direction===1?d.keyA:d.keyB;if(!from)return 'There is no source key in this direction.';if(from.unknown||to&&to.unknown)return 'Key format or interpolation is unknown.';if(!scalar(d.transferA.type)||d.transferA.type!==d.transferB.type)return 'Only compatible scalar numeric or boolean animation channels are supported.';return '';}
 function fps(doc){var extras=doc.data.scene&&doc.data.scene.extra||[],found=null,count=0;for(var i=0;i<extras.length;i++)if(extras[i].type==='studio_scene_settings'){count++;found=extras[i].animation_settings;}var n=found&&found.current_frames_per_second;if(count!==1||!finite(n)||n<=0)fail('Scene FPS is missing or ambiguous.');return n;}
 function canonicalQuery(q){if(typeof q!=='string'||q.charAt(0)!=='?')fail('Animation channel query is unresolved.');if(q==='?scale/general/value')return '?general_scale/value';if(q==='?value/value')return '?value';return q;}
 function decodeTrack(url){if(typeof url!=='string'||/^name:/.test(url)||url.indexOf('@selection')>=0)fail('Unresolved animation track URL.');var s=url;if(s.indexOf('id:/')===0)s=s.substring(4);var hash=s.indexOf('#'),q=s.indexOf('?');if(hash<0||q<hash||s.indexOf('#',hash+1)>=0)fail('Animation track URL is malformed.');try{var prefix=decodeURIComponent(s.substring(0,hash)),colon=prefix.indexOf(':');return{id:decodeURIComponent(s.substring(hash+1,q)),query:canonicalQuery(decodeURIComponent(s.substring(q))),file:colon>=0?prefix.substring(colon+1):prefix,anchor:colon>=0?prefix.substring(0,colon):''};}catch(e){fail('Animation track URL cannot be resolved: '+url);}}

 function validateKey(k){if(!arr(k)||(k.length!==2&&k.length!==3)||!finite(k[0]))fail('Unsupported animation key tuple.');var v=k[1];if(typeof v!=='boolean'&&!finite(v))fail('Only scalar animation key values are supported.');if(k.length===3){var p=k[2],counts={LINEAR:1,CONST:1,TCB:4,HERMITE:3};if(!arr(p)||!own(counts,p[0])||p.length!==counts[p[0]])fail('Unsupported interpolation or tangent format.');for(var i=1;i<p.length;i++)if(!finite(p[i]))fail('Non-finite animation tangent.');}}
 function normalized(k,type){validateKey(k);var p=k.length===2?(type==='float'?['TCB',0,0,0]:['LINEAR']):cp(k[2]);if(p[0]==='CONST')p=['CONSTANT'];return{time:k[0],value:k[1],interpolation:p};}
 function assertExpected(raw,expected,time,type){if(!raw){if(expected)fail('Key disappeared since comparison.');return;}if(!expected||expected.unknown||raw[0]!==time)fail('Key changed since comparison.');var n=normalized(raw,type);if(!C.equal(n.value,expected.value)||!C.equal(n.interpolation,expected.interpolation)||expected.time!==raw[0]||expected.raw&&!C.equal(raw,expected.raw))fail('Key changed since comparison.');}
 function indexTracks(doc,tracks){if(!arr(tracks))fail('Animation track list is not an array.');var map={},owners={},aliases={},parents={},scene=doc.data.scene||{},rows=(scene.nodes||[]).concat(scene.modifiers||[]),i,r,key;for(i=0;i<(scene.nodes||[]).length;i++){var node=scene.nodes[i];for(var g=0;g<(node.geometries||[]).length;g++){var geo=node.geometries[g];rows.push(geo);parents['$'+geo.id]=node.id;}}for(i=0;i<rows.length;i++){r=rows[i];key='$'+r.id;owners[key]=own(owners,key)?null:r;if(r.parent&&r.parent.charAt(0)==='#')parents[key]=decodeURIComponent(r.parent.substring(1));if(r.url){var url=decodeURIComponent(r.url);(aliases['$'+url]||(aliases['$'+url]=[])).push(r);}}
  function qualified(record,anchor){if(!anchor)return true;var parts=anchor.split('/'),wanted=[],ancestry=[],seen={},id=record.id,p,end;for(p=0;p<parts.length;p++)if(parts[p])wanted.push(parts[p]);while(id){if(seen['$'+id]||!owners['$'+id])return false;seen['$'+id]=true;ancestry.unshift(id);id=parents['$'+id];}for(end=0;end<ancestry.length;end++){if(wanted.length>end+1)continue;var match=true;for(p=0;p<wanted.length;p++)if(wanted[p]!==ancestry[end-wanted.length+1+p])match=false;if(match)return true;}return false;}
  for(i=0;i<tracks.length;i++){var t=tracks[i],u=decodeTrack(t&&t.url),candidates=u.file?aliases['$'+u.file+'#'+u.id]||[]:owners['$'+u.id]?[owners['$'+u.id]]:[],hits=[];for(var h=0;h<candidates.length;h++)if(qualified(candidates[h],u.anchor))hits.push(candidates[h]);if(hits.length!==1)fail('Animation track owner is missing or ambiguous: '+t.url);key='$'+JSON.stringify([hits[0].id,u.query]);if(own(map,key))fail('Multiple animation tracks bind the same property.');map[key]=i;}return map;}

 function keyAt(track,time){if(!track)return null;if(!arr(track.keys))fail('Animation track keys are unresolved.');var found=null,seen={};for(var i=0;i<track.keys.length;i++){var k=track.keys[i];validateKey(k);if(i&&track.keys[i-1][0]>=k[0])fail('Animation key times must be unique and ascending.');var key='$'+String(k[0]);if(own(seen,key))fail('Duplicate animation key times.');seen[key]=true;if(k[0]===time)found={index:i,raw:k};else if(Math.abs(k[0]-time)<1e-6)fail('Ambiguous near-duplicate animation key time.');}return found;}
 function nodeIndex(doc,id){var rows=doc.data.scene&&doc.data.scene.nodes||[],hit=-1;for(var i=0;i<rows.length;i++)if(rows[i].id===id){if(hit>=0)fail('Ambiguous object identity.');hit=i;}if(hit<0)fail('Object is missing.');return hit;}
 function hasInline(x){if(!x||typeof x!=='object')return false;if(own(x,'keys')||own(x,'keyframes'))return true;for(var k in x)if(own(x,k)&&k!=='formulas'&&hasInline(x[k]))return true;return false;}
 function validateProperty(editor,p,token){var expectedQuery=p.morph?'?value':p.key[0]==='general_scale'?'?general_scale/value':p.key[0]==='extra'?'?'+p.meta.id+'/value':p.key[0]==='channel'?'?'+p.key.slice(1).concat(['value']).join('/'):'?'+p.key.concat(['value']).join('/');if(canonicalQuery(token.query)!==canonicalQuery(expectedQuery))fail('Animation query does not match the verified property descriptor.');if(!scalar(p.type)||p.meta.alias||p.meta.target_channel)fail('Unsupported animation property type or alias.');if(p.key[0]==='perspective'||p.companions&&p.companions.length)fail('Coupled camera animation properties are not supported.');var rows=token.section==='modifier_library'?editor.doc.data.scene.modifiers||[]:editor.doc.data.scene.nodes||[];for(var i=0;i<rows.length;i++)if(rows[i].id===token.recordId&&hasInline(rows[i]))fail('Inline animation keys are not supported.');if(hasInline(p.meta))fail('Inherited inline animation keys are not supported.');
  // Formula validators are retained; only the supported scene track animation check is omitted.
  var old=editor.doc.data,view={},scene={},k;for(k in old)if(own(old,k))view[k]=old[k];for(k in old.scene)if(own(old.scene,k))scene[k]=old.scene[k];scene.animations=[];view.scene=scene;editor.doc.data=view;try{if(p.morph){SceneEditorMorphs.validateDependencies(editor,p);editor.morphState.selected[p.morph.path]=true;}else{var affected={},keys=[];editor.dependencyTargets(p,affected);for(k in affected)if(own(affected,k))keys.push(k);for(i=0;i<keys.length;i++)affected[keys[i]+'/value']=true;editor.scanDependencies(affected);}}finally{editor.doc.data=old;}
 }
 function prepare(io,paths,selected,direction,guard){guard=guard||function(){};if(!selected.length)fail('Select individual animation keys.');var sourcePath=paths[direction===1?1:0],targetPath=paths[direction===1?0:1];if(String(sourcePath).replace(/\\/g,'/').toLowerCase()===String(targetPath).replace(/\\/g,'/').toLowerCase())fail('Source and destination must be different files.');var source=new C.Document(sourcePath,io,guard),target=new C.Document(targetPath,io,guard),sourceFPS=fps(source),targetFPS=fps(target);if(sourceFPS!==targetFPS)fail('Scene FPS differs.');var sourceTracks=source.data.scene.animations||[],originalTracks=target.data.scene.animations||[],tracks=cp(originalTracks),sourceIndex=indexTracks(source,sourceTracks),targetIndex=indexTracks(target,tracks),sourceEditors={},targetEditors={},seen={},changes=[],overwrites=0;
  function getEditor(doc,token,cache){var key='$'+token.nodeId,e=cache[key];if(!e){e=new C.Editor(doc.path,io,guard,nodeIndex(doc,token.nodeId));cache[key]=e;}if(token.section==='modifier_library'&&!e._keyTransferMorphs){if(!e.discoverMorphs)fail('Morph editor unavailable.');e.discoverMorphs(e.index);e._keyTransferMorphs=true;}return e;}
  for(var i=0;i<selected.length;i++){guard('Prepare animation key '+(i+1)+' / '+selected.length);var d=selected[i],why=reason(d,direction);if(why)fail(why);if(d.fpsA!==sourceFPS||d.fpsB!==targetFPS)fail('Scene FPS changed since comparison.');var from=direction===1?d.transferB:d.transferA,to=direction===1?d.transferA:d.transferB,expectedFrom=direction===1?d.keyB:d.keyA,expectedTo=direction===1?d.keyA:d.keyB,sourceKey='$'+JSON.stringify([from.recordId,canonicalQuery(from.query)]),targetKey='$'+JSON.stringify([to.recordId,canonicalQuery(to.query)]),unique=targetKey+'|'+d.time;if(own(seen,unique)){if(!C.equal(seen[unique],expectedFrom))fail('Conflicting selected keys for one destination time.');continue;}seen[unique]=cp(expectedFrom);var vector=/^\?(translation|rotation|scale)\/[xyz]\/value$/.exec(canonicalQuery(to.query));if(vector){var vectorQueries=['?'+vector[1],'?'+vector[1]+'/value'];for(var vi=0;vi<vectorQueries.length;vi++)if(own(sourceIndex,'$'+JSON.stringify([from.recordId,vectorQueries[vi]]))||own(targetIndex,'$'+JSON.stringify([to.recordId,vectorQueries[vi]])))fail('Vector animation tracks cannot be mixed with scalar key transfer.');}var si=sourceIndex[sourceKey],ti=targetIndex[targetKey],sourceTrack=si===undefined?null:sourceTracks[si],originalTrack=ti===undefined?null:originalTracks[ti],sourceHit=keyAt(sourceTrack,d.time),targetHit=keyAt(originalTrack,d.time);assertExpected(sourceHit&&sourceHit.raw,expectedFrom,d.time,from.type);assertExpected(targetHit&&targetHit.raw,expectedTo,d.time,to.type);if(!sourceHit)fail('Source key is absent.');var se=getEditor(source,from,sourceEditors),te=getEditor(target,to,targetEditors),sp=SceneEditorCompareTransfer.property(se,from),tp=SceneEditorCompareTransfer.property(te,to);validateProperty(se,sp,from);validateProperty(te,tp,to);if(sp.type!==tp.type)fail('Animation property types differ.');if(tp.type==='enum'&&!C.equal(sp.meta.enum_values,tp.meta.enum_values))fail('Enum domains differ.');C.validate(sp,sourceHit.raw[1]);te.set(tp.id,cp(sourceHit.raw[1]));
   if(ti===undefined){ti=tracks.length;targetIndex[targetKey]=ti;tracks.push({url:'#'+encodeURIComponent(to.recordId)+canonicalQuery(to.query),keys:[]});}var destination=tracks[ti],current=keyAt(destination,d.time);if(current)destination.keys[current.index]=cp(sourceHit.raw);else{destination.keys.push(cp(sourceHit.raw));destination.keys.sort(function(a,b){return a[0]-b[0];});}if(targetHit)overwrites++;changes.push({object:te.camera.label||te.camera.id,label:d.label,time:d.time,frame:d.time*sourceFPS,before:targetHit?cp(targetHit.raw):null,after:cp(sourceHit.raw)});
  }
  var ops=own(target.data.scene,'animations')?[{kind:'replace',path:['scene','animations'],value:tracks}]:[{kind:'add',path:['scene'],key:'animations',value:tracks}],text=target.patch(ops),expected=cp(target.data);expected.scene.animations=tracks;var parsed=C.parseDocument(text,guard,[]);if(!C.equal(parsed,expected))fail('Animation key patch verification failed.');function verify(){source.verify();target.verify();var k,e;for(k in sourceEditors)if(own(sourceEditors,k)){e=sourceEditors[k];e.doc.verify();e.resolver.verify();if(e.verifyMorphSources)e.verifyMorphSources();}for(k in targetEditors)if(own(targetEditors,k)){e=targetEditors[k];e.doc.verify();e.resolver.verify();if(e.verifyMorphSources)e.verifyMorphSources();}}verify();return{kind:'animationKeys',source:sourcePath,target:targetPath,document:target,text:text,changes:changes,overwrites:overwrites,fps:sourceFPS,verify:verify,committed:false};
 }
 return{reason:reason,prepare:prepare,validateKey:validateKey};

// Pure import identity and legacy filename policy. No scene or filesystem access.
var SaveGuardImportPolicy=(function(){
 function need(v,m){if(!v)throw Error("Import: "+m);}
 function norm(p){return String(p||"").replace(/\\/g,"/");}
 function pathKey(p){p=norm(p);return /^(?:[A-Za-z]:\/|\/\/)/.test(p)?p.toLowerCase():p;}
 function leaf(p){return norm(p).split('/').pop();}
 function legacy(path){var name=leaf(path),m=/^(.*)_(\d{2})-(\d{2})-(\d{2})_(\d{2})-(\d{2})-(\d{2})\.duf$/i.exec(name);if(!m)return null;var y=2000+Number(m[4]),mo=Number(m[3])-1,day=Number(m[2]),h=Number(m[5]),mi=Number(m[6]),sec=Number(m[7]),d=new Date(y,mo,day,h,mi,sec);if(!m[1]||d.getFullYear()!==y||d.getMonth()!==mo||d.getDate()!==day||d.getHours()!==h||d.getMinutes()!==mi||d.getSeconds()!==sec)return null;var suffix=m[2]+'-'+m[3]+'-'+m[4]+'_'+m[5]+'-'+m[6]+'-'+m[7];return {label:m[1],imageStem:m[1]+'.duf_'+suffix,dateText:m[4]+'-'+m[3]+'-'+m[2]+' '+m[5]+':'+m[6]+':'+m[7],epoch:d.getTime(),timeZone:'interpreted in current local timezone; original timezone unknown',origin:'filename-local-inferred'};}
 function identity(source,mode,legacyCase){need(source&&typeof source.path==='string'&&source.bytes>0&&isFinite(source.bytes)&&isFinite(source.modified),'Missing source identity');return JSON.stringify([legacyCase===true?norm(source.path).toLowerCase():pathKey(source.path),source.bytes,source.modified,mode==='saveguard1'?'saveguard1':'external-duf']);}
 // Derive presentation and maintenance grouping from original paths; never rewrite stored manifests.
 function group(m){var p=norm(m.source),old=m.imported.origin==='saveguard1'?legacy(p):null;return old?JSON.stringify(['saveguard1',pathKey(p.substring(0,p.lastIndexOf('/'))),old.label]):pathKey(p);}
 function manifest(source,folder,roots,transaction,mode,at){var old=mode==='saveguard1'?legacy(source.path):null;need(mode!=='saveguard1'||old,'Unrecognized or invalid SaveGuard 1 filename date');var name=leaf(source.path);need(/\.duf$/i.test(name)&&name!=='.duf','Choose a DUF file');return {schema:4,backupPolicy:'manual-import',status:'complete',source:norm(source.path),folder:norm(folder),backupRoot:norm(roots.backup),projectRoot:norm(roots.project),session:transaction.session,operation:transaction.operation,sceneLabel:old?old.label:name.replace(/\.duf$/i,''),scene:{file:name,source:norm(source.path),bytes:source.bytes,verification:'native-copy-size-and-source-metadata'},imported:{schema:1,owner:'SaveGuardImport',origin:mode,identity:identity(source,mode),originalPath:norm(source.path),importedAtEpochMs:at,sourceModified:source.modified,savedAtEpochMs:old?old.epoch:null,dateEvidence:old?old.origin:'unknown',timeZone:old?old.timeZone:'unknown',group:old?JSON.stringify(['saveguard1',pathKey(norm(source.path).substring(0,norm(source.path).lastIndexOf('/'))),old.label]):pathKey(source.path)},companions:[]};}
 // Earlier imports folded every path. Accept those records, but duplicate lookup recomputes the current key.
 function valid(m){try{return !!(m&&m.schema===4&&m.backupPolicy==='manual-import'&&m.status==='complete'&&m.imported&&m.imported.schema===1&&m.imported.owner==='SaveGuardImport'&&/^(external-duf|saveguard1)$/.test(m.imported.origin)&&m.source===m.imported.originalPath&&m.scene&&m.scene.source===m.source&&leaf(m.source)===m.scene.file&&m.scene.bytes>0&&(m.scene.verification==='native-copy-size-and-source-metadata'||m.scene.verification==='byte-equality-and-source-metadata')&&(m.imported.identity===identity({path:m.source,bytes:m.scene.bytes,modified:m.imported.sourceModified},m.imported.origin)||m.imported.identity===identity({path:m.source,bytes:m.scene.bytes,modified:m.imported.sourceModified},m.imported.origin,true))&&typeof m.imported.importedAtEpochMs==='number'&&isFinite(m.imported.importedAtEpochMs)&&typeof m.imported.group==="string"&&m.imported.group.length>0);}catch(invalid){return false;}}
 return {pathKey:pathKey,group:group,legacy:legacy,identity:identity,manifest:manifest,valid:valid};
}());

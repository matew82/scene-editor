/* Explicit, verified static-value transfer. Never writes either source during preparation. */
var SceneEditorCompareTransfer=(function(){
 function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}function copy(x){return JSON.parse(JSON.stringify(x));}function fail(m){throw Error(m);}function equal(a,b){return SceneEditorCore.equal(a,b);}
 function supported(t){return ['float','int','enum','bool','string','float2','float3','int2','color','float_color'].indexOf(t)>=0;}
 function reason(d,direction){if(d&&d.kind==='renderSetting')return (typeof SceneEditorRenderMapTransfer!=='undefined'&&SceneEditorRenderMapTransfer.supportsPath(d.path)?SceneEditorRenderMapTransfer:SceneEditorRenderTransfer).reason(d,direction||0);if(d&&d.kind==='animationKey')return SceneEditorKeyTransfer.reason(d,direction||0);if(!d||d.section&&d.section!=='Parameters')return 'Only individual parameter values can be copied; materials and other rows are not supported.';if(d.status!=='Changed')return 'Only known changed values can be copied.';if(!d.transferA||!d.transferB)return 'A property is missing or has no verified binding in one scene.';var a=d.transferA,b=d.transferB;if((direction===1?b:a).missingStandardColor)return 'No saved color exists in the source scene.';if(a.issue||b.issue)return 'Unresolved property: '+(a.issue||b.issue);if(a.animated||b.animated)return 'Animated properties cannot be copied as static values.';if(!supported(a.type)||!supported(b.type))return 'Unsupported property type: '+a.type+' / '+b.type+'. File paths, object references and aliases are not copied.';if(a.type!==b.type)return 'Source and destination property types differ.';if(equal(d.valueA,d.valueB))return 'The values are already equal.';return '';}
 function eligible(d,direction){return !reason(d,direction);}
 function selectionEligibility(selected,direction){var render=false,other=false;for(var ri=0;ri<selected.length;ri++){if(selected[ri].kind==='renderSetting')render=true;else other=true;}if(render)return other?{allowed:false,reason:'Select render settings separately from object parameters and animation keys.'}:renderEligibility(selected,direction);if(!selected.length)return{allowed:false,reason:'Select values to copy.'};var keys=selected[0].kind==='animationKey';for(var i=0;i<selected.length;i++){var d=selected[i];if((d.kind==='animationKey')!==keys)return{allowed:false,reason:'Select animation keys separately from static values.'};if(keys){var why=SceneEditorKeyTransfer.reason(d,direction);if(why)return{allowed:false,reason:why};}else{var a=d.typeA||d.transferA&&d.transferA.type,b=d.typeB||d.transferB&&d.transferB.type;if((direction===1?d.transferB:d.transferA)&& (direction===1?d.transferB:d.transferA).missingStandardColor)return{allowed:false,reason:'No saved color exists in the source scene.'};if(d.section&&d.section!=='Parameters'||!supported(a)||a!==b)return{allowed:false,reason:'Select matching supported property types. Numbers, text, booleans and colors can be copied.'};}}return{allowed:true,reason:'Copy the selected values. Safety checks run when you save.'};}
 // Use the writer's complete dry-run contract in each direction, not a second approximation.
 function assess(io,paths,selected,direction,guard){if(!selected.length)return{allowed:false,reason:'Select individual changed parameter rows.'};for(var i=0;i<selected.length;i++){var why=(selected[i].kind==='animationKey')!==(selected[0].kind==='animationKey')?'Select animation keys separately from static values.':reason(selected[i],direction);if(why)return{allowed:false,reason:(selected[i]&&selected[i].label?selected[i].label+': ':'')+why};}try{prepare(io,paths,selected,direction,guard);return{allowed:true,reason:'Copy the selected values or keys after confirmation. A verified backup will be kept.'};}catch(e){if(e.code==='CANCELLED')throw e;return{allowed:false,reason:String(e.message||e)};}}

 function needRenderMode(rows,map){for(var i=0;i<rows.length;i++)if((typeof SceneEditorRenderMapTransfer!=='undefined'&&SceneEditorRenderMapTransfer.supportsPath(rows[i].path))!==map)fail('Select complete maps separately from other render values.');}
 function renderEligibility(rows,direction){var map=typeof SceneEditorRenderMapTransfer!=='undefined'&&SceneEditorRenderMapTransfer.supportsPath(rows[0].path);try{needRenderMode(rows,map);}catch(e){return{allowed:false,reason:String(e.message||e)};}return (map?SceneEditorRenderMapTransfer:SceneEditorRenderTransfer).selectionEligibility(rows,direction);}
 function nodeIndex(doc,id){var rows=doc.data.scene&&doc.data.scene.nodes||[],index=-1;for(var i=0;i<rows.length;i++)if(rows[i].id===id){if(index>=0)fail('Ambiguous object identity: '+id);index=i;}if(index<0)fail('Object is no longer available: '+id);return index;}
 function property(editor,token){var ids=[],parts=JSON.parse(token.channelKey),i,p,key=null;var records=token.section==='modifier_library'?editor.doc.data.scene.modifiers||[]:editor.doc.data.scene.nodes||[],record=null;for(i=0;i<records.length;i++)if(records[i].id===token.recordId){if(record)fail('Ambiguous saved record');record=records[i];}if(!record||token.recordURL!==undefined&&(record.url||record.source||'')!==token.recordURL)fail('Property binding changed since comparison.');
  if(token.section==='node_library'){
   if(['translation','rotation','scale','orientation','center_point','end_point'].indexOf(parts[0])>=0)key=[parts[0],token.channelId];
   else if(parts[0]==='general_scale')key=['general_scale'];
   else if(parts[0]==='extra')key=['extra',parts[1],token.channelId];
   else if(parts[0]==='perspective'&&parts.length===2&&!token.channelId)key=parts;
   else if(parts[0]==='channel'&&parts.length===2)key=['channel',token.channelId];
   else if(token.channelId)key=['channel'].concat(parts.slice(0,-1)).concat([token.channelId]);
   if(key&&editor.props[JSON.stringify(key)])ids.push(editor.props[JSON.stringify(key)]);
  }else if(token.section==='modifier_library'){
   for(i=0;i<editor.order.length;i++){p=editor.props[editor.order[i]];if(!p.morph||p.meta.id!==token.channelId)continue;var existing=p.morph.existingIndex,mods=editor.doc.data.scene.modifiers||[];if(existing!==null&&existing!==undefined&&mods[existing]&&mods[existing].id===token.recordId)ids.push(p);}
  }
  if(ids.length!==1)fail('Property has no unique supported write binding: '+token.channelId);p=ids[0];
  if(p.issue||p.bindingWarning)fail(p.issue||p.bindingWarning);if(p.type!==token.type||!equal(p.value,token.value))fail('Property changed since comparison; compare again: '+p.label);return p;
 }
 function missingNodeColor(editor,t,source){
  var key=['extra','studio_node_channels','Node Color'],id=JSON.stringify(key);
  if(t.section!=='node_library'||t.channelId!=='Node Color'||t.type!=='color'||source.type!=='color'||source.meta.id!=='Node Color'||JSON.stringify(source.key)!==id||t.channelKey!=='["extra","studio_node_channels","channels","Node Color","Node Color"]'||editor.props[id]||editor.camera.id!==t.recordId||(editor.camera.url||editor.camera.source||'')!==t.recordURL)fail('Missing Node Color binding changed; compare again.');
  var meta={id:'Node Color',type:'color',label:'Node Color',value:[0,0,0],min:0,max:1,clamped:true};
  var p={key:key,id:id,label:'Node Color',meta:meta,type:'color',value:null,layers:[{doc:source.layers[0].doc,path:['standardNodeColor'],channel:meta}],companions:[],issue:''};
  editor.props[id]=p;editor.order.push(id);return p;
 }
 function dependencies(editor,p){if(p.morph){SceneEditorMorphs.validateDependencies(editor,p);return;}var affected={},k,keys=[];editor.dependencyTargets(p,affected);for(k in affected)if(own(affected,k))keys.push(k);for(var i=0;i<keys.length;i++)affected[keys[i]+'/value']=true;editor.scanDependencies(affected);}
 // Reuse one original byte witness, but apply each object's validated plan to the in-memory stage.
 function prepare(io,paths,selected,direction,guard){var render=false,other=false;for(var ri=0;ri<selected.length;ri++){if(selected[ri].kind==='renderSetting')render=true;else other=true;}if(render){if(other)fail('Select render settings separately from object parameters and animation keys.');var map=typeof SceneEditorRenderMapTransfer!=='undefined'&&SceneEditorRenderMapTransfer.supportsPath(selected[0].path);needRenderMode(selected,map);return (map?SceneEditorRenderMapTransfer:SceneEditorRenderTransfer).prepare(io,paths,selected,direction,guard);}var keyMode=selected.length&&selected[0].kind==='animationKey';for(var si=0;si<selected.length;si++)if((selected[si].kind==='animationKey')!==!!keyMode)fail('Select animation keys separately from static values.');if(keyMode)return SceneEditorKeyTransfer.prepare(io,paths,selected,direction,guard);guard=guard||function(){};var sourcePath=paths[direction===0?0:1],targetPath=paths[direction===0?1:0];if(String(sourcePath).replace(/\\/g,'/').toLowerCase()===String(targetPath).replace(/\\/g,'/').toLowerCase())fail('Source and destination must be different files.');if(!selected.length)fail('Select individual parameter differences first.');
  var source=new SceneEditorCore.Document(sourcePath,io,guard),original=new SceneEditorCore.Document(targetPath,io,guard),stage={text:original.text,data:original.data},groups={},order=[],sourceEditors={},editors=[],changes=[],seen={},i;
  for(i=0;i<selected.length;i++){var d=selected[i];if(!eligible(d,direction))fail('Selection contains an unsupported, animated or unresolved parameter.');var from=direction===0?d.transferA:d.transferB,to=direction===0?d.transferB:d.transferA,unique=JSON.stringify([to.nodeId,to.section,to.recordId,to.channelKey]);if(seen[unique])continue;seen[unique]=true;var key='$'+to.nodeId;if(!groups[key]){groups[key]=[];order.push(key);}groups[key].push({from:from,to:to,label:d.label});}
  function proxy(doc,current){var p={},k;for(k in io)if(own(io,k))p[k]=io[k];p.readDocument=function(path,g,targeted){if(path===doc.path&&!targeted)return{identity:doc.raw,text:current.text,data:current.data,gzip:doc.gzip,formulaEvidence:doc.formulaEvidence};if(io.readDocument)return io.readDocument(path,g,targeted);fail('Native document adapter is required for asset reads.');};return p;}
  var sourceIO=proxy(source,source);
  function getSource(t){var k='$'+t.nodeId,e=sourceEditors[k];if(!e){e=new SceneEditorCore.Editor(sourcePath,sourceIO,guard,nodeIndex(source,t.nodeId));sourceEditors[k]=e;}if(t.section==='modifier_library'&&!e._transferMorphs){if(!e.discoverMorphs)fail('Morph editor unavailable');e.discoverMorphs(e.index);e._transferMorphs=true;}return e;}
  for(i=0;i<order.length;i++){guard('Prepare parameter transfer '+(i+1)+' / '+order.length);var list=groups[order[i]],targetIO=proxy(original,stage),e=new SceneEditorCore.Editor(targetPath,targetIO,guard,nodeIndex(original,list[0].to.nodeId)),needsMorphs=false,j;for(j=0;j<list.length;j++)if(list[j].to.section==='modifier_library')needsMorphs=true;if(needsMorphs){if(!e.discoverMorphs)fail('Morph editor unavailable');e.discoverMorphs(e.index);}
   for(j=0;j<list.length;j++){guard();var item=list[j],se=getSource(item.from),sp=property(se,item.from),tp=item.to.missingStandardColor?missingNodeColor(e,item.to,sp):property(e,item.to);if(sp.type!==tp.type)fail('Property types differ: '+item.label);if(tp.type==='enum'&&!equal(sp.meta.enum_values,tp.meta.enum_values))fail('Enum domains differ: '+item.label);if(sp.meta.alias||sp.meta.target_channel||tp.meta.alias||tp.meta.target_channel)fail('Alias transfer is not supported.');dependencies(se,sp);dependencies(e,tp);if(sp.morph)se.morphState.selected[sp.morph.path]=true;e.set(tp.id,copy(sp.value));changes.push({object:e.camera.label||e.camera.id,label:tp.label,before:item.to.missingStandardColor?'Not defined':copy(tp.value),after:copy(sp.value),addedStandardColor:!!item.to.missingStandardColor});}
   var plan=e.build();stage={text:plan.text,data:plan.expected};editors.push(e);
  }
  function verify(){source.verify();original.verify();for(var k in sourceEditors)if(own(sourceEditors,k)){sourceEditors[k].resolver.verify();if(sourceEditors[k].verifyMorphSources)sourceEditors[k].verifyMorphSources();}for(var n=0;n<editors.length;n++){editors[n].resolver.verify();if(editors[n].verifyMorphSources)editors[n].verifyMorphSources();}}
  verify();return{source:sourcePath,target:targetPath,changes:changes,document:original,text:stage.text,verify:verify,committed:false};
 }
 function commit(plan,io,backup,guard){if(plan.overwrites>0&&!plan.overwriteConfirmed)fail('Explicit confirmation to overwrite existing animation keys is required.');if(plan.committed)fail('This transfer was already saved.');guard=guard||function(){};guard('Verify transfer sources');plan.verify();var backupPath=backup(plan.document,guard);if(!backupPath)fail('Verified backup is required.');guard('Save transferred values');var result=io.install(plan.document,plan.text,guard,plan.verify);plan.committed=true;return{kind:plan.kind||'staticValues',file:plan.target,source:plan.source,backup:backupPath,parameters:plan.changes.length,result:result};}
 function nativeBackup(env,io){return function(doc,guard){guard('Back up destination scene');var path=doc.path+'.before-transfer-'+new Date().getTime()+'-'+Math.floor(Math.random()*1000000000)+'.duf',info=new env.DzFileInfo(path);if(info.exists()||info.isSymLink&&info.isSymLink())fail('Backup path already exists.');doc.verify();if(!new env.DzFile(doc.path).copy(path))fail('Cannot create backup: '+path);var identity=io.signature(path);if(!equal(identity.chunks,doc.raw.chunks))fail('Backup verification failed; destination was not changed: '+path);doc.verify();return path;};}
 return{eligible:eligible,reason:reason,selectionEligibility:selectionEligibility,assess:assess,property:property,prepare:prepare,commit:commit,nativeBackup:nativeBackup};
}());

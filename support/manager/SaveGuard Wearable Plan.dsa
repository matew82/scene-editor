var SaveGuardWearablePlan=(function(){
    function own(o,k){return Object.prototype.hasOwnProperty.call(o,k);}
    function copy(o){var r={},k;for(k in o)if(own(o,k))r[k]=o[k];return r;}
    function clone(o){return JSON.parse(JSON.stringify(o));}
    function fail(s){throw Error("Wearable plan: "+s);}
    // Compatibility is pinned to the actual saved Fit To figure asset; no cross-generation conversion.
    function decoded(s){try{return decodeURIComponent(String(s));}catch(e){fail("Invalid asset URI");}}
    function shellPrepare(doc,id,domain,options){
        var rows=doc.scene.nodes,root=null,i,j,k,owner=null;
        function isShell(n){var e=n&&n.extra||[];for(var q=0;q<e.length;q++)if(e[q].type==='studio/node/shell')return true;return false;}
        for(i=0;i<rows.length;i++)if(rows[i].id===id)root=rows[i];
        if(!isShell(root))return null;
        function local(s){var r=domain.parseURI(s||'');return r.kind==='local'&&!r.query&&!r.nodePath?r.fragment:null;}
        var ownerId=local(root.parent);if(!ownerId||root.conform_target||root.parent_in_place)fail('Standalone shell requires one explicit parent and no Fit To link');
        for(i=0;i<rows.length;i++)if(rows[i].id===ownerId){if(owner)fail('Ambiguous shell parent');owner=rows[i];}
        if(!owner||!owner.url||!owner.geometries||owner.geometries.length!==1)fail('Shell parent geometry identity unavailable');
        var ownerRef=domain.parseURI(owner.url),geoRef=domain.parseURI(owner.geometries[0].url||'');
        if(!ownerRef.file||!ownerRef.fragment||!geoRef.file||!geoRef.fragment)fail('Standalone shell requires external parent and geometry definitions');
        var detached=copy(doc);detached.scene=copy(doc.scene);detached.scene.nodes=rows.slice(0);var changed=clone(root),links=0;
        delete changed.parent;
        for(i=0;i<(changed.extra||[]).length;i++)for(j=0;j<(changed.extra[i].channels||[]).length;j++){var ch=changed.extra[i].channels[j].channel;if(ch&&ch.id==='Shell Node'){if(ch.type!=='node'||local(ch.node)!==ownerId||own(ch,'keys'))fail('Shell Node binding differs from parent');delete ch.node;links++;}}
        if(links!==1)fail('Standalone shell needs exactly one saved Shell Node binding');
        if(!changed.geometries||changed.geometries.length!==1)fail('Standalone shell geometry is ambiguous');
        var geometry=changed.geometries[0],shellGeometry=false;for(i=0;i<(geometry.extra||[]).length;i++)if(geometry.extra[i].type==='studio/geometry/shell')shellGeometry=true;
        if(!shellGeometry)fail('Saved shell geometry marker missing');
        var rootIndex=rows.indexOf(root);detached.scene.nodes[rootIndex]=changed;
        var plan=domain.plan(detached,[id],{fullData:true,preserveAnimation:true,resolveAssetDocument:options.resolveAssetDocument});if(!plan.ready)fail('Incomplete standalone shell closure: '+plan.errors.join('; '));
        var allowed={},pending=[id];for(i=0;i<pending.length;i++){if(allowed['$'+pending[i]])fail('Cyclic shell descendants');allowed['$'+pending[i]]=true;for(j=0;j<rows.length;j++)if(local(rows[j].parent)===pending[i])pending.push(rows[j].id);}for(i=0;i<plan.nodeIds.length;i++)if(!allowed['$'+plan.nodeIds[i]])fail('Standalone shell dependency is outside selected descendants: '+plan.nodeIds[i]);
        return {document:detached,plan:plan,targetContract:{shell:true,assetUri:owner.url,geometryUri:owner.geometries[0].url,groups:root.extra.filter(function(e){return e.type==='studio/node/shell';})[0].polygon_material_groups||[],collisionCount:0},wrapReadRecords:function(read){return function(requests){var result=read(requests),items=result['scene.nodes']||[];for(var q=0;q<items.length;q++)if(items[q].index===rootIndex)items[q]={index:rootIndex,record:changed};return result;};},validateBuilt:function(built){var d=built.document;if(d.scene.animations&&d.scene.animations.length)fail('Animated standalone shell is not supported');if(d.scene.nodes.some(function(n){return n.id===built.mapId(ownerId);}))fail('Shell payload includes its parent');return true;}};
    }

    function boneParentPrepare(doc,id,domain,options){
        var rows=doc.scene.nodes,by={},root=null,i,j,seen={},cache={},chain=[],cursor,owner,boneName;
        function ref(s){return domain.parseURI(s||'');}
        function local(s){var r=ref(s);return r.kind==='local'&&!r.query&&!r.nodePath?r.fragment:null;}
        for(i=0;i<rows.length;i++){if(by['$'+rows[i].id])fail('Duplicate source node identity');by['$'+rows[i].id]=rows[i];if(rows[i].id===id)root=rows[i];}
        if(!root||root.conform_target||!local(root.parent)||root.parent_in_place)return null;
        function definition(n){var r=ref(n.url);if(r.kind!=='external'||r.nodePath||r.query)fail('Bone-parent branch requires explicit external node definition');var a=cache['$'+r.file];if(!a){a=options.resolveAssetDocument(r.file);if(!a||a.verified!==true||!a.document)fail('Unverified bone-parent asset');cache['$'+r.file]=a;}var hit=null,lib=a.document.node_library||[];for(var q=0;q<lib.length;q++)if(lib[q].id===r.fragment){if(hit)fail('Ambiguous bone-parent definition');hit=lib[q];}if(!hit||hit.source)fail('Unsupported inherited bone-parent definition');return {node:hit,file:decoded(r.file)};}
        cursor=by['$'+local(root.parent)];if(!cursor)return null;var first=definition(cursor);if(first.node.type!=='bone')return null;
        var ownDef=definition(root);if(ownDef.node.type!=='figure'&&!(ownDef.node.type==='node'&&root.geometries&&root.geometries.length===1))fail('Bone-parent branch requires a saved figure or single-geometry prop');
        boneName=first.node.name||first.node.id;if(typeof boneName!=='string'||!boneName)fail('Missing saved parent bone name');
        while(cursor){if(seen['$'+cursor.id])fail('Cyclic source bone parent');seen['$'+cursor.id]=true;var def=definition(cursor);if(def.node.type==='figure'){owner=cursor;break;}if(def.node.type!=='bone')fail('Bone ancestry contains a non-bone');chain.push({instance:cursor,definition:def});cursor=by['$'+local(cursor.parent)];}
        if(!owner)fail('Bone owner figure unavailable');var ownerDef=definition(owner),names={};var ownerAsset=cache['$'+ref(owner.url).file];for(i=0;i<ownerAsset.document.node_library.length;i++){var nd=ownerAsset.document.node_library[i];if(nd.type==='bone'){var nm=nd.name||nd.id;if(names['$'+nm])fail('Ambiguous owner bone names');names['$'+nm]=true;}}
        for(i=0;i<chain.length;i++){var next=i+1<chain.length?chain[i+1]:{instance:owner,definition:ownerDef};if(chain[i].definition.file!==ownerDef.file||local(chain[i].definition.node.parent)!==next.definition.node.id)fail('Saved parent bone ancestry differs from asset');}
        var detached=copy(doc);detached.scene=copy(doc.scene);detached.scene.nodes=rows.slice(0);var changed=clone(root),index=rows.indexOf(root);delete changed.parent;detached.scene.nodes[index]=changed;
        var allowed={},pending=[id];for(i=0;i<pending.length;i++){if(allowed['$'+pending[i]])fail('Cyclic wearable descendants');allowed['$'+pending[i]]=true;for(j=0;j<rows.length;j++)if(local(rows[j].parent)===pending[i])pending.push(rows[j].id);}
        var plan=domain.plan(detached,[id],{fullData:true,preserveAnimation:true,resolveAssetDocument:options.resolveAssetDocument});if(!plan.ready)fail('Incomplete bone-parent wearable closure: '+plan.errors.join('; '));for(i=0;i<plan.nodeIds.length;i++)if(!allowed['$'+plan.nodeIds[i]])fail('Bone-parent payload would import outside selected descendants');
        return {document:detached,plan:plan,targetContract:{boneParent:true,parentURI:'name://@selection/'+encodeURIComponent(boneName)+':',assetUri:owner.url,collisionCount:0},wrapReadRecords:function(read){return function(requests){var out=read(requests),items=out['scene.nodes']||[];for(var q=0;q<items.length;q++)if(items[q].index===index)items[q]={index:index,record:changed};return out;};},validateBuilt:function(built){if(built.document.scene.animations&&built.document.scene.animations.length)fail('Animated bone-parent wearable is not supported');if(built.document.scene.nodes.some(function(n){return n.id===built.mapId(owner.id);}))fail('Bone-parent payload contains owner');return true;}};
    }

    // Native Mesh Grab serialization: preserve sparse deltas; never bake them into geometry.
    function validateMeshGrabs(doc,domain,asset){
        var marker='studio/modifier/manfriday_mesh_grab_modifier',nodes=doc.scene.nodes||[],mods=doc.scene.modifiers||[],library=doc.modifier_library||[],used={},counts={},definitions={},instances=0,total=0,i;
        function array(v){return Object.prototype.toString.call(v)==='[object Array]';}
        function extras(row){var out=[];for(var n=0;n<(row.extra||[]).length;n++)if(row.extra[n].type===marker)out.push(row.extra[n]);if(out.length>1)fail('Ambiguous Mesh Grab extension');return out[0]||null;}
        function local(ref){var p=domain.parseURI(ref||'');return p.kind==='local'&&!p.nodePath&&!p.query?p.fragment:null;}
        function node(id){var hit=null;for(var n=0;n<nodes.length;n++)if(nodes[n].id===id){if(hit)fail('Ambiguous Mesh Grab owner');hit=nodes[n];}if(!hit)fail('Mesh Grab owner is outside the selected wearable');return hit;}
        function absolute(file,base){if(file.charAt(0)==='/'||!base)return file;var parts=(base.substring(0,base.lastIndexOf('/')+1)+file).split('/'),out=[];for(var p=0;p<parts.length;p++){if(parts[p]==='..'){if(!out.length)fail('Mesh Grab dependency escapes content root');out.pop();}else if(parts[p]&&parts[p]!=='.')out.push(parts[p]);}return (base.charAt(0)==='/'?'/':'')+out.join('/');}
        function resolve(ref,scope,base,group){var p=domain.parseURI(ref||''),target=scope,file=base;if((p.kind!=='local'&&p.kind!=='external')||p.query||p.nodePath)fail('Mesh Grab definition reference is unresolved');if(p.kind==='external'){file=absolute(p.file,base);var loaded=asset(file);if(!loaded||loaded.verified!==true||!loaded.document)fail('Mesh Grab dependency is unverified');target=loaded.document;}var rows=target[group]||[],hit=null;for(var n=0;n<rows.length;n++)if(rows[n].id===p.fragment){if(hit)fail('Ambiguous Mesh Grab definition');hit=rows[n];}if(!hit)fail('Mesh Grab definition is missing');return{row:hit,document:target,file:file};}
        function sameRef(a,b,base){var x=domain.parseURI(a||''),y=domain.parseURI(b||'');return !x.query&&!y.query&&!x.nodePath&&!y.nodePath&&(x.kind===y.kind||x.kind==='local'&&base&&y.kind==='external')&&x.fragment===y.fragment&&decoded(x.kind==='local'&&base?base:absolute(x.file||'',base||''))===decoded(y.file||'');}
        function vertices(owner){var key='$'+owner.id;if(own(counts,key))return counts[key];var geometries=owner.geometries||[];if(geometries.length!==1)fail('Mesh Grab requires an unambiguous saved owner geometry');var resolved=resolve(geometries[0].url,doc,'','geometry_library'),count=resolved.row.vertices&&resolved.row.vertices.count;if(typeof count!=='number'||!isFinite(count)||count<1||Math.floor(count)!==count)fail('Mesh Grab geometry vertex count is unavailable');return counts[key]=count;}
        function table(row,scope,base,owner,seen){var key=JSON.stringify([base,scope===doc&&mods.indexOf(row)>=0?'instance':'definition',row.id]),e=extras(row),data=e&&e.mf_deltas,ownParent=row.parent;if(seen[key])fail('Cyclic Mesh Grab definition');seen[key]=true;if(scope===doc&&library.indexOf(row)>=0)used['$'+row.id]=true;
            if(ownParent&&scope!==doc||ownParent&&library.indexOf(row)>=0){var parentMatches=sameRef(ownParent,owner.url,base),geometries=owner.geometries||[];for(var g=0;!parentMatches&&g<geometries.length;g++)parentMatches=sameRef(ownParent,geometries[g].url,base);if(!parentMatches)fail('Mesh Grab definition is bound to another geometry owner');}
            var reference=row.url||row.source;if(reference){var inherited=resolve(reference,scope,base,'modifier_library'),prior=table(inherited.row,inherited.document,inherited.file,owner,seen);if(data===undefined)data=prior;}
            return data;
        }
        function inspect(data,owner){if(!data||typeof data!=='object'||!array(data.values)||typeof data.count!=='number'||Math.floor(data.count)!==data.count||data.count<0||data.count!==data.values.length)fail('Invalid saved Mesh Grab delta table');var count=vertices(owner);for(var n=0;n<data.values.length;n++){var v=data.values[n];if(!array(v)||v.length!==4||typeof v[0]!=='number'||Math.floor(v[0])!==v[0]||v[0]<0||v[0]>=count)fail('Mesh Grab vertex index differs from its saved geometry');for(var a=1;a<4;a++)if(typeof v[a]!=='number'||!isFinite(v[a]))fail('Invalid saved Mesh Grab displacement');}total+=data.values.length;}
        for(i=0;i<library.length;i++)if(extras(library[i])){if(own(definitions,'$'+library[i].id))fail('Duplicate Mesh Grab definition');definitions['$'+library[i].id]=library[i];}
        for(i=0;i<mods.length;i++){var row=mods[i],reference=local(row.url);if(!extras(row)&&!definitions['$'+reference])continue;var ownerId=local(row.parent);if(!ownerId)fail('Mesh Grab instance owner is unresolved');var owner=node(ownerId),data=table(row,doc,'',owner,{});inspect(data,owner);instances++;}
        for(var key in definitions)if(own(definitions,key)&&!used[key])fail('Mesh Grab definition has no selected wearable instance');
        return{instances:instances,deltas:total};
    }

    function prepare(doc,id,domain,options){
        var shell=shellPrepare(doc,id,domain,options);if(shell)return shell;var boneParent=boneParentPrepare(doc,id,domain,options);if(boneParent)return boneParent;
        var rows=doc&&doc.scene&&doc.scene.nodes,root=null,owner=null,by={},i,j,k,rootIndex=-1,changed={},allowed={},queue=[id],children={};
        if(!rows||!options||typeof options.resolveAssetDocument!=="function")fail("Full saved source and verified resolver required");
        for(i=0;i<rows.length;i++){if(by["$"+rows[i].id])fail("Duplicate source node identity");by["$"+rows[i].id]=rows[i];if(rows[i].id===id){root=rows[i];rootIndex=i;}var p=rows[i].parent;if(p){var parentRef=domain.parseURI(p);if(parentRef.kind==='local'&&!parentRef.query&&!parentRef.nodePath)p='#'+parentRef.fragment;if(!children[p])children[p]=[];children[p].push(rows[i].id);}}
        if(!root||!root.url)fail("Saved garment root is missing");
        if(typeof root.parent!=="string"||root.parent.charAt(0)!=="#"||decoded(root.parent)!==decoded(root.conform_target)||root.parent_in_place)fail("Saved garment must have a direct figure parent matching its Fit To target; detached wardrobe storage needs explicit recovery");
        owner=by["$"+domain.parseURI(root.parent).fragment];if(!owner||!owner.url)fail("Saved Fit To figure is missing");
        var localGarment=domain.parseURI(root.url).kind==='local',assetCache={};
        function asset(file){if(!assetCache['$'+file]){var a=options.resolveAssetDocument(file);if(!a||a.verified!==true||!a.document)fail('Rig definition could not be resolved: '+file);assetCache['$'+file]=a;}return assetCache['$'+file];}
        // Carry the owning document through local fragments; overlay oldest base first.
        function definition(reference,depth,seen){
            var scope=doc,file="",scopeId=['scene'],chain=[],merged={},ref,library,found,identity,di,dk;
            while(reference){
                ref=domain.parseURI(reference);if((ref.kind!=="local"&&ref.kind!=="external")||ref.query||ref.nodePath)fail('Unsupported saved rig reference');
                if(ref.kind==='external'){
                    var nextFile=ref.file;
                    if(file&&nextFile.charAt(0)!=='/'){var parts=(file.substring(0,file.lastIndexOf('/')+1)+nextFile).split('/'),out=[];for(var pi=0;pi<parts.length;pi++){if(parts[pi]==='..'){if(!out.length)fail('Rig definition escapes content root');out.pop();}else if(parts[pi]&&parts[pi]!=='.')out.push(parts[pi]);}nextFile=(file.charAt(0)==='/'?'/':'')+out.join('/');}
                    var loaded=asset(nextFile);scope=loaded.document;file=typeof loaded.uri==='string'&&loaded.uri?loaded.uri:nextFile;scopeId=['asset',typeof loaded.path==='string'&&loaded.path?loaded.path:nextFile];
                }
                identity=JSON.stringify([scopeId,ref.fragment]);
                if(own(seen,identity))fail('Cyclic saved rig definition');seen[identity]=true;
                library=scope.node_library;found=null;if(!library)fail('Unsupported saved rig reference');
                for(di=0;di<library.length;di++)if(library[di].id===ref.fragment){if(found)fail('Duplicate rig definition');found=library[di];}
                if(!found)fail('Missing saved rig definition: '+reference);chain.push(found);reference=found.source;
            }
            for(di=chain.length-1;di>=0;di--){found=chain[di];for(dk in found)if(own(found,dk))merged[dk]=found[dk];}
            return merged;
        }
        var targetUri=decoded(owner.url),targetRef=domain.parseURI(owner.url),garmentRef=domain.parseURI(root.url);if(targetRef.kind!=="external"||(!localGarment&&garmentRef.kind!=="external"))fail("Saved target and garment require external figure definitions");
        var targetAsset=asset(targetRef.file),garmentAsset=localGarment?{verified:true,document:{node_library:[]}}:asset(garmentRef.file);if(!targetAsset||targetAsset.verified!==true||!garmentAsset||garmentAsset.verified!==true)fail("Rig definitions could not be resolved");
        var targetDefs={},garmentDefs={},targetRoot=null,garmentRoot=null;
        for(i=0;i<(targetAsset.document.node_library||[]).length;i++){var td=targetAsset.document.node_library[i];targetDefs["$"+td.id]=td;if(td.id===targetRef.fragment)targetRoot=td;}
        for(i=0;i<(garmentAsset.document.node_library||[]).length;i++){var gd=garmentAsset.document.node_library[i];garmentDefs["$"+gd.id]=gd;if(gd.id===garmentRef.fragment)garmentRoot=gd;}
        if(localGarment){
            var localRoot=definition(root.url,0,{});if(localRoot.type!=='figure')fail('Saved local garment is not a figure');garmentRoot=copy(localRoot);garmentRoot.id=id;garmentDefs['$'+id]=garmentRoot;
            var rigQueue=[id],rigSeen={},bindingURLs={},localRig=[];bindingURLs['$'+decoded(root.url)]=true;
            for(var qi=0;qi<rigQueue.length;qi++){var rid=rigQueue[qi];if(rigSeen['$'+rid])fail('Saved rig hierarchy cycle');rigSeen['$'+rid]=true;var kids=children['#'+rid]||[];for(var ki=0;ki<kids.length;ki++){var instance=by['$'+kids[ki]],def=definition(instance.url,0,{});if(def.type!=='bone')fail('Local converted garment descendants must be bones');var bone=copy(def);bone.id=instance.id;bone.name=instance.name||def.name;bone.parent=instance.parent;garmentDefs['$'+bone.id]=bone;bindingURLs['$'+decoded(instance.url)]=true;localRig.push(bone);rigQueue.push(instance.id);}}
            var skins=0,modLibrary=doc.modifier_library||[];
            for(var sm=0;sm<modLibrary.length;sm++){var skin=modLibrary[sm].skin;if(!skin||decoded(skin.node)!==decoded(root.url))continue;skins++;if(!skin.geometry||!skin.joints)fail('Invalid saved skin binding');var sg=domain.parseURI(skin.geometry),geometryDef=null;for(var sgi=0;sgi<(doc.geometry_library||[]).length;sgi++)if(doc.geometry_library[sgi].id===sg.fragment){if(geometryDef)fail('Duplicate saved skin geometry');geometryDef=doc.geometry_library[sgi];}if(sg.kind!=='local'||!geometryDef||!geometryDef.vertices||skin.vertex_count!==geometryDef.vertices.count)fail('Saved skin geometry count differs');var selectedGeometry=root.geometries||[];if(selectedGeometry.length!==1||decoded(selectedGeometry[0].url)!==decoded(skin.geometry))fail('Skin is not bound to selected garment geometry');var jointSeen={};for(var ji=0;ji<skin.joints.length;ji++){var joint=skin.joints[ji],ju=decoded(joint.node);if(!bindingURLs['$'+ju]||jointSeen['$'+ju])fail('Missing or duplicate saved skin joint: '+joint.node);jointSeen['$'+ju]=true;}}
            if(skins!==1)fail('Local converted garment requires one explicit saved skin binding');
        }
        if(!targetRoot||targetRoot.type!=="figure"||!garmentRoot||garmentRoot.type!=="figure")fail("Saved assets do not define two figures");
        var targetBones={};for(k in targetDefs)if(own(targetDefs,k)&&targetDefs[k].type==="bone"){var nameKey="$"+targetDefs[k].name;if(targetBones[nameKey])fail("Ambiguous saved target bone name");targetBones[nameKey]=targetDefs[k];}
        // A wearable may omit intermediate target bones. Compare the nearest shared ancestor,

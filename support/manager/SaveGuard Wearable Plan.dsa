        var garmentNames={};for(k in garmentDefs)if(own(garmentDefs,k)&&garmentDefs[k].type==='bone'){var gn='$'+garmentDefs[k].name;if(garmentNames[gn])fail('Ambiguous garment bone name');garmentNames[gn]=true;}
        var boneCount=0;for(k in garmentDefs)if(own(garmentDefs,k)&&garmentDefs[k].type==='bone'){
            var gb=garmentDefs[k],tb=targetBones['$'+gb.name];if(!tb)fail('Garment bone is absent from saved target rig: '+gb.name);
            var gp=domain.parseURI(gb.parent||'').fragment,tp=domain.parseURI(tb.parent||'').fragment,gparent=garmentDefs['$'+gp],tparent=targetDefs['$'+tp],visited={};
            while(tparent&&tparent.type==='bone'&&!garmentNames['$'+tparent.name]){if(visited['$'+tparent.id])fail('Cyclic saved target bone hierarchy');visited['$'+tparent.id]=true;tp=domain.parseURI(tparent.parent||'').fragment;tparent=targetDefs['$'+tp];}
            if(!gparent||!tparent||gparent.type!==tparent.type||gparent.type==='bone'&&gparent.name!==tparent.name)fail('Garment bone hierarchy differs from saved target: '+gb.name);boneCount++;
        }if(!boneCount)fail('Garment has no compatible skeleton bones');
        var detached=copy(doc);detached.scene=copy(doc.scene);detached.scene.nodes=rows.slice(0);root=clone(root);delete root.parent;delete root.conform_target;detached.scene.nodes[rootIndex]=root;changed["scene.nodes:"+rootIndex]=root;
        var mods=doc.scene.modifiers||[],remaps=0;detached.scene.modifiers=mods.slice(0);
        for(i=0;i<mods.length;i++)if(decoded(mods[i].parent||"")==="#"+id){var smoothing=false;for(j=0;j<(mods[i].extra||[]).length;j++)if(mods[i].extra[j].type==="studio/modifier/smoothing")smoothing=true;if(!smoothing)continue;var m=clone(mods[i]),edited=false;for(j=0;j<(m.extra||[]).length;j++)for(k=0;k<(m.extra[j].channels||[]).length;k++){var channel=m.extra[j].channels[k].channel;if(channel&&channel.id==="Collision Item"){if(channel.type!=="node"||decoded(channel.node||"")!=="#"+owner.id||own(channel,"keys"))fail("Smoothing collision link is outside accepted static scope");delete channel.node;remaps++;edited=true;}}if(edited){detached.scene.modifiers[i]=m;changed["scene.modifiers:"+i]=m;}}
        // Zero or multiple collision links are allowed only when each saved link targets this exact figure.
        for(i=0;i<queue.length;i++){var next=queue[i];if(allowed["$"+next])fail("Cyclic or duplicated wearable descendants");allowed["$"+next]=true;var kids=children["#"+next]||[];for(j=0;j<kids.length;j++)queue.push(kids[j]);}
        var plan=domain.plan(detached,[id],{fullData:true,preserveAnimation:true,resolveAssetDocument:options.resolveAssetDocument});if(!plan.ready)fail("Incomplete wearable dependency closure");
        if(!plan.nodeIds.length)fail("Garment closure is empty");

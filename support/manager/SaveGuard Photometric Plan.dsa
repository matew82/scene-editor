// Native photometric properties and dependencies are preserved by the shared light planner.
var SaveGuardPhotometricFamilyBase=(function(){return {extract:function(doc,id,ns,force,options){return SaveGuardLightPlan.extract(doc,id,ns,force,options);}};}());
var SaveGuardPhotometricFamilyPlan=(function(){
 function extract(doc,id,ns,force,options){var p=SaveGuardPhotometricFamilyBase.extract(doc,id,ns,force,options),s=p.specs[p.selectedIndex];if(p.photometric!==true)throw Error('Photometric mode is required');if(p.specs.length===1&&(s.kind==='point'||s.kind==='spot'))p.profile=s.kind==='spot'?'static-root-spot-rectangle-v1':'static-root-point-rectangle-v1';else p.profile='native-photometric-closure-v2';return p;}
 return {extract:extract};
}());

  if(materialCombo)connect(materialCombo,'activated(int)',function(index){if(busy||mutating||!editor)return;index=Number(index);if(Math.floor(index)!==index||index<0||index>=materialChoices.length)return;var previous=materialKey,oldIndex=-1;for(var mi=0;mi<materialChoices.length;mi++)if(materialChoices[mi].key===previous)oldIndex=mi;try{syncChecks();materialKey=materialChoices[index].key;measureView('Controls','material-selection');}catch(selectionError){materialKey=previous;var priorMutation=mutating;mutating=true;try{materialCombo.currentItem=oldIndex;}finally{mutating=priorMutation;}showView('Controls');controls();error(selectionError);}});
  connect(reportButton,'clicked()',function(){try{showPropertyReport();}catch(e){error(e);}});connect(save,'clicked()',function(){if(!busy)try{doSave(true);}catch(e){error(e);}});connect(close,'clicked()',function(){if(busy)return;try{if(allowLeave()){closingApproved=true;dlg.close();}}catch(e){error(e);}});
  hiddenButton.toolTip='Show hidden properties';if(options.settingsManaged){daz.hide();ownCache.hide();treeButton.hide();controlsButton.hide();plainButton.hide();open.hide();}controls();try{if(options.path){load(options.path);selectHandoff();}if(contentFitted&&typeof env.DzTimer!=='undefined'){initialFitTimer=new env.DzTimer(dlg);initialFitTimer.singleShot=true;connect(initialFitTimer,'timeout()',function(){initialFitTimer.stop();if(!closingApproved&&editor&&fitStats){var beforeFit=Number(dlg.height);try{fitManagedView(fitStats);}catch(fitError){try{env.print('Scene File Workbench content fit failed: '+String(fitError));}catch(ignoreFitErrorLog){}return;}try{env.print('Scene File Workbench content fit: '+JSON.stringify({beforeHeight:beforeFit,height:Number(dlg.height),minHeight:Number(dlg.minHeight),maxHeight:Number(dlg.maxHeight),fit:fitStats.dialogFit}));}catch(ignoreFitLog){}}});initialFitTimer.start(1);}while(true){dlg.exec();if(closingApproved||!pending())break;try{if(allowLeave())break;}catch(exitError){error(exitError);}}}finally{
   // Disconnect callbacks before releasing script data. Do not queue native
   // dialog deletion here: deferred destruction can run in the manager event
   // loop after this function returns. Never pump events inside this teardown.
   closingApproved=true;
   try{if(initialFitTimer)initialFitTimer.stop();}catch(ignoreFitStop){}
   try{if(keyStrip)keyStrip.close();}catch(keyCleanup){try{env.print('Scene File Workbench key cleanup: '+String(keyCleanup));}catch(ignoreKeyLog){}}
   try{if(controlsManager)controlsManager.clear();}catch(controlCleanup){try{env.print('Scene File Workbench controls cleanup: '+String(controlCleanup));}catch(ignoreControlLog){}}
   for(var li=links.length-1;li>=0;li--)try{env.disconnect(links[li].o,links[li].s,links[li].f);}catch(ignoreDisconnect){}
   links=[];rows=[];objectRows=[];treeBy={};treeVisibilityGroups=[];materialChoices=[];
   propertyReport=null;session=null;editor=null;parameterEditor=null;keyEditor=null;headerModel=null;headerProps=null;headerOrder=null;usageOwner=null;usageModel=null;treeOwner=null;io=null;controlsManager=null;keyStrip=null,bonesEditor=null,bonesMode=false,bonesAvailable=false,figureButton=null,bonesButton=null,bonesRow=null;
   try{dlg.close();}catch(dialogCleanup){try{env.print('Scene File Workbench dialog cleanup: '+String(dialogCleanup));}catch(ignoreDialogLog){}}
  }
 }

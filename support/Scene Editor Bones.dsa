/* Aggregate static transforms for the selected figure's own bone hierarchy. */
var SceneEditorBones=(function(){
 var C=SceneEditorCore;function own(o,k){return !!o&&Object.prototype.hasOwnProperty.call(o,k);}function copy(x){return JSON.parse(JSON.stringify(x));}function fail(m){C.fail('BONES',m);}function local(s){if(typeof s!=='string'||s.charAt(0)!=='#')return null;try{return decodeURIComponent(s.substring(1));}catch(e){return null;}}function transform(p){return p&&['translation','rotation','scale','general_scale'].indexOf(p.key[0])>=0;}
 function discover(base){var result={bones:[],notes:[],available:false};if(base.objectType!=='figure')return result;var nodes=base.doc.data.scene&&base.doc.data.scene.nodes||[],by={},children={},i,n,k;for(i=0;i<nodes.length;i++){n=nodes[i];k='$'+n.id;if(own(by,k))fail('Duplicate node identity prevents safe bone ownership: '+n.id);by[k]={node:n,index:i};var parent=local(n.parent);if(parent)(children['$'+parent]||(children['$'+parent]=[])).push(by[k]);}var seen={},queue=[],root=base.camera.id;function push(parent,path){var rows=children['$'+parent]||[];for(var j=rows.length-1;j>=0;j--)queue.push({row:rows[j],path:path,parent:parent});}push(root,[]);while(queue.length){base.guard('Discover figure bones');var item=queue.pop(),record=item.row.node;if(record.id===root)fail('Figure is parented inside its own bone hierarchy.');if(seen['$'+record.id])fail('Cyclic bone ownership.');seen['$'+record.id]=true;var chain=base.resolver.chain(record.url,base.doc),type='',name='',inheritedLabel='';for(var ci=0;ci<chain.length;ci++){var definition=chain[ci].node;if(definition.type)type=definition.type;if(definition.name)name=definition.name;if(definition.label)inheritedLabel=definition.label;}type=record.type||type;name=record.name||name||record.id;if(!type)fail('A descendant node type cannot be resolved.');if(type!=='bone')continue;var label=String(record.label||inheritedLabel||name||record.id),path=item.path.concat([label]);result.bones.push({id:record.id,index:item.row.index,parentId:item.parent,label:label,name:String(name),path:path,depth:path.length-1});push(record.id,path);}result.available=result.bones.length>0;return result;}
 function create(base,options){options=options||{};var catalog=discover(base),original=base.doc,guard=base.guard||function(){},editors={},bindings={},props={},order=[],pending={},staged=[],lastSaved=null,groups={translation:'Translation',rotation:'Rotation',scale:'Scale',general_scale:'Scale'},api;
  function proxy(doc,stage,cache){var io={},k;for(k in base.io)if(own(base.io,k))io[k]=base.io[k];io.readDocument=function(path,g,targeted){var cached=path===doc.path?doc:cache&&cache[path]||base.resolver.cache[path];if(cached){var isScene=path===doc.path;return{identity:cached.raw,text:isScene?stage.text:cached.text,data:isScene?stage.data:cached.data,gzip:cached.gzip,projection:cached.projection,formulaEvidence:cached.formulaEvidence,timings:{bonesDocumentReuse:true}};}return base.io.readDocument(path,g,targeted);};return io;}
  for(var i=0;i<catalog.bones.length;i++){guard('Read bone transforms');var bone=catalog.bones[i],e=new C.Editor(original.path,proxy(original,{text:original.text,data:original.data}),guard,bone.index);if(e.objectType!=='bone')fail('Bone definition no longer resolves as a bone: '+bone.id);editors['$'+bone.id]=e;for(var j=0;j<e.order.length;j++){var source=e.props[e.order[j]];if(!transform(source))continue;var id=JSON.stringify(['bone',bone.id,source.id]),p={},k;for(k in source)if(own(source,k))p[k]=source[k];p.id=id;p.groups=['Bones'].concat(bone.path).concat([groups[source.key[0]]]);p.searchText=bone.path.join(' ')+' '+bone.id+' '+p.label+' '+groups[source.key[0]];p.bone={id:bone.id,name:bone.name,label:bone.label,path:bone.path.slice(0),propertyId:source.id};props[id]=p;order.push(id);bindings[id]={editor:e,source:source,bone:bone};}}
  function hasPending(){return Object.keys(base.pending||{}).length>0||Object.keys(pending).length>0;}
  function discardPending(){base.pending={};base.pendingClamped={};base._builtPlan=null;for(var id in editors)if(own(editors,id)){editors[id].pending={};editors[id].pendingClamped={};editors[id]._builtPlan=null;}pending={};api.pending=pending;staged=[];api._builtPlan=null;}
  function set(id,value,policy){var b=bindings[id];if(!b)fail('Unknown bone transform.');if(b.source.issue||b.source.bindingWarning)fail(b.source.issue||b.source.bindingWarning);b.editor.set(b.source.id,value,policy);if(own(b.editor.pending,b.source.id))pending[id]=copy(b.editor.pending[b.source.id]);else delete pending[id];}
  function dependencies(e){var affected={},k,p,keys=[];for(k in e.pending)if(own(e.pending,k)){p=e.props[k];e.dependencyTargets(p,affected);}for(k in affected)if(own(affected,k))keys.push(k);for(var n=0;n<keys.length;n++)affected[keys[n]+'/value']=true;if(keys.length){var oldMorph=e.morphState,oldCache=e.resolver.cache,combined={};for(k in base.resolver.cache)if(own(base.resolver.cache,k))combined[k]=base.resolver.cache[k];for(k in oldCache)if(own(oldCache,k))combined[k]=oldCache[k];e.resolver.cache=combined;e.morphState=base.morphState;try{e.scanDependencies(affected);}finally{e.resolver.cache=oldCache;if(oldMorph===undefined)delete e.morphState;else e.morphState=oldMorph;}}}
  function verify(){var seen={},lists=[base.resolver],id,i,k,doc,resolver,binding,b;for(id in editors)if(own(editors,id))lists.push(editors[id].resolver);for(i=0;i<staged.length;i++)lists.push(staged[i].resolver);original.verify();seen['$'+original.path]=true;for(i=0;i<lists.length;i++){resolver=lists[i];if(!resolver)continue;for(binding in resolver.bindingChecks)if(own(resolver.bindingChecks,binding)){b=resolver.bindingChecks[binding];if(resolver.io.resolve(b.file,b.scope)!==b.path)C.fail('SOURCE_CHANGED','Asset URI precedence changed: '+b.file);}for(k in resolver.cache)if(own(resolver.cache,k)){doc=resolver.cache[k];if(!doc||!doc.path||seen['$'+doc.path])continue;seen['$'+doc.path]=true;doc.verify();}}if(base.verifyMorphSources)base.verifyMorphSources();}
  function planSignature(){var rows=[],i,bone,e;for(i=0;i<catalog.bones.length;i++){bone=catalog.bones[i];e=editors['$'+bone.id];if(Object.keys(e.pending).length||Object.keys(e.pendingClamped||{}).length)rows.push([bone.id,e.pending,e.pendingClamped||{}]);}return JSON.stringify([base.pending||{},base.pendingClamped||{},rows]);}
  function build(){if(options.keyEditor&&options.keyEditor.hasPending&&options.keyEditor.hasPending())fail('Save or discard animation key edits before saving static bone transforms.');var signature=planSignature();if(api._builtPlan&&api._builtPlan.pendingSignature===signature&&api._builtPlan.sourceText===original.text)return api._builtPlan;guard('Build figure and bone changes');var rootPlan=base.build(),stage={text:rootPlan.text,data:rootPlan.expected},diff=rootPlan.diff.slice(0),ops=(rootPlan.operations||[]).slice(0);staged=[];for(var i=0;i<catalog.bones.length;i++){var bone=catalog.bones[i],old=editors['$'+bone.id];if(!Object.keys(old.pending).length)continue;guard('Build bone '+bone.label);dependencies(old);var next=new C.Editor(original.path,proxy(original,stage,old.resolver.cache),guard,bone.index);next.pending=copy(old.pending);next.pendingClamped=copy(old.pendingClamped||{});dependencies(next);var plan=next.build();stage={text:plan.text,data:plan.expected};diff=diff.concat(plan.diff);ops=ops.concat(plan.operations||[]);staged.push(next);}var built={text:stage.text,expected:stage.data,diff:diff,operations:ops,buildMs:0,sourceText:original.text,pendingSignature:signature};api._builtPlan=built;return built;}
  function save(){var plan=build();if(!plan.diff.length)fail('No changes to save.');var result=base.io.install(original,plan.text,guard,verify);lastSaved={plan:plan,result:result};base.lastSaved=lastSaved;api.lastSaved=lastSaved;return{timings:{buildMs:plan.buildMs,install:result.timings||{}},preSha256:original.hash,postSha256:result.hash,sourceProtection:result.sourceProtection||'Exact original binary bytes',semanticDiff:plan.diff,file:original.path,assetWrites:false,nativeAcceptance:'Pending user test'};}
  api={isBonesEditor:true,base:base,bones:catalog.bones,notes:catalog.notes,doc:original,io:base.io,resolver:base.resolver,guard:guard,camera:base.camera,index:base.index,requestedIndex:base.requestedIndex,objectType:base.objectType,propertySource:base.propertySource,sourceDiagnostics:base.sourceDiagnostics||[],definitionRevision:base.definitionRevision||0,chain:base.chain,metadata:base.metadata||[],props:props,order:order,pending:pending,set:set,hasPending:hasPending,discardPending:discardPending,build:build,save:save,reopenSaved:function(){if(!lastSaved)return null;base.lastSaved=lastSaved;return base.reopenSaved();},verify:verify};return api;

  function pathKey(path){return String(path).replace(/\\/g,'/');}
  function listMorphFiles(geometryURL,scope,cached){if(cached){var warm=warmMorphFiles(geometryURL,scope,cached);if(warm)return warm;}need(env.DzDir&&typeof content.getNumContentDirectories==='function'&&typeof content.getContentDirectoryPath==='function','Content directory enumeration API unavailable');var file=decodeURIComponent(geometryURL.split('#')[0]);need(file.charAt(0)==='/'&&!/^\/[A-Za-z]:/.test(file),'Geometry URI is not content-relative; cannot infer its installed morph scope: '+geometryURL);var relative=file.substring(0,file.lastIndexOf('/')+1)+'Morphs',files=[],seen={},roots=[],scopes=[],directories=[],count=Number(content.getNumContentDirectories()),i;need(isFinite(count)&&count>=0&&Math.floor(count)===count,'Invalid content root count');
   for(i=0;i<count;i++){safeGuard();var root=pathKey(content.getContentDirectoryPath(i)).replace(/\/$/,''),folder=root+relative,info=new env.DzFileInfo(folder);roots.push(root);scopes.push({physical:folder,exists:info.exists(),canonical:info.exists()?pathKey(info.canonicalFilePath()):null});if(!info.exists())continue;need(info.isDir()&&info.isReadable(),'Morph directory unreadable '+folder);var queue=[{physical:folder,logical:relative}],visited={};while(queue.length){safeGuard();var current=queue.pop(),canonical=pathKey(new env.DzFileInfo(current.physical).canonicalFilePath());need(canonical,'Morph directory canonical identity unavailable');if(visited[canonical])continue;visited[canonical]=true;var names=new env.DzDir(current.physical).entryList('*',env.DzDir.Files|env.DzDir.Dirs|env.DzDir.NoDotAndDotDot,env.DzDir.Name);need(names&&typeof names.length==='number','Directory listing unavailable '+current.physical);var stamp={path:canonical,physical:current.physical,names:[]},j;for(j=0;j<names.length;j++){var name=String(names[j]);if(name==='.'||name==='..')continue;var physical=current.physical+'/'+name,logical=current.logical+'/'+name,child=new env.DzFileInfo(physical);if(child.isDir()){stamp.names.push('D:'+name);queue.push({physical:physical,logical:logical});}else if(child.isFile()&&/\.dsf$/i.test(name)){stamp.names.push('F:'+name);var chosen=String(content.findFile(logical));if(!chosen)failPath(logical);var winner=pathKey(new env.DzFileInfo(chosen).canonicalFilePath()),actual=pathKey(child.canonicalFilePath());if(winner!==actual)continue;var uri=logical.split('/').map(function(part){return encodeURIComponent(part).replace(/[!'()*]/g,function(c){return'%'+c.charCodeAt(0).toString(16).toUpperCase();});}).join('/');if(!seen[uri]){seen[uri]=true;files.push({uri:uri,path:actual,physical:physical,identity:meta(actual)});}}}stamp.names.sort();directories.push(stamp);}}
   files.sort(function(a,b){return a.uri<b.uri?-1:a.uri>b.uri?1:0;});directories.sort(function(a,b){return a.path<b.path?-1:a.path>b.path?1:0;});return{geometryURL:geometryURL,scope:scope,roots:roots,scopes:scopes,directories:directories,files:files};
  }

  function warmMorphFiles(geometryURL,scope,cached){if(!cached.scopes||!cached.directories||!cached.files)return null;var count=Number(content.getNumContentDirectories()),roots=[],i,j,info,names,entries,child,files=[];need(isFinite(count)&&count>=0&&Math.floor(count)===count,'Invalid content root count');for(i=0;i<count;i++)roots.push(pathKey(content.getContentDirectoryPath(i)).replace(/\/$/,''));if(!SceneEditorCore.equal(roots,cached.roots))return null;

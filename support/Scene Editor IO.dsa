   }catch(e){if(moved)try{if(published){need(SceneEditorCore.equal(signature(doc.path).chunks,stageIdentity.chunks),'Published target changed externally');remove(doc.path);}need(new env.DzFile(hold).rename(doc.path),'Cannot restore original');need(SceneEditorCore.equal(signature(doc.path).chunks,doc.raw.chunks),'Restored bytes differ');moved=false;}catch(r){recovery=String(r.message||r);}if(recovery)throw Error('RECOVERY REQUIRED: '+recovery+'; original '+hold+'; target '+doc.path);throw e;}finally{critical=false;try{remove(plain);}catch(ignorePlain){}try{remove(stage);}catch(ignoreStage){}}

   for(i=0;i<cached.directories.length;i++){safeGuard();var dir=cached.directories[i];if(!dir.physical)return null;info=new env.DzFileInfo(dir.physical);if(!info.exists()||!info.isDir()||pathKey(info.canonicalFilePath())!==dir.path)return null;need(info.isReadable(),'Morph directory unreadable '+dir.physical);names=new env.DzDir(dir.physical).entryList('*',env.DzDir.Files|env.DzDir.Dirs|env.DzDir.NoDotAndDotDot,env.DzDir.Name);entries=[];for(j=0;j<names.length;j++){var name=String(names[j]);if(name==='.'||name==='..')continue;child=new env.DzFileInfo(dir.physical+'/'+name);if(child.isDir())entries.push('D:'+name);else if(child.isFile()&&/\.dsf$/i.test(name))entries.push('F:'+name);}entries.sort();if(!SceneEditorCore.equal(entries,dir.names))return null;}

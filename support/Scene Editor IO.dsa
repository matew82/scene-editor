  function readDocument(path,workGuard,targeted){var before=meta(path),definitionIndex=null;if(targeted&&indexPath){workGuard('Load cached node definition');definitionIndex=getDefinitionIndex();var cachedNode=(definitionIndex.nodeDocs||{})[path];if(cachedNode&&cachedNode.data&&Object.prototype.toString.call(cachedNode.data.node_library)==='[object Array]'&&SceneEditorCore.equal(cachedNode.identity,before))return{text:null,data:cachedNode.data,identity:{meta:before},gzip:cachedNode.gzip,projection:JSON.stringify(cachedNode.data)};}var started=new Date().getTime(),identity=targeted?{meta:before}:signature(path),signatureMs=new Date().getTime()-started,readStarted=new Date().getTime(),read=nativeText(path,workGuard),readMs=new Date().getTime()-readStarted,data,formulaEvidence=[],parseStarted=new Date().getTime();workGuard(targeted?'Extract asset definitions: '+path:'Native JSON parse: '+path);data=targeted?SceneEditorCore.projectAsset(read.text,workGuard):SceneEditorCore.parseDocument(read.text,workGuard,formulaEvidence);var parseMs=new Date().getTime()-parseStarted;need(SceneEditorCore.equal(before,meta(path)),'Source changed while parsing');if(!targeted)need(SceneEditorCore.equal(signature(path),identity),'Source bytes changed while opening');if(targeted&&definitionIndex){if(!definitionIndex.nodeDocs)definitionIndex.nodeDocs={};definitionIndex.nodeDocs[path]={identity:before,data:data,gzip:read.gzip};nodeIndexDirty=true;}return{text:targeted?null:read.text,data:data,identity:identity,gzip:read.gzip,projection:targeted?JSON.stringify(data):null,formulaEvidence:targeted?data.formula_evidence:formulaEvidence,timings:{signatureMs:signatureMs,nativeReadMs:readMs,parseAndStructureMs:parseMs,totalMs:new Date().getTime()-started}};}

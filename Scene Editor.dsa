  var fps=timeline.current_frames_per_second,sceneFirst=timeline.animation_range[0]*fps,sceneLast=timeline.animation_range[1]*fps;if(!finite(sceneFirst)||!finite(sceneLast))fail('The saved frame range cannot be represented.');

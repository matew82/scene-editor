  function metadataLine(name,value){return "<font color='#e7cf88'><b>"+esc(name)+":</b></font> <font color='#ffffff'>"+esc(value)+"</font><br/><br/>";}
  function backupDate(epoch){var d=new Date(Number(epoch));if(!isFinite(d.getTime()))return '';function two(n){return n<10?'0'+n:String(n);}return ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d.getDay()]+' '+['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()]+' '+two(d.getDate())+' '+two(d.getHours())+':'+two(d.getMinutes())+':'+two(d.getSeconds())+' '+d.getFullYear();}
  function sceneTitle(path){return '<h2><font color="#9DD8FF">'+esc(String(new env.DzFileInfo(path).fileName()).replace(/\.duf$/i,''))+'</font></h2>';}
  function modifiedDate(value){var date=value&&typeof value.getTime==='function'?new Date(Number(value.getTime())):null;if(!date||!isFinite(date.getTime()))return 'Not recorded';function two(n){return n<10?'0'+n:String(n);}return date.getFullYear()+'-'+two(date.getMonth()+1)+'-'+two(date.getDate())+' '+two(date.getHours())+':'+two(date.getMinutes())+':'+two(date.getSeconds());}

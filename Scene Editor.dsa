  function readBackups(force){if(busy||externalBusy||!selected||!detected.available)return;if(!force&&backupRows&&backupSource===selected)return;var source=selected,serial=sourceSerial;try{var result=run('Read current scene backups',function(g){var listed=integration.list(source,g);if(!listed||listed.complete===false){if(listed&&listed.cancelled)throw cancelError();throw Error('Backup listing is incomplete; previous view was retained');}if(source!==selected||serial!==sourceSerial)throw cancelError();renderBackups(listed,g);return listed;});if(source!==selected||serial!==sourceSerial)return;backupRows=result;backupSource=source;}catch(e){if(e.code!=='CANCELLED')warn(e);backupStatus.text=String(e.message||e);}}
  connect(choose,'clicked()',function(){if(busy||externalBusy)return;var path=env.FileDialog.doDirectoryDialog('Scene Editor - Choose folder','',folder,dlg);if(path)browse(String(path),filters);});connect(refresh,'clicked()',function(){if(busy||externalBusy)return;if(folder){bridge.invalidate();browse(folder,filters);if(selected)selectScene(selected);}});if(typeof env.DzPopupMenu==='function')connect(recent,'clicked()',function(){if(mutating||busy||externalBusy)return;var values=(model.getState().recentFolders||[]).slice(0),menu=new env.DzPopupMenu(recent);for(var ri=0;ri<values.length;ri++){var classification=typeof host.classifyContentPath==='function'?host.classifyContentPath(values[ri]):null,icon=classification&&classification.insideGallery===true?'folderGallery':'folderOutside';menu.insertItem(new env.Pixmap(root+'/icons/'+SceneEditorManagerWidgets.semanticButtonIcon(icon)+'.png'),values[ri],ri);}var picked=menu.exec();if(picked>=0&&picked<values.length&&!closing&&!busy&&!externalBusy)browse(values[picked],filters);});else connect(recent,'activated(int)',function(index){if(mutating||busy||externalBusy)return;var values=model.getState().recentFolders||[];if(index>0&&values[index-1])browse(values[index-1],filters);});
  connect(search,'editingFinished()',function(){if(mutating||busy||externalBusy||!folder)return;var next=JSON.parse(JSON.stringify(filters));next.name=String(search.text);browse(folder,next);});connect(importantOnly,'clicked()',function(){if(busy||externalBusy)return;var next=JSON.parse(JSON.stringify(filters));next.importantOnly=importantOnly.checked===true;if(folder)browse(folder,next);else{filters=next;updateEnabled();}});connect(sort,'activated(int)',function(index){if(mutating||busy||externalBusy)return;var next=JSON.parse(JSON.stringify(filters));next.sort=index<2?'name':index<4?'date':'size';next.descending=index%2===1;if(folder)browse(folder,next);else filters=next;});connect(advanced,'clicked()',function(){if(busy||externalBusy)return;var next=SceneEditorAdvancedFilters.show(env,filters,{projectRoot:root});if(next){if(folder)browse(folder,next);else filters=next;}});connect(clear,'clicked()',function(){if(busy||externalBusy)return;var next=SceneEditorBrowserModel.clearFilters(filters);if(folder)browse(folder,next);else{filters=next;search.text='';updateEnabled();}});
  connect(compareToggle,'clicked()',function(){if(busy||externalBusy||!selected)return;try{comparisonBasket.toggle(selected);updateEnabled();}catch(e){warn(e);}});connect(compareButton,'clicked()',function(){if(busy||externalBusy||comparisonBasket.list().length!==2)return;busy=true;updateEnabled();try{var comparisonResult=SceneEditorCompare.show(env,host,comparisonBasket.list(),model.settings(),{onError:recordError});if(comparisonResult&&comparisonResult.removePath&&comparisonBasket.contains(comparisonResult.removePath))comparisonBasket.toggle(comparisonResult.removePath);}catch(e){warn(e,{stage:e&&e.stage||'compare-dialog-construction',action:'compareScenes',context:'Two saved scene caches; read-only comparison'});}finally{busy=false;updateEnabled();}});
  connect(important,'clicked()',function(){if(mutating||busy||externalBusy||!selected)return;try{var m=selectedMeta();model.setMetadata(selected,{important:important.checked===true,note:m.note||''});updateInfo();if(filters.importantOnly&&folder)browse(folder,filters);}catch(e){warn(e);updateInfo();}});connect(note,'clicked()',function(){if(!busy&&!externalBusy)try{editNote();}catch(e){warn(e);}});connect(backup,'clicked()',function(){if(busy||externalBusy||!selected||!detected.backupAvailable)return;var source=selected;try{var result=run('Backup selected scene',function(g){return integration.backup(source,{explicitUserAction:true,guard:g});});if(!result||result.ok!==true){if(result&&result.cancelled){status.text='Backup cancelled; no successful backup reported.';return;}throw Error(result&&(result.message||result.error&&result.error.message)||'Backup was not completed');}status.text='Manual disk backup created. The source DUF was not changed.';clearBackupView();readBackups(true);}catch(e){warn(e);}});connect(tabs,'currentChanged(int)',function(index){transitionTrace('outer-tab-enter',String(index));try{if(pane&&typeof pane.activationChanged==='function')pane.activationChanged();if(index===2)readBackups(true);}finally{transitionTrace('outer-tab-exit',String(index));}});
  function fullScene(kind){if(busy||externalBusy||!selected)return;try{if(env.progressIsActive&&env.progressIsActive())throw Error('Another DAZ progress operation is active');var source=selected,result;busy=true;updateEnabled();try{result=kind==='load'?sceneActions.load(source):sceneActions.merge(source);}finally{busy=false;updateEnabled();}if(result&&result.error)warn(result.error.message||result.error);else if(result&&result.historyWarning)warn(result.historyWarning);else if(result&&result.message)status.text=result.message;}catch(e){warn(e);}}connect(load,'clicked()',function(){fullScene('load');});connect(merge,'clicked()',function(){fullScene('merge');});
  connect(settings,'clicked()',function(){if(busy||externalBusy)return;try{var result=SceneEditorManagerSettings.show(env,model,host,folder,{run:run,guard:guard,onCacheCleared:function(){bridge.invalidate();pane.invalidate();inspection=null;clearBackupView();updateInfo();status.text='Owned caches cleared. Select a scene to inspect again.';},defaultFigureNames:SaveGuardSettings.characterNames});if(result.saved){prefs=model.settings();bridge.invalidate();if(selected)selectScene(selected);}}catch(e){warn(e);}});connect(close,'clicked()',function(){if(!busy&&!externalBusy){closing=true;dlg.close();}});
  refreshRecent();updateEnabled();try{if(typeof env.print==='function')env.print('Scene Editor startup: '+JSON.stringify({stage:'manager-ready-before-browse',milliseconds:new Date().getTime()-managerStarted}));}catch(ignoreStartupTiming){}try{var initial='';try{if(prefs.lastFolder&&host.exists(prefs.lastFolder)&&host.isDir(prefs.lastFolder))initial=prefs.lastFolder;else if(host.defaultBrowserFolder)initial=host.defaultBrowserFolder();else throw Error('No configured DAZ folder is available. Use Choose folder.');if(initial){browse(initial,filters);if(prefs.lastScene&&host.exists(prefs.lastScene)&&host.key(host.parent(prefs.lastScene))===host.key(folder))selectScene(prefs.lastScene);}}catch(initialError){pathLabel.text=esc(String(initialError.message||initialError));status.text='Choose a folder to browse working scenes.';}try{if(typeof env.print==='function')env.print('Scene Editor startup: '+JSON.stringify({stage:'initial-inspection-ready',milliseconds:new Date().getTime()-managerStarted}));}catch(ignoreReadyTiming){}dlg.exec();}finally{closing=true;sceneActions.close();refreshTimer.stop();backupReturnTimer.stop();previewTimer.stop();disconnect(previewLinks);disconnect(links);disconnect(backupLinks);if(browserView)disconnect(browserView.links);pane.close();bridge.close();thumbs.clear();if(folder){var remembered=model.settings();remembered.lastFolder=folder;remembered.lastScene=selected;var folderState=SceneEditorManagerWidgets.splitterState(folderSplit);if(folderState)remembered.folderSplitterState=folderState;try{model.setSettings(remembered);}catch(e){warn(e);}}}return{folder:folder,scene:selected};

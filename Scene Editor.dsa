  function updateInfo(){for(var mf=0;mf<metadataFields.length;mf++){metadataFields[mf].row.visible=false;metadataFields[mf].available=false;}if(!selected){infoText.text='Select a scene to inspect its saved data.';important.checked=false;noteText.text='';return;}if(!inspection){var kept=selectedMeta();infoText.text=sceneTitle(selected)+esc(selected)+'<br/>Inspection must be refreshed; scene annotations remain available.';mutating=true;try{important.checked=kept.important===true;}finally{mutating=false;}noteText.text=esc(kept.note||'');note.toolTip=kept.note||'Edit the scene note (stored outside the DUF)';for(var ci=0;ci<sceneCards.length;ci++){if(host.key(sceneCards[ci].row.path)===host.key(selected))sceneCards[ci].row.important=kept.important===true;cardStyle(sceneCards[ci]);}return;}var fileInfo=new env.DzFileInfo(selected),rows=SaveGuardManagerModel.sceneInformation(inspection.version,inspection.view,model.settings().recognizedCharacterNames||SaveGuardSettings.characterNames),html=sceneTitle(selected)+'<p>'+esc(selected)+'</p>';rows=sceneMetadataRows(rows);html+=metadataLine('Modified',modifiedDate(fileInfo.lastModified()))+metadataLine('Size',(Number(fileInfo.size())/1000000).toFixed(2)+' MB');for(var i=0;i<rows.length;i++){var displayed=false;for(var mf=0;mf<metadataFields.length;mf++)if(metadataFields[mf].name.toLowerCase()===String(rows[i].label).toLowerCase()){var field=metadataFields[mf];field.label.text="<font color='#e7cf88'><b>"+esc(field.name)+":</b></font> <font color='#ffffff'>"+esc(rows[i].value)+"</font>";field.label.toolTip=field.name+': '+String(rows[i].value);field.row.visible=true;field.available=field.kind==='view'||String(rows[i].value)!=='Not recorded';if(field.button)field.button.toolTip=field.available?'Edit '+field.name:'This value is not recorded in the saved scene';displayed=true;break;}if(!displayed)html+=metadataLine(rows[i].label,rows[i].value);}var m=selectedMeta();infoText.text=html;mutating=true;try{important.checked=m.important===t
/* Installed SaveGuard 2 catalog and explicit manual disk-backup adapter. Never saves/loads/renders the live scene. */
var SceneEditorBackupIntegration=(function(){
 function own(o,k){return Object.prototype.hasOwnProperty.call(o,k);}function array(v){return Object.prototype.toString.call(v)==='[object Array]';}function text(v){return v===undefined||v===null?'':String(v);}function fail(code,message){var e=Error(message);e.code=code;throw e;}
 function normal(value){var p=text(value).replace(/\\/g,'/'),prefix='',parts,out=[],i;if(!p||/[\x00-\x1f\x7f]/.test(p))fail('BACKUP_PATH','Invalid absolute path');if(/^[A-Za-z]:\//.test(p)){prefix=p.substring(0,3);p=p.substring(3);}else if(p.substring(0,2)==='//'){parts=p.substring(2).split('/');if(parts.length<2||!parts[0]||!parts[1])fail('BACKUP_PATH','Invalid UNC path');prefix='//'+parts.shift()+'/'+parts.shift()+'/';p=parts.join('/');}else if(p.charAt(0)==='/'){prefix='/';p=p.substring(1);}else fail('BACKUP_PATH','An absolute filesystem path is required');parts=p.split('/');for(i=0;i<parts.length;i++){if(!parts[i]||parts[i]==='.')continue;if(parts[i]==='..'){if(!out.length)fail('BACKUP_PATH','Path escapes its filesystem root');out.pop();}else out.push(parts[i]);}return prefix+out.join('/');}
 function key(value){var p=normal(value);if(p.length>1&&p.charAt(p.length-1)==='/'&&!/^[A-Za-z]:\/$/.test(p))p=p.substring(0,p.length-1);return /^(?:[A-Za-z]:\/|\/\/)/.test(p)?p.toLowerCase():p;}
 function parent(value){var p=normal(value).replace(/\/$/,'');var at=p.lastIndexOf('/');if(at===0)return '/';if(at===2&&/^[A-Za-z]:/.test(p))return p.substring(0,3);return p.substring(0,at);}
 function leaf(path){return normal(path).split('/').pop();}
 function sameContent(a,b){if(!a||!b||a.bytes!==b.bytes||!array(a.chunks)||!array(b.chunks)||a.chunks.length!==b.chunks.length)return false;for(var i=0;i<a.chunks.length;i++)if(a.chunks[i]!==b.chunks[i])return false;return true;}
 function sameSnapshot(a,b){return sameContent(a,b)&&key(a.path)===key(b.path)&&a.modified===b.modified;}
 function sameJSON(a,b){return JSON.stringify(a)===JSON.stringify(b);}

  function clearPreview(){if(previewTimer)previewTimer.stop();previewPending='';disconnect(previewLinks);previewArea.visible=false;previewArea.setWidget(new env.DzWidget(previewArea));}
  function requestPreview(){clearPreview();if(!closing&&selected&&inspection&&detected.available&&typeof integration.latestScreenshots==='function'){previewPending=selected;previewTimer.start(1);}}
  function renderPreview(result,g){clearPreview();if(!result||!result.record)return;var source=selected,serial=sourceSerial,content=plainPanel(previewArea,true),local=[],published=false,seen={},count=0;try{var shots=result.record.screenshots||[];for(var i=0;i<shots.length;i++){g('Display backup screenshots');var shot=shots[i],key=shot&&shot.path?host.key(shot.path):'';if(!key||seen[key]||!screenshotImage(shot.path))continue;seen[key]=true;(function(shot){var b=button(content.widget,'');b.setFixedSize(150,150);b.sizedFromIcon=true;SceneEditorManagerWidgets.imageButtonPixmap(b,thumbs.get(shot.path,136,false,false,false).pixmap,136,136);b.toolTip='Backup screenshot'+(result.record.savedAt?' — '+backupDate(result.record.savedAt):'')+'\n'+result.verification;content.layout.addWidget(b);connect(b,'clicked()',function(){if(!busy&&!externalBusy&&selected&&serial===sourceSerial&&host.key(selected)===host.key(source)){var f=new env.DzFileInfo(source);if(Number(f.size())!==result.sourceStamp.bytes||Number(f.lastModified().getTime())!==result.sourceStamp.modified){clearPreview();return;}openScreenshot(shot.path);}},local);})(shot);count++;}if(!count)return;content.layout.addStretch(1);g('Publish scene screenshots');var currentFile=new env.DzFileInfo(source);if(Number(currentFile.size())!==result.sourceStamp.bytes||Number(currentFile.lastModified().getTime())!==result.sourceStamp.modified)throw cancelError();if(closing||serial!==sourceSerial||!selected||host.key(source)!==host.key(selected))throw cancelError();previewArea.setWidget(content.widget);previewLinks=local;previewArea.visible=true;published=true;}finally{if(!published){disconnect(local);trash.setWidget(content.widget);trash.setWidget(new env.DzWidget(trash));}}}
  function clearBackupView(){clearPreview();disconnect(backupLinks);backupRows=null;backupSource='';backupArea.setWidget(new env.DzWidget(backupArea));}function renderBackups(result,workGuard){var local=[],content=plainPanel(backupArea,false),published=false,source=selected;try{for(var i=0;i<result.records.length;i++){workGuard('Display backups '+i+' / '+result.records.length);var record=result.records[i],box=plainPanel(content.widget,false),heading=plainPanel(box.widget,true),thumbPath=record.thumbnailPath||'';if(screenshotImage(thumbPath)){var thumbnail=label(heading.widget,'');thumbnail.pixmap=thumbs.get(thumbPath,91,false,false,false).pixmap;thumbnail.setFixedSize(91,91);heading.layout.addWidget(thumbnail);}heading.layout.addWidget(label(heading.widget,"<font color='#e7cf88'><b>"+esc(record.name||String(record.id))+"</b></font><br/><font color='#ffffff'>"+esc(record.savedAt?backupDate(record.savedAt):record.status||'')+"</font>"),1);box.layout.addWidget(heading.widget);var shots=record.screenshots||[],shotRow=null,seenShots={};for(var j=0;j<shots.length;j++){var shot=shots[j],shotKey=shot&&shot.path?host.key(shot.path):'';if(!shotKey||seenShots[shotKey]||!screenshotImage(shot.path))continue;seenShots[shotKey]=true;if(!shotRow){shotRow=plainPanel(box.widget,false);box.layout.addWidget(shotRow.widget);}(function(shot){var b=button(shotRow.widget,'');b.setFixedSize(150,150);b.sizedFromIcon=true;SceneEditorManagerWidgets.imageButtonPixmap(b,thumbs.get(shot.path,136,false,false,false).pixmap,136,136);b.toolTip=shot.path;shotRow.layout.addWidget(b);connect(b,'clicked()',function(){if(!busy&&!externalBusy&&selected&&host.key(selected)===host.key(source))openScreenshot(shot.path);},local);})(shot);}if(shotRow)shotRow.layout.addStretch(1);content.layout.addWidget(box.widget);}content.layout.addStretch(1);workGuard('Publish current scene backups');disconnect(backupLinks);backupArea.setWidget(content.widget);backupLinks=local;published=true;backupStatus.text=result.records
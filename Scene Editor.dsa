     pixmap.fromImage(sourceImage.smoothScale(w,h));image.pixmap=pixmap;image.setGeometry(Math.floor((width-w)/2),Math.floor((height-h)/2),w,h);lastSize=size;
    }finally{fitting=false;}
   }
   fitTimer.singleShot=true;connect(fitTimer,'timeout()',function(){if(!viewerLive||closing)return;try{fitImage();}catch(fitError){fitFailure=fitError;viewerLive=false;fitTimer.stop();popup.close();return;}if(viewerLive&&!closing)fitTimer.start(100);},popupLinks);
   connect(closeShot,'clicked()',function(){viewerLive=false;fitTimer.stop();popup.close();},popupLinks);
   try{transitionTrace('screenshot-exec',path);fitTimer.start(0);popup.exec();transitionTrace('screenshot-return',path);}
   finally{viewerLive=false;fitTimer.stop();disconnect(popupLinks);sourceImage=null;transitionTrace('screenshot-disconnected',path);if(!closing&&backupReturnTimer)backupReturnTimer.start(1);}

 function nativeBackupPort(){
  function info(path){var f=new DzFileInfo(path);return{exists:f.exists(),file:f.isFile(),directory:f.isDir(),symLink:f.isSymLink()||!!String(f.symLinkTarget()||''),canonical:f.exists()?normal(f.canonicalFilePath()):'',bytes:Number(f.size()),modified:f.exists()?Number(f.lastModified().getTime()):null};}
  function occupied(path){var s=info(path);return s.exists||s.symLink;}function directDir(path){var s=info(path);if(!s.exists||!s.directory||s.symLink||key(s.canonical)!==key(path))fail('BACKUP_ROOT_CHANGED','Backup directory changed or is redirected: '+path);}

   for(n=0;n<editor.order.length;n++){p=editor.props[editor.order[n]];if(owner.kind==='modifier'){var existing=p.morph&&p.morph.existingIndex,stored=p.key[0]==='storedModifier'?p.key[1]:null;if(existing!==owner.index&&stored!==owner.index)continue;add('?value',{p:p,editor:editor});add('?value/value',{p:p,editor:editor});continue;}if(p.morph||p.key[0]==='storedModifier')continue;var layer=p.layers&&p.layers[p.layers.length-1],path=layer&&layer.path||[],at=path.indexOf('geometries');if(owner.kind==='geometry'){if(at<0)continue;var geometryIndex=path[at+1];if(geometryIndex!==owner.index)continue;}else if(at>=0)continue;q=propertyQueries(p);for(var qi=0;qi<q.length;qi++)add(q[qi],{p:p,editor:editor});if(['translation','rotation','scale'].indexOf(p.key[0])>=0){var field=p.key[0],axis=['x','y','z'].indexOf(p.key[1]);if(axis>=0){if(!indices[field])indices[field]=[];indices[field][axis]={p:p,editor:editor,component:axis};}}}
   for(var field in indices)if(own(indices,field)&&indices[field].length===3&&indices[field][0]&&indices[field][1]&&indices[field][2]){add('?'+field,{components:indices[field]});add('?'+field+'/value',{components:indices[field]});}queryMaps['$'+id]=map;return map;
